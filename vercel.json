{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "cookie",
          "key": "ct-lang",
          "value": "it"
        }
      ],
      "destination": "/it/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "cookie",
          "key": "ct-lang",
          "value": "de"
        }
      ],
      "destination": "/de/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "cookie",
          "key": "ct-lang",
          "value": "en"
        }
      ],
      "destination": "/en/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept-language",
          "value": "^\\s*[iI][tT].*"
        }
      ],
      "destination": "/it/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept-language",
          "value": "^\\s*[dD][eE].*"
        }
      ],
      "destination": "/de/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept-language",
          "value": "^\\s*[a-zA-Z].*"
        }
      ],
      "destination": "/en/",
      "permanent": false
    },
    {
      "source": "/",
      "destination": "/it/",
      "permanent": false
    },
    {
      "source": "/contatti",
      "destination": "/it/",
      "permanent": true
    },
    {
      "source": "/contatto",
      "destination": "/it/",
      "permanent": true
    },
    {
      "source": "/contacts",
      "destination": "/it/",
      "permanent": true
    },
    {
      "source": "/dove-siamo",
      "destination": "/it/",
      "permanent": true
    },
    {
      "source": "/chi-siamo",
      "destination": "/it/",
      "permanent": true
    },
    {
      "source": "/servizi",
      "destination": "/it/",
      "permanent": true
    },
    {
      "source": "/home",
      "destination": "/it/",
      "permanent": true
    },
    {
      "source": "/gomme",
      "destination": "/it/",
      "permanent": true
    },
    {
      "source": "/pneumatici",
      "destination": "/it/",
      "permanent": true
    },
    {
      "source": "/revisioni",
      "destination": "/it/",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/it/",
      "permanent": true
    },
    {
      "source": "/index.htm",
      "destination": "/it/",
      "permanent": true
    },
    {
      "source": "/default.html",
      "destination": "/it/",
      "permanent": true
    },
    {
      "source": "/default.htm",
      "destination": "/it/",
      "permanent": true
    },
    {
      "source": "/:path*.php",
      "destination": "/it/",
      "permanent": true
    },
    {
      "source": "/:path*.php/:rest*",
      "destination": "/it/",
      "permanent": true
    },
    {
      "source": "/it/officina-carrozzeria",
      "destination": "/it/officina/",
      "permanent": true
    },
    {
      "source": "/it/officina-carrozzeria/",
      "destination": "/it/officina/",
      "permanent": true
    },
    {
      "source": "/de/werkstatt-karosserie",
      "destination": "/de/werkstatt/",
      "permanent": true
    },
    {
      "source": "/de/werkstatt-karosserie/",
      "destination": "/de/werkstatt/",
      "permanent": true
    },
    {
      "source": "/en/workshop-bodywork",
      "destination": "/en/car-repair/",
      "permanent": true
    },
    {
      "source": "/en/workshop-bodywork/",
      "destination": "/en/car-repair/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/(fonts|brands)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ]
}
