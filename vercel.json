{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "redirects": [
    {
      "source": "/it/officina-carrozzeria",
      "destination": "/it/officina/",
      "permanent": true
    },
    {
      "source": "/it/officina-carrozzeria/",
      "destination": "/it/officina/",
      "permanent": true
    },
    {
      "source": "/de/werkstatt-karosserie",
      "destination": "/de/werkstatt/",
      "permanent": true
    },
    {
      "source": "/de/werkstatt-karosserie/",
      "destination": "/de/werkstatt/",
      "permanent": true
    },
    {
      "source": "/en/workshop-bodywork",
      "destination": "/en/car-repair/",
      "permanent": true
    },
    {
      "source": "/en/workshop-bodywork/",
      "destination": "/en/car-repair/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/(fonts|brands)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ]
}
