    fromReg: 'Immatricolazione',
    fromHint: 'Se non ricordi l’ultima revisione, metti il mese di immatricolazione: stimiamo la scadenza.',
    mese: 'Mese',
    anno: 'Anno',
    choose: 'Scegli',
    preview: 'Scadenza',
    previewEst: 'stima',
    interessi: 'Ti interessano anche',
    interessiHint: 'Facoltativo. Ci aiuta a mandarti solo quello che ti serve.',
    canale: 'Canale preferito',
    lingua: 'Lingua dei messaggi',
    privacy: 'Ho letto l’{link}.',
    privacyLink: 'informativa sulla privacy',
    promemoria: 'Voglio ricevere i promemoria di scadenza della revisione e del tagliando.',
    offerte: 'Voglio ricevere anche offerte e promozioni, poche all’anno.',
    optional: 'facoltativo',
    required: 'obbligatorio',
    submit: 'Attiva i promemoria',
    sending: 'Attivazione…',
    note: 'Usiamo i dati solo per i messaggi che hai scelto. Non li cediamo a nessuno. Per disdire basta rispondere STOP.',
    sideLabel: 'Cosa ricevi',
    side: [
      ['Subito', 'Un’email di conferma con la tua scadenza.'],
      ['30 giorni prima', 'Il primo promemoria, con il link per prenotare.'],
      ['7 giorni prima', 'L’ultimo avviso, se non hai ancora prenotato.'],
      ['Ogni anno', 'Il promemoria del tagliando, se lo scegli.'],
    ],
    // Conferma
    doneHi: 'Fatto, {nome}.',
    doneDeadline: 'La revisione di {targa} scade il',
    doneIn: 'tra {n} giorni',
    doneToday: 'scade oggi',
    doneAgo: 'scaduta da {n} giorni',
    doneEst: 'Stima dalla data di immatricolazione.',
    doneWhat: 'Cosa ricevi e quando',
    doneMailSent: 'Email di conferma inviata a {email}.',
    doneMailLater: 'Conferma registrata. Ti scriviamo a {email}.',
    doneReminder: 'Promemoria · {n} giorni prima',
    doneNowReminder: 'Promemoria · entro pochi giorni',
    doneTagliando: 'Promemoria tagliando · tra 12 mesi',
    doneOffers: 'Offerte di stagione · poche all’anno',
    doneNoOffers: 'Niente offerte: hai scelto solo i promemoria.',
    doneVia: { email: 'via email', whatsapp: 'su WhatsApp' },
    doneBook: 'Prenota subito la revisione',
    doneBack: 'Torna al sito',
    errSummary: 'Controlla i campi segnati.',
    errServer: 'Non siamo riusciti a completare l’iscrizione. Riprova tra poco o chiamaci.',
    err: {
      required: 'Campo obbligatorio.',
      email: 'Controlla l’email, ad esempio nome@esempio.it',
      phone: 'Inserisci un cellulare, ad esempio 333 123 4567',
      plate: 'Controlla la targa, ad esempio AB 123 CD',
      date: 'Scegli mese e anno.',
      future: 'La data non può essere nel futuro.',
      privacy: 'Per iscriverti serve la presa visione dell’informativa.',
      nothing: 'Scegli almeno una cosa da ricevere: promemoria o offerte.',
      long: 'Testo troppo lungo.',
    },
    honeypot: 'Lascia vuoto questo campo',
  },
  de: {
    title: 'Erinnerung an die Revision · Car Trade Bozen',
    description: 'Wir erinnern Sie an die Revision: per E-Mail oder WhatsApp 30 und 7 Tage vor Ablauf. Kostenlose Anmeldung in 30 Sekunden bei Car Trade Bozen, DEKRA-Partner.',
    label: 'Revisions-Erinnerung',
    kicker: 'Revisions-Erinnerung · Bozen',
    h1: 'Wir erinnern Sie an die Revision.',
    lead: 'Kennzeichen und Monat der letzten Revision genügen, den Rest übernehmen wir. Wir schreiben Ihnen 30 und 7 Tage vor Ablauf, auf dem Weg, den Sie wählen.',
    facts: [['30 und 7', 'Tage vorher'], ['E-Mail', 'oder WhatsApp'], ['STOP', 'zum Abmelden']],
    s1: 'Ihre Daten',
    s2: 'Ihr Fahrzeug',
    s3: 'Wie wir Sie erinnern',
    s4: 'Einwilligungen',
    nome: 'Vorname',
    cognome: 'Nachname',
    email: 'E-Mail',
    tel: 'Handynummer',
    telHint: 'Nur nötig, wenn Sie WhatsApp wählen.',
    targa: 'Kennzeichen',
    from: 'Ausgehend von',
    fromRev: 'Letzte Revision',
    fromReg: 'Erstzulassung',
    fromHint: 'Wissen Sie die letzte Revision nicht mehr? Geben Sie den Monat der Erstzulassung ein, wir schätzen den Termin.',
    mese: 'Monat',
    anno: 'Jahr',
    choose: 'Wählen',
    preview: 'Fällig bis',
    previewEst: 'Schätzung',
    interessi: 'Außerdem interessiert mich',
    interessiHint: 'Optional. So schicken wir Ihnen nur, was Sie brauchen.',
    canale: 'Bevorzugter Kanal',
    lingua: 'Sprache der Nachrichten',
    privacy: 'Ich habe die {link} gelesen.',
    privacyLink: 'Datenschutzerklärung',
    promemoria: 'Ich möchte Erinnerungen an die Fälligkeit von Revision und Inspektion erhalten.',
    offerte: 'Ich möchte auch Angebote und Aktionen erhalten, nur wenige im Jahr.',
    optional: 'optional',
    required: 'Pflichtfeld',
    submit: 'Erinnerung aktivieren',
    sending: 'Wird aktiviert…',
    note: 'Wir verwenden die Daten nur für die gewählten Nachrichten und geben sie nicht weiter. Abmelden: einfach mit STOP antworten.',
    sideLabel: 'Was Sie erhalten',
    side: [
      ['Sofort', 'Eine Bestätigung per E-Mail mit Ihrem Termin.'],
      ['30 Tage vorher', 'Die erste Erinnerung, mit dem Link zur Buchung.'],
      ['7 Tage vorher', 'Die letzte Erinnerung, falls noch nicht gebucht.'],
      ['Jährlich', 'Die Erinnerung an die Inspektion, wenn gewünscht.'],
    ],
    doneHi: 'Erledigt, {nome}.',
    doneDeadline: 'Die Revision für {targa} ist fällig bis',
    doneIn: 'in {n} Tagen',
    doneToday: 'heute fällig',
    doneAgo: 'seit {n} Tagen abgelaufen',
    doneEst: 'Geschätzt aus dem Datum der Erstzulassung.',
    doneWhat: 'Was Sie wann erhalten',
    doneMailSent: 'Bestätigung an {email} gesendet.',
    doneMailLater: 'Anmeldung gespeichert. Wir schreiben an {email}.',
    doneReminder: 'Erinnerung · {n} Tage vorher',
    doneNowReminder: 'Erinnerung · in den nächsten Tagen',
    doneTagliando: 'Erinnerung Inspektion · in 12 Monaten',
    doneOffers: 'Saisonale Angebote · wenige im Jahr',
    doneNoOffers: 'Keine Angebote: Sie haben nur die Erinnerungen gewählt.',
    doneVia: { email: 'per E-Mail', whatsapp: 'per WhatsApp' },
    doneBook: 'Revision jetzt buchen',
    doneBack: 'Zur Website',
    errSummary: 'Bitte prüfen Sie die markierten Felder.',
    errServer: 'Die Anmeldung hat nicht geklappt. Bitte später erneut versuchen oder anrufen.',
    err: {
      required: 'Pflichtfeld.',
      email: 'Bitte E-Mail prüfen, z. B. name@beispiel.it',
      phone: 'Bitte eine Handynummer eingeben, z. B. 333 123 4567',
      plate: 'Bitte Kennzeichen prüfen, z. B. AB 123 CD',
      date: 'Bitte Monat und Jahr wählen.',
      future: 'Das Datum darf nicht in der Zukunft liegen.',
      privacy: 'Für die Anmeldung bestätigen Sie bitte die Datenschutzerklärung.',
      nothing: 'Bitte wählen Sie mindestens eines: Erinnerungen oder Angebote.',
      long: 'Text zu lang.',
    },
    honeypot: 'Dieses Feld bitte leer lassen',
  },
}[lang];

const locale = lang === 'it' ? 'it-IT' : 'de-DE';
const months = Array.from({ length: 12 }, (_, i) => {
  const m = new Intl.DateTimeFormat(locale, { month: 'long' }).format(new Date(2026, i, 1));
  return m.charAt(0).toUpperCase() + m.slice(1);
});
const thisYear = new Date().getFullYear();
const years = Array.from({ length: 31 }, (_, i) => thisYear - i);
const [privacyBefore, privacyAfter] = copy.privacy.split('{link}');
const id = 'pm';
---
<Base lang={lang} title={copy.title} description={copy.description} alternates={alternatesFor('promemoria')}>
  <PageHero lang={lang} label={copy.label} kicker={copy.kicker} title={copy.h1} lead={copy.lead}>
    <dl slot="aside" class="facts t-num">
      {copy.facts.map(([v, l]) => (
        <div><dt class="t-label">{l}</dt><dd>{v}</dd></div>
      ))}
    </dl>
  </PageHero>

  <section class="wrap grid-12 gap-y-12 pt-6 pb-[var(--section)] lg:pt-10">
    <aside class="col-span-4 lg:order-2 lg:col-span-4 lg:col-start-9" aria-labelledby="pm-side">
      <div class="lg:sticky lg:top-28">
        <h2 id="pm-side" class="t-label text-ink">{copy.sideLabel}</h2>
        <ol class="side mt-4">
          {copy.side.map(([w, d], i) => (
            <li>
              <span class="t-label t-num text-orange-ink">{String(i + 1).padStart(2, '0')}</span>
              <span><strong class="block font-semibold">{w}</strong><span class="text-muted">{d}</span></span>
            </li>
          ))}
        </ol>
        <p class="mt-5 text-sm text-muted">{copy.note}</p>
      </div>
    </aside>

    <div class="col-span-4 lg:order-1 lg:col-span-7" data-pm data-lang={lang} data-copy={JSON.stringify(copy)} data-booking={site.dekra.bookingUrl}>
      <form class="pm-form" novalidate data-pm-form aria-describedby="pm-req">
        <p id="pm-req" class="text-sm text-muted"><span aria-hidden="true">*</span> = {copy.required}</p>
        <p class="form-alert" role="alert" data-pm-alert hidden></p>

        <!-- 01 -->
        <fieldset class="block">
          <legend class="block-head"><span class="t-label t-num text-orange-ink">01</span><span class="t-label">{copy.s1}</span></legend>
          <div class="grid gap-5 sm:grid-cols-2">
            <div class="field">
              <label for={`${id}-nome`}>{copy.nome} <span aria-hidden="true">*</span></label>
              <input id={`${id}-nome`} name="nome" class="input" autocomplete="given-name" required maxlength="60" aria-describedby={`${id}-nome-err`} />
              <p id={`${id}-nome-err`} class="field-error" hidden></p>
            </div>
            <div class="field">
              <label for={`${id}-cognome`}>{copy.cognome} <span aria-hidden="true">*</span></label>
              <input id={`${id}-cognome`} name="cognome" class="input" autocomplete="family-name" required maxlength="60" aria-describedby={`${id}-cognome-err`} />
              <p id={`${id}-cognome-err`} class="field-error" hidden></p>
            </div>
            <div class="field">
              <label for={`${id}-email`}>{copy.email} <span aria-hidden="true">*</span></label>
              <input id={`${id}-email`} name="email" type="email" class="input" autocomplete="email" inputmode="email" required maxlength="160" aria-describedby={`${id}-email-err`} />
              <p id={`${id}-email-err`} class="field-error" hidden></p>
            </div>
            <div class="field">
              <label for={`${id}-telefono`}>{copy.tel} <span class="font-normal text-muted" data-tel-opt>({copy.optional})</span><span aria-hidden="true" data-tel-req hidden> *</span></label>
              <input id={`${id}-telefono`} name="telefono" type="tel" class="input t-num" autocomplete="tel" inputmode="tel" placeholder="333 123 4567" maxlength="20" aria-describedby={`${id}-telefono-hint ${id}-telefono-err`} />
              <p id={`${id}-telefono-hint`} class="text-sm text-muted">{copy.telHint}</p>
              <p id={`${id}-telefono-err`} class="field-error" hidden></p>
            </div>
          </div>
        </fieldset>

        <!-- 02 -->
        <fieldset class="block">
          <legend class="block-head"><span class="t-label t-num text-orange-ink">02</span><span class="t-label">{copy.s2}</span></legend>
          <div class="grid gap-5">
            <div class="field max-w-[16rem]">
              <label for={`${id}-targa`}>{copy.targa} <span aria-hidden="true">*</span></label>
              <input id={`${id}-targa`} name="targa" class="input plate t-num" autocapitalize="characters" autocomplete="off" spellcheck="false" maxlength="12" placeholder="AB 123 CD" required aria-describedby={`${id}-targa-err`} />
              <p id={`${id}-targa-err`} class="field-error" hidden></p>
            </div>
            <fieldset>
              <legend class="mb-2 text-[0.875rem] font-[560]">{copy.from}</legend>
              <div class="seg w-full sm:w-auto">
                <input type="radio" name="rif_tipo" id={`${id}-rev`} value="rev" checked />
                <label for={`${id}-rev`}>{copy.fromRev}</label>
                <input type="radio" name="rif_tipo" id={`${id}-reg`} value="reg" />
                <label for={`${id}-reg`}>{copy.fromReg}</label>
              </div>
              <p class="mt-2 text-sm text-muted">{copy.fromHint}</p>
            </fieldset>
            <div class="grid grid-cols-[1.4fr_1fr] gap-3 sm:max-w-[28rem]">
              <div class="field">
                <label for={`${id}-mese`}>{copy.mese} <span aria-hidden="true">*</span></label>
                <select id={`${id}-mese`} name="rif_mese" class="input" required aria-describedby={`${id}-mese-err`}>
                  <option value="">{copy.choose}</option>
                  {months.map((m, i) => <option value={i + 1}>{m}</option>)}
                </select>
              </div>
              <div class="field">
                <label for={`${id}-anno`}>{copy.anno} <span aria-hidden="true">*</span></label>
                <select id={`${id}-anno`} name="rif_anno" class="input t-num" required aria-describedby={`${id}-mese-err`}>
                  <option value="">{copy.choose}</option>
                  {years.map((y) => <option value={y}>{y}</option>)}
                </select>
              </div>
            </div>
            <p id={`${id}-mese-err`} class="field-error -mt-3" hidden></p>
            <p class="preview t-num" data-preview aria-live="polite" hidden></p>
          </div>
        </fieldset>

        <!-- 03 -->
        <fieldset class="block">
          <legend class="block-head"><span class="t-label t-num text-orange-ink">03</span><span class="t-label">{copy.s3}</span></legend>
          <div class="grid gap-6">
            <fieldset aria-describedby={`${id}-int-hint`}>
              <legend class="text-[0.875rem] font-[560]">{copy.interessi} <span class="font-normal text-muted">({copy.optional})</span></legend>
              <p id={`${id}-int-hint`} class="mt-1 text-sm text-muted">{copy.interessiHint}</p>
              <div class="mt-3 flex flex-wrap gap-2">
                {INTERESSI.map((k) => (
                  <span class="chip">
                    <input type="checkbox" name="interessi" id={`${id}-int-${k}`} value={k} checked={k === 'revisione'} />
                    <label for={`${id}-int-${k}`}>{ETICHETTE_INTERESSI[k][lang]}</label>
                  </span>
                ))}
              </div>
            </fieldset>
            <div class="flex flex-wrap gap-x-8 gap-y-6">
              <fieldset>
                <legend class="mb-2 text-[0.875rem] font-[560]">{copy.canale}</legend>
                <div class="seg">
                  <input type="radio" name="canale" id={`${id}-ch-email`} value="email" checked />
                  <label for={`${id}-ch-email`}><Icon name="mail" size={18} class="mr-2" />{copy.email}</label>
                  <input type="radio" name="canale" id={`${id}-ch-wa`} value="whatsapp" />
                  <label for={`${id}-ch-wa`}><Icon name="whatsapp" size={18} class="mr-2" />WhatsApp</label>
                </div>
              </fieldset>
              <fieldset>
                <legend class="mb-2 text-[0.875rem] font-[560]">{copy.lingua}</legend>
                <div class="seg">
                  <input type="radio" name="lingua" id={`${id}-l-it`} value="it" checked={lang === 'it'} />
                  <label for={`${id}-l-it`} lang="it">Italiano</label>
                  <input type="radio" name="lingua" id={`${id}-l-de`} value="de" checked={lang === 'de'} />
                  <label for={`${id}-l-de`} lang="de">Deutsch</label>
                </div>
              </fieldset>
            </div>
          </div>
        </fieldset>

        <!-- 04 Consensi separati, mai preselezionati -->
        <fieldset class="block">
          <legend class="block-head"><span class="t-label t-num text-orange-ink">04</span><span class="t-label">{copy.s4}</span></legend>
          <div class="grid gap-4">
            <div>
              <label class="consent">
                <input type="checkbox" name="consenso_privacy" aria-describedby={`${id}-privacy-err`} />
                <span>{privacyBefore}<a href={routes.privacy[lang]} class="link-u font-semibold" target="_blank" rel="noopener">{copy.privacyLink}<span class="sr-only"> ({lang === 'it' ? 'si apre in una nuova scheda' : 'öffnet in neuem Tab'})</span></a>{privacyAfter} <span aria-hidden="true">*</span></span>
              </label>
              <p id={`${id}-privacy-err`} class="field-error mt-2 pl-8" hidden></p>
            </div>
            <div>
              <label class="consent">
                <input type="checkbox" name="consenso_promemoria" aria-describedby={`${id}-promemoria-err`} />
                <span>{copy.promemoria}</span>
              </label>
              <p id={`${id}-promemoria-err`} class="field-error mt-2 pl-8" hidden></p>
            </div>
            <label class="consent">
              <input type="checkbox" name="consenso_offerte" />
              <span>{copy.offerte} <span class="text-muted">({copy.optional})</span></span>
            </label>
          </div>
        </fieldset>

        <!-- Campo esca per i bot: invisibile e fuori dal percorso del tasto Tab -->
        <div class="hp" aria-hidden="true">
          <label for={`${id}-sito`}>{copy.honeypot}</label>
          <input id={`${id}-sito`} name="sito_web" tabindex="-1" autocomplete="off" />
        </div>

        <div class="pt-2">
          <button type="submit" class="btn btn-primary w-full sm:w-auto" data-pm-submit>
            <span data-pm-label>{copy.submit}</span>
            <Icon name="arrow" size={18} class="btn-arrow" />
          </button>
        </div>
      </form>

      <div class="done" data-pm-done hidden tabindex="-1" aria-labelledby="pm-done-title">
        <p class="done-check" aria-hidden="true"><Icon name="check" size={28} /></p>
        <h2 id="pm-done-title" class="t-h2 mt-6" data-done-hi></h2>
        <div class="done-card on-dark mt-8">
          <p class="t-label text-steel-2" data-done-label></p>
          <p class="done-date t-num mt-3" data-done-date></p>
          <p class="mt-2 text-lg text-steel t-num" data-done-in></p>
          <p class="mt-3 text-sm text-steel-2" data-done-est hidden>{copy.doneEst}</p>
        </div>
        <h3 class="t-label mt-10 text-ink">{copy.doneWhat}</h3>
        <ol class="timeline mt-4" data-done-list></ol>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href={site.dekra.bookingUrl} class="btn btn-primary" target="_blank" rel="noopener" data-done-book hidden>
            {copy.doneBook}<span class="sr-only"> ({lang === 'it' ? 'si apre il portale di prenotazione DEKRA' : 'öffnet das Buchungsportal von DEKRA'})</span>
            <Icon name="arrow-up-right" size={18} class="btn-arrow" />
          </a>
          <a href={routes.home[lang]} class="btn btn-ghost">{copy.doneBack} <Icon name="arrow" size={18} class="btn-arrow" /></a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
@layer components {
  .facts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--line-strong); }
  .facts > div { display: flex; flex-direction: column-reverse; gap: 0.35rem; padding: 1rem 0.75rem 0 0; }
  .facts > div + div { padding-left: 0.75rem; border-left: 1px solid var(--line); }
  .facts dd { font-stretch: 120%; font-weight: 640; font-size: clamp(1.25rem, 2.4vw, 1.75rem); letter-spacing: -0.02em; line-height: 1; }
  .facts dt { color: var(--color-muted); }

  .side { border-top: 1px solid var(--line-strong); }
  .side li { display: grid; grid-template-columns: 2.25rem 1fr; gap: 0.5rem; padding-block: 0.9rem; border-bottom: 1px solid var(--line); font-size: 0.9375rem; }

  .pm-form { display: grid; gap: 2.5rem; }
  .block { display: grid; gap: 1.25rem; min-width: 0; }
  .block-head { display: flex; align-items: center; gap: 0.9rem; width: 100%; padding-bottom: 0.9rem; margin-bottom: 0.25rem; border-bottom: 1px solid var(--line-strong); }
  .plate { text-transform: uppercase; letter-spacing: 0.1em; font-stretch: 112%; font-weight: 600; }
  .plate::placeholder { letter-spacing: 0.1em; }
  .preview { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.35rem 0.75rem; padding: 0.85rem 1rem; background: var(--color-paper-2); border: 1px solid var(--line); }
  .preview :global(b) { font-stretch: 118%; font-weight: 650; font-size: 1.125rem; }
  .seg label :global(svg) { flex: none; }
  .consent { display: grid; grid-template-columns: 1.25rem 1fr; gap: 0.75rem; align-items: start; font-size: 0.9375rem; line-height: 1.45; cursor: pointer; }
  .consent input { width: 1.25rem; height: 1.25rem; margin-top: 0.1rem; accent-color: var(--color-ink); }
  .consent input[aria-invalid='true'] { outline: 2px solid var(--color-alert); outline-offset: 2px; }
  .form-alert { padding: 0.85rem 1rem; border: 1px solid var(--color-alert); color: var(--color-alert); font-weight: 560; border-radius: 2px; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }

  .done:focus { outline: none; }
  .done-check { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 999px; background: var(--color-orange); color: var(--color-ink); }
  .done-card { padding: 1.5rem; background: var(--color-night); color: var(--color-paper); }
  @media (min-width: 64rem) { .done-card { padding: 2rem; } }
  .done-date { font-stretch: 125%; font-weight: 650; font-size: clamp(2.4rem, 8vw, 4rem); line-height: 0.95; letter-spacing: -0.03em; text-transform: uppercase; }
  .timeline { border-top: 1px solid var(--line-strong); }
  .timeline :global(li) { display: grid; grid-template-columns: 6.5rem 1fr; gap: 1rem; padding-block: 0.9rem; border-bottom: 1px solid var(--line); }
  .timeline :global(.when) { font-variant-numeric: tabular-nums; font-weight: 600; }
  .timeline :global(.what) { color: var(--color-muted); }
  .timeline :global(.what strong) { display: block; color: var(--color-ink); font-weight: 560; }
}
</style>

<script>
  import { validaIscrizione, type Errori, type IscrizioneValida } from '../lib/crm/validate';
  import { calcolaScadenza, giorniA, isoDate, parseIsoDate } from '../lib/revisione';
  import { dateAvvisi } from '../lib/crm/messaggi';
  import { archivioLocale, salvaLocale } from '../lib/crm/locale';
  import { uid, type Cliente } from '../lib/crm/types';

  const root = document.querySelector<HTMLElement>('[data-pm]');
  if (root) {
    const copy = JSON.parse(root.dataset.copy!);
    const lang = root.dataset.lang as 'it' | 'de';
    const locale = lang === 'de' ? 'de-DE' : 'it-IT';
    const fmtLong = new Intl.DateTimeFormat(locale, { day: 'numeric', month: 'long', year: 'numeric' });
    const fmtShort = new Intl.DateTimeFormat(locale, { day: '2-digit', month: 'short', year: 'numeric' });
    const form = root.querySelector<HTMLFormElement>('[data-pm-form]')!;
    const done = root.querySelector<HTMLElement>('[data-pm-done]')!;
    const alertBox = root.querySelector<HTMLElement>('[data-pm-alert]')!;
    const preview = root.querySelector<HTMLElement>('[data-preview]')!;
    const el = <T extends HTMLElement = HTMLInputElement>(name: string) => form.elements.namedItem(name) as unknown as T;
    const params = new URLSearchParams(location.search);
    const demoKey = params.get('demo') ?? '';

    // Arrivo dal calcolatore: mese, anno e tipo già scelti
    const pMese = Number(params.get('mese'));
    const pAnno = Number(params.get('anno'));
    if (pMese >= 1 && pMese <= 12) el<HTMLSelectElement>('rif_mese').value = String(pMese);
    if (pAnno) el<HTMLSelectElement>('rif_anno').value = String(pAnno);
    if (params.get('tipo') === 'reg') (form.querySelector('#pm-reg') as HTMLInputElement).checked = true;

    const values = () => {
      const fd = new FormData(form);
      return {
        nome: fd.get('nome'),
        cognome: fd.get('cognome'),
        email: fd.get('email'),
        telefono: fd.get('telefono'),
        targa: fd.get('targa'),
        rif_tipo: fd.get('rif_tipo'),
        rif_mese: fd.get('rif_mese'),
        rif_anno: fd.get('rif_anno'),
        interessi: fd.getAll('interessi'),
        canale: fd.get('canale'),
        lingua: fd.get('lingua'),
        consenso_privacy: fd.get('consenso_privacy') === 'on',
        consenso_promemoria: fd.get('consenso_promemoria') === 'on',
        consenso_offerte: fd.get('consenso_offerte') === 'on',
        sito_web: fd.get('sito_web'),
        demo: demoKey,
      };
    };

    // Anteprima della scadenza mentre si compila
    const renderPreview = () => {
      const m = Number(el<HTMLSelectElement>('rif_mese').value);
      const y = Number(el<HTMLSelectElement>('rif_anno').value);
      const tipo = (form.querySelector('input[name="rif_tipo"]:checked') as HTMLInputElement).value as 'rev' | 'reg';
      if (!m || !y) return void (preview.hidden = true);
      const s = calcolaScadenza(tipo, m, y);
      const g = giorniA(s.date);
      const when = g < 0 ? copy.doneAgo.replace('{n}', String(-g)) : g === 0 ? copy.doneToday : copy.doneIn.replace('{n}', g.toLocaleString(locale));
      preview.innerHTML = '';
      preview.append(
        Object.assign(document.createElement('span'), { className: 't-label', textContent: `${copy.preview}${s.estimated ? ` (${copy.previewEst})` : ''}` }),
        Object.assign(document.createElement('b'), { textContent: fmtLong.format(s.date) }),
        Object.assign(document.createElement('span'), { className: 'text-muted', textContent: when }),
      );
      preview.hidden = false;
    };
    form.querySelectorAll('select, input[name="rif_tipo"]').forEach((x) => x.addEventListener('change', renderPreview));
    renderPreview();

    // WhatsApp: il cellulare diventa obbligatorio
    const tel = el('telefono');
    const telOpt = form.querySelector<HTMLElement>('[data-tel-opt]')!;
    const telReq = form.querySelector<HTMLElement>('[data-tel-req]')!;
    const syncCanale = () => {
      const wa = (form.querySelector('input[name="canale"]:checked') as HTMLInputElement).value === 'whatsapp';
      telOpt.hidden = wa;
      telReq.hidden = !wa;
      tel.required = wa;
    };
    form.querySelectorAll('input[name="canale"]').forEach((x) => x.addEventListener('change', syncCanale));

    // Targa: maiuscolo mentre si scrive
    const targa = el('targa');
    targa.addEventListener('input', () => {
      const p = targa.selectionStart;
      targa.value = targa.value.toUpperCase();
      targa.setSelectionRange(p, p);
    });

    const fields: Record<string, string> = {
      nome: 'pm-nome', cognome: 'pm-cognome', email: 'pm-email', telefono: 'pm-telefono', targa: 'pm-targa', rif_mese: 'pm-mese', consenso_privacy: 'consenso_privacy', consenso_promemoria: 'consenso_promemoria',
    };
    const errEl: Record<string, string> = { rif_mese: 'pm-mese-err', consenso_privacy: 'pm-privacy-err', consenso_promemoria: 'pm-promemoria-err' };
    const inputFor = (k: string) => (k.startsWith('consenso') ? el(k) : (document.getElementById(fields[k]) as HTMLInputElement));

    const showErrors = (errors: Errori) => {
      Object.keys(fields).forEach((k) => {
        const code = errors[k as keyof Errori];
        const input = inputFor(k);
        const err = document.getElementById(errEl[k] ?? `${fields[k]}-err`);
        if (err) {
          err.textContent = code ? copy.err[code] : '';
          err.hidden = !code;
        }
        input?.setAttribute('aria-invalid', code ? 'true' : 'false');
        if (k === 'rif_mese') el<HTMLSelectElement>('rif_anno').setAttribute('aria-invalid', code ? 'true' : 'false');
      });
      const first = Object.keys(fields).find((k) => errors[k as keyof Errori]);
      if (first) {
        alertBox.textContent = copy.errSummary;
        alertBox.hidden = false;
        inputFor(first)?.focus();
      }
    };

    const btn = form.querySelector<HTMLButtonElement>('[data-pm-submit]')!;
    const label = btn.querySelector<HTMLElement>('[data-pm-label]')!;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      alertBox.hidden = true;
      const v = values();
      const check = validaIscrizione(v);
      if (!check.ok) return showErrors(check.errors);
      showErrors({});
      btn.disabled = true;
      btn.setAttribute('aria-busy', 'true');
      label.textContent = copy.sending;

      let mode: 'live' | 'simulato' = 'simulato';
      let email = 'simulato';
      try {
        const res = await fetch('/api/iscrizione', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(v),
          signal: AbortSignal.timeout(12000),
        });
        const data = await res.json().catch(() => ({}));
        if (res.status === 422 && data.errors) {
          showErrors(data.errors);
          btn.disabled = false;
          btn.removeAttribute('aria-busy');
          label.textContent = copy.submit;
          return;
        }
        if (res.ok && data.ok) {
          mode = data.mode;
          email = data.email;
        }
      } catch {
        /* rete assente: modalità simulata */
      }

      // Modalità simulata: l'iscrizione resta in questo browser, l'admin (stesso browser) la vede
      if (mode === 'simulato') {
        const now = new Date().toISOString();
        const c: Cliente = {
          ...check.data,
          id: uid(),
          creato_il: now,
          ultimo_tagliando: null,
          consenso_privacy_il: now,
          origine: demoKey ? 'qr' : 'sito',
          locale: true,
        };
        const a = archivioLocale();
        a.clienti.unshift(c);
        a.eventi.unshift(
          { id: uid(), cliente_id: c.id, tipo: 'iscrizione', canale: 'sistema', esito: 'registrato', dettagli: { origine: c.origine }, creato_il: now },
          { id: uid(), cliente_id: c.id, tipo: 'benvenuto', canale: 'email', esito: 'simulato', dettagli: {}, creato_il: now },
        );
        salvaLocale(a);
      }
      showDone(check.data, email === 'inviata');
    });

    function showDone(d: IscrizioneValida, mailSent: boolean) {
      const s = calcolaScadenza(d.rif_tipo, d.rif_mese, d.rif_anno);
      const g = giorniA(s.date);
      const t = (sel: string) => done.querySelector<HTMLElement>(sel)!;
      const targaLeggibile = /^[A-Z]{2}\d{3}[A-Z]{2}$/.test(d.targa) ? `${d.targa.slice(0, 2)} ${d.targa.slice(2, 5)} ${d.targa.slice(5)}` : d.targa;
      t('[data-done-hi]').textContent = copy.doneHi.replace('{nome}', d.nome);
      t('[data-done-label]').textContent = copy.doneDeadline.replace('{targa}', targaLeggibile);
      t('[data-done-date]').textContent = fmtLong.format(s.date);
      t('[data-done-in]').textContent = g < 0 ? copy.doneAgo.replace('{n}', String(-g)) : g === 0 ? copy.doneToday : copy.doneIn.replace('{n}', g.toLocaleString(locale));
      t('[data-done-est]').hidden = !s.estimated;
      t('[data-done-book]').hidden = g > 60;

      const via = copy.doneVia[d.canale];
      const rows: [string, string, string?][] = [];
      rows.push([lang === 'de' ? 'Heute' : 'Oggi', (mailSent ? copy.doneMailSent : copy.doneMailLater).replace('{email}', d.email)]);
      if (d.consenso_promemoria) {
        const avvisi = dateAvvisi(isoDate(s.date));
        if (avvisi.length) avvisi.forEach((a) => rows.push([fmtShort.format(a.data), copy.doneReminder.replace('{n}', String(a.giorni)), via]));
        else if (parseIsoDate(isoDate(s.date)) >= new Date(new Date().toDateString())) rows.push(['', copy.doneNowReminder, via]);
        if (d.interessi.includes('tagliando')) rows.push(['', copy.doneTagliando, via]);
      }
      rows.push(['', d.consenso_offerte ? copy.doneOffers : copy.doneNoOffers]);
      const list = t('[data-done-list]');
      list.innerHTML = '';
      rows.forEach(([when, what, sub]) => {
        const li = document.createElement('li');
        const w = Object.assign(document.createElement('span'), { className: 'when', textContent: when || '·' });
        if (!when) w.setAttribute('aria-hidden', 'true');
        const x = document.createElement('span');
        x.className = 'what';
        x.append(Object.assign(document.createElement('strong'), { textContent: what }));
        if (sub) x.append(document.createTextNode(sub));
        li.append(w, x);
        list.append(li);
      });

      form.hidden = true;
      done.hidden = false;
      done.focus();
      done.scrollIntoView({ block: 'start', behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
    }
  }
</script>
