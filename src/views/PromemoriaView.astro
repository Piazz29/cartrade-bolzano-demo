---
// Iscrizione pubblica ai promemoria di revisione e tagliando (IT /it/promemoria/, DE /de/erinnerung/).
// Arrivo tipico: QR della locandina sul bancone (?demo=<DEMO_KEY>) o "Avvisami" del calcolatore (?tipo=&mese=&anno=).
// Invio a /api/iscrizione; se il server non è configurato o la rete non risponde, l'iscrizione resta nel browser
// (modalità simulata) e la persona vede comunque la sua conferma.
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { site, type Lang } from '../data/site';
import { routes, alternatesFor } from '../i18n/routes';
import { ETICHETTE_INTERESSI } from '../lib/crm/campagne';
import { INTERESSI } from '../lib/crm/types';

interface Props { lang: Lang }
const { lang } = Astro.props;

const copy = {
  it: {
    title: 'Promemoria scadenza revisione auto a Bolzano',
    description: 'Ti avvisiamo noi prima che scada la revisione: email o WhatsApp 30 e 7 giorni prima. Iscrizione gratuita in 30 secondi, Car Trade Bolzano, centro revisioni DEKRA.',
    label: 'Promemoria revisione',
    kicker: 'Promemoria revisione · Bolzano',
    h1: 'Ti ricordiamo noi la revisione.',
    lead: 'Targa e mese dell’ultima revisione: al resto pensiamo noi. Ti scriviamo 30 e 7 giorni prima della scadenza, sul canale che preferisci.',
    facts: [['30 e 7', 'giorni prima'], ['Email', 'o WhatsApp'], ['STOP', 'per disdire']],
    s1: 'I tuoi dati',
    s2: 'La tua auto',
    s3: 'Come ti avvisiamo',
    s4: 'Consensi',
    nome: 'Nome',
    cognome: 'Cognome',
