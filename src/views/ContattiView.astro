---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import SectionHead from '../components/SectionHead.astro';
import OpenStatus from '../components/OpenStatus.astro';
import HoursTable from '../components/HoursTable.astro';
import MapBlock from '../components/MapBlock.astro';
import RequestForm from '../components/RequestForm.astro';
import { site, type Lang } from '../data/site';
import { alternatesFor } from '../i18n/routes';
import { ui } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];

const copy = {
  it: {
    title: 'Contatti e orari · Car Trade Bolzano',
    description: `Contatti CAR TRADE Bolzano: telefono ${site.phone.display}, WhatsApp, Via Werner von Siemens 4/F. Orari lun-ven 8:30-12:30 e 14:00-18:00.`,
    label: 'Contatti',
    h1: 'Chiamaci, scrivici o passa a trovarci.',
    lead: 'Per la revisione la via più veloce è la prenotazione online. Per tutto il resto rispondiamo al telefono e su WhatsApp negli orari di apertura.',
    channelsLabel: 'Canali',
    channels: [
      { k: 'phone', t: 'Telefono', v: site.phone.display, href: site.phone.href, note: 'Negli orari di apertura', ext: false },
      { k: 'whatsapp', t: 'WhatsApp', v: 'Scrivici un messaggio', href: site.whatsapp.href('Buongiorno, '), note: 'Anche foto e documenti', ext: true },
      { k: 'calendar', t: 'Revisione', v: 'Prenota online', href: site.dekra.bookingUrl, note: 'Portale DEKRA, 24 ore su 24', ext: true },
    ],
    formLabel: 'Scrivici',
    formTitle: 'Lasciaci un messaggio.',
    formText: 'Ti rispondiamo entro un giorno lavorativo, nel modo che preferisci.',
    whereLabel: 'Dove siamo',
  },
  de: {
    title: 'Kontakt und Öffnungszeiten · Car Trade Bozen',
    description: `Kontakt CAR TRADE Bozen: Telefon ${site.phone.display}, WhatsApp, Werner-von-Siemens-Straße 4/F. Öffnungszeiten Mo–Fr 8:30–12:30 und 14:00–18:00.`,
    label: 'Kontakt',
    h1: 'Rufen Sie an, schreiben Sie oder kommen Sie vorbei.',
    lead: 'Für die Revision ist die Online-Buchung der schnellste Weg. Für alles andere sind wir während der Öffnungszeiten am Telefon und auf WhatsApp erreichbar.',
    channelsLabel: 'Kanäle',
    channels: [
      { k: 'phone', t: 'Telefon', v: site.phone.display, href: site.phone.href, note: 'Während der Öffnungszeiten', ext: false },
      { k: 'whatsapp', t: 'WhatsApp', v: 'Nachricht schreiben', href: site.whatsapp.href('Guten Tag, '), note: 'Auch Fotos und Dokumente', ext: true },
      { k: 'calendar', t: 'Revision', v: 'Online buchen', href: site.dekra.bookingUrl, note: 'DEKRA-Portal, rund um die Uhr', ext: true },
    ],
    formLabel: 'Schreiben Sie uns',
    formTitle: 'Hinterlassen Sie uns eine Nachricht.',
    formText: 'Wir antworten innerhalb eines Werktags, auf dem gewünschten Weg.',
    whereLabel: 'Anfahrt',
  },
}[lang];
---
<Base lang={lang} title={copy.title} description={copy.description} alternates={alternatesFor('contatti')} current="contatti">
  <PageHero lang={lang} label={copy.label} title={copy.h1} lead={copy.lead}>
    <div slot="aside" class="aside">
      <OpenStatus lang={lang} />
      <a href={site.phone.href} class="big-phone t-num mt-4 block">{site.phone.display}</a>
      <p class="mt-3 text-muted">{site.address.street[lang]}, {site.address.postalCode} {site.address.city[lang]}</p>
    </div>
  </PageHero>

  <section class="section-y pt-10 lg:pt-14" aria-labelledby="ch-title">
    <div class="wrap">
      <SectionHead num="01" label={copy.channelsLabel} />
      <h2 id="ch-title" class="sr-only">{copy.channelsLabel}</h2>
      <ul class="channels">
        {copy.channels.map((c) => (
          <li>
            <a href={c.href} target={c.ext ? '_blank' : undefined} rel={c.ext ? 'noopener' : undefined} class="channel group">
              <span class="ch-icon"><Icon name={c.k as 'phone'} size={22} /></span>
              <span class="t-label text-muted">{c.t}</span>
              <span class="ch-v t-num">{c.v}</span>
              <span class="text-sm text-muted">{c.note}</span>
              <Icon name={c.ext ? 'arrow-up-right' : 'arrow'} size={22} class="ch-arrow" />
            </a>
          </li>
        ))}
      </ul>
      {/* TODO: aggiungere l'email quando il cliente la conferma (site.email in src/data/site.ts) */}
    </div>
  </section>

  <section class="section-y bg-paper-2" aria-labelledby="where-title">
    <div class="wrap">
      <SectionHead num="02" label={copy.whereLabel} />
      <div class="grid-12 mt-8 gap-y-10 lg:mt-12">
        <div class="col-span-4 lg:col-span-4">
          <h2 id="where-title" class="t-h3">{site.address.street[lang]}<br />{site.address.postalCode} {site.address.city[lang]} ({site.address.region})</h2>
          <p class="mt-3 text-sm text-muted">{t.vat} {site.vat}</p>
          <div class="mt-8 flex items-center justify-between gap-4">
            <h3 class="t-label">{t.hours.title}</h3>
          </div>
          <HoursTable lang={lang} class="mt-2" />
        </div>
        <div class="col-span-4 lg:col-span-8">
          <MapBlock lang={lang} />
        </div>
      </div>
    </div>
  </section>

  <section class="on-dark section-y bg-night text-paper" aria-labelledby="form-title">
    <div class="wrap">
      <SectionHead num="03" label={copy.formLabel} dark />
      <div class="grid-12 mt-8 gap-y-10 lg:mt-12">
        <div class="col-span-4 lg:col-span-5">
          <h2 id="form-title" class="t-h2 max-w-[14ch]">{copy.formTitle}</h2>
          <p class="mt-5 max-w-[40ch] text-steel">{copy.formText}</p>
        </div>
        <div class="col-span-4 lg:col-span-6 lg:col-start-7">
          <RequestForm lang={lang} variant="contact" id="contact" />
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
@layer components {
  .aside { padding: 1.5rem; border: 1px solid var(--line); background: var(--color-paper-2); }
  .big-phone { font-stretch: 125%; font-weight: 650; font-size: clamp(2rem, 4.6vw, 3.2rem); letter-spacing: -0.03em; line-height: 1; text-decoration: none; }
  .big-phone:hover { color: var(--color-orange-ink); }
  .channels { display: grid; }
  @media (min-width: 64rem) { .channels { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .channel {
    position: relative;
    display: grid;
    gap: 0.35rem;
    padding: 1.75rem 3rem 1.75rem 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }
  @media (min-width: 64rem) {
    .channels li + li .channel { padding-left: 1.75rem; border-left: 1px solid var(--line); }
    .channel { border-bottom: 0; padding-block: 2.25rem; }
  }
  .ch-icon { display: grid; place-items: center; width: 3rem; height: 3rem; margin-bottom: 0.75rem; border: 1px solid var(--line-strong); border-radius: 999px; transition: background-color 0.3s, border-color 0.3s; }
  .channel:hover .ch-icon { background: var(--color-orange); border-color: var(--color-orange); }
  .ch-v { font-stretch: 120%; font-weight: 630; font-size: clamp(1.4rem, 2.4vw, 1.9rem); letter-spacing: -0.02em; }
  .channel :global(.ch-arrow) { position: absolute; right: 0.25rem; top: 2rem; transition: transform 0.4s var(--ease-out-expo); }
  .channel:hover :global(.ch-arrow) { transform: translate(3px, -3px); }
}
</style>
