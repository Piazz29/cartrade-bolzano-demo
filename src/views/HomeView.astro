---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import RoofLine from '../components/RoofLine.astro';
import Icon from '../components/Icon.astro';
import SectionHead from '../components/SectionHead.astro';
import OpenStatus from '../components/OpenStatus.astro';
import CarCard from '../components/CarCard.astro';
import GoogleReviews from '../components/GoogleReviews.astro';
import Marquee from '../components/Marquee.astro';
import RevisionCalculator from '../components/RevisionCalculator.astro';
import MapBlock from '../components/MapBlock.astro';
import Faq from '../components/Faq.astro';
import HoursTable from '../components/HoursTable.astro';
import { site, formatNumber, formatPrice, type Lang } from '../data/site';
import { routes, alternatesFor } from '../i18n/routes';
import { ui } from '../i18n/ui';
import { unsplash, unsplashSrcset } from '../lib/img';
import { Picture, getImage } from 'astro:assets';
import { fotoLocale, fotoUnsplash } from '../lib/foto';
import type { FotoKey } from '../data/foto';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];

const allCars = await getCollection('cars');
const featured = allCars.filter((c) => c.data.featured).slice(0, 4);

const copy = {
  it: {
    title: 'Revisione auto, officina, carrozzeria e auto usate a Bolzano',
    description:
      'Centro revisioni affiliato DEKRA, officina meccanica, carrozzeria e auto usate e km 0 in Via Werner von Siemens 4/F a Bolzano. Prenota la revisione online.',
    eyebrow: 'Bolzano Sud · Via Werner von Siemens 4/F',
    h1: ['Un solo indirizzo.', 'Tutto per la tua auto.'],
    kicker: 'Revisione, officina e carrozzeria a Bolzano',
    lead: 'Revisione DEKRA, meccanica e carrozzeria sotto lo stesso tetto a Bolzano Sud. Se la revisione trova un difetto, lo ripariamo qui.',
    svcNav: 'I nostri servizi',
    svc: [
      ['Revisione', routes.revisione.it],
      ['Officina', `${routes.officina.it}#officina`],
      ['Carrozzeria', `${routes.officina.it}#carrozzeria`],
      ['Auto e km\u00a00', routes.showroom.it],
    ],
    heroAlt: 'Officina luminosa con un’auto sul ponte sollevatore e un meccanico al lavoro sul motore',
    strip: {
      hours: 'Orari lun – ven',
      google: 'Google',
      reviews: 'recensioni',
      fee: 'Revisione auto',
      feeNote: 'tariffa nazionale',
      where: 'Dove',
      whereVal: 'Via W. von Siemens 4/F',
      whereNote: 'Bolzano Sud',
    },
    servicesLabel: 'Quattro servizi, una sede',
    servicesTitle: 'Dal controllo obbligatorio alla prossima auto.',
    services: [
      {
        key: 'revisione',
        title: 'Revisione',
        text: 'Centro revisioni affiliato DEKRA per autovetture. Prenoti online, aspetti in sede, esci con l’esito sul libretto.',
        facts: ['79,02 € tariffa nazionale', 'Prenotazione online'],
        href: routes.revisione.it,
        foto: 'revisione-linea',
        alt: 'Berlina argento sul ponte sollevatore con il cofano aperto',
      },
      {
        key: 'officina',
        title: 'Officina',
        text: 'Tagliandi, freni, distribuzione, diagnosi elettronica. Prima ti diciamo cosa serve e quanto costa, poi mettiamo le mani sull’auto.',
        facts: ['Tagliandi', 'Freni', 'Diagnosi'],
        href: `${routes.officina.it}#officina`,
        foto: 'officina-ponti',
        alt: 'Officina ordinata con diverse auto in lavorazione',
      },
      {
        key: 'carrozzeria',
        title: 'Carrozzeria',
        text: 'Graffi, ammaccature, danni alla scocca. Mandaci una foto del danno e ricevi un preventivo senza venire in sede.',
        facts: ['Preventivo da foto', 'Raddrizzatura', 'Verniciatura'],
        href: `${routes.officina.it}#carrozzeria`,
        foto: 'carrozzeria',
        alt: 'Carrozziere che lucida la fiancata di un’auto grigia',
      },
      {
        key: 'auto',
        title: 'Auto usate e km\u00a00',
        text: 'Poche auto, scelte una per una e controllate nella nostra officina prima della vendita.',
        facts: ['Usato con garanzia', 'Km 0', 'Permute'],
        href: routes.showroom.it,
        foto: 'piazzale-auto',
        alt: 'SUV bianco parcheggiato su un piazzale con foglie autunnali',
      },
    ],
    flowTitle: 'Se la revisione non passa, non ricominci da capo.',
    flowText: 'Il vantaggio di avere tutto nella stessa sede si vede proprio quando qualcosa va storto.',
    flow: [
      { t: 'Revisione', d: 'Il controllo trova un difetto: una luce, i freni, le emissioni.' },
      { t: 'Diagnosi', d: 'L’officina ti dice subito cosa serve e quanto costa.' },
      { t: 'Riparazione', d: 'Ripariamo qui. Niente carro attrezzi, niente altra officina.' },
      { t: 'Nuova verifica', d: 'Ripresenti l’auto entro un mese, a pochi metri di distanza.' },
    ],
    trustLabel: 'Fiducia',
    trustTitle: 'clienti lo hanno scritto su Google.',
    trustOf: 'su 5',
    reasons: [
      { t: 'Centro revisioni affiliato DEKRA', d: 'Controlli eseguiti con le procedure DEKRA, secondo le norme del Ministero dei Trasporti.' },
      { t: 'Officina e carrozzeria interne', d: 'Un solo interlocutore dalla diagnosi alla consegna. Nessun passaggio di mano.' },
      // TODO: confermare con il cliente la politica sui preventivi
      { t: 'Prezzo chiaro prima di iniziare', d: 'Sai cosa facciamo e quanto costa prima che l’auto entri in officina.' },
    ],
    carsLabel: 'Auto in vendita',
    carsAll: 'Tutte le auto',
    carsTitle: 'Poche auto, scelte bene.',
    carsText: 'Usato controllato e km 0 con garanzia. Ogni auto ha la sua scheda completa, con prezzo in chiaro.',
    calcLabel: 'Scadenza revisione',
    calcTitle: 'Quando scade la tua revisione?',
    calcText: 'Indica il mese e l’anno: calcoliamo la scadenza secondo il Codice della Strada. Se vuoi, ti avvisiamo noi 30 e 7 giorni prima.',
    whereLabel: 'Dove siamo',
    whereTitle: 'Zona produttiva Bolzano Sud.',
    // TODO: se c'è parcheggio clienti, dirlo qui (dato da confermare)
    whereText: 'Fuori dal traffico del centro, a pochi minuti dalla città. Prima di venire, una telefonata ti evita l’attesa.',
    faqLabel: 'Domande frequenti',
    faq: [
      { q: 'Quanto costa la revisione a Bolzano e come si prenota?', a: `${formatPrice(site.revisionFee.total, 'it', 2)} tutto compreso: è la tariffa nazionale, uguale in tutti i centri autorizzati. Si prenota online sul portale DEKRA, scegliendo giorno e ora.` },
      { q: 'Se l’auto non passa la revisione, dove la riparo?', a: 'Qui. Officina e carrozzeria sono nella stessa sede del centro revisioni: ti diciamo cosa serve e quanto costa, ripariamo e ripresenti l’auto a pochi metri di distanza.' },
      { q: 'Fate tagliandi e riparazioni su tutte le marche?', a: 'Sì. Tagliandi secondo le specifiche del costruttore, freni, distribuzione, diagnosi elettronica e carrozzeria per auto di ogni marca.' },
      { q: 'Posso avere un preventivo di carrozzeria senza venire in sede?', a: 'Sì. Dal modulo della pagina Officina e carrozzeria carichi fino a 6 foto del danno dal telefono e ti ricontattiamo con una stima.' },
      { q: 'Mi ricordate voi quando scade la revisione?', a: 'Sì, gratis. Ti iscrivi in 30 secondi alla pagina Promemoria revisione: ti scriviamo via email o WhatsApp 30 e 7 giorni prima della scadenza.' },
      { q: 'Dove siete e quando siete aperti?', a: `In ${site.address.street.it}, zona produttiva di Bolzano Sud. Dal lunedì al venerdì, 8:30–12:30 e 14:00–18:00.` },
    ],
  },
  de: {
    title: 'Revision, Werkstatt, Karosserie und Gebrauchtwagen in Bozen',
    description:
      'DEKRA-Partner für die Fahrzeugrevision, Kfz-Werkstatt, Karosserie, Gebrauchtwagen und Tageszulassungen in der Werner-von-Siemens-Straße 4/F in Bozen. Revision online buchen.',
    eyebrow: 'Bozen Süd · Werner-von-Siemens-Straße 4/F',
    h1: ['Eine Adresse.', 'Alles für Ihr Auto.'],
    kicker: 'Revision, Werkstatt und Karosserie in Bozen',
    lead: 'Revision, Mechanik und Karosserie unter einem Dach in Bozen Süd. Findet die Revision einen Mangel, beheben wir ihn gleich hier.',
    svcNav: 'Unsere Leistungen',
    svc: [
      ['Revision', routes.revisione.de],
      ['Werkstatt', `${routes.officina.de}#werkstatt`],
      ['Karosserie', `${routes.officina.de}#karosserie`],
      ['Fahrzeuge', routes.showroom.de],
    ],
    heroAlt: 'Helle Werkstatt mit einem Auto auf der Hebebühne und einem Mechaniker am Motor',
    strip: {
      hours: 'Öffnungszeiten Mo – Fr',
      google: 'Google',
      reviews: 'Bewertungen',
      fee: 'Revision Pkw',
      feeNote: 'staatlicher Tarif',
      where: 'Standort',
      whereVal: 'W.-von-Siemens-Str. 4/F',
      whereNote: 'Bozen Süd',
    },
    servicesLabel: 'Vier Leistungen, ein Standort',
    servicesTitle: 'Von der Pflichtprüfung bis zum nächsten Auto.',
    services: [
      {
        key: 'revisione',
        title: 'Revision',
        text: 'DEKRA-Partner für die Revision von Pkw. Online buchen, vor Ort warten, mit dem Ergebnis im Fahrzeugschein wieder abfahren.',
        facts: ['79,02 € staatlicher Tarif', 'Online-Buchung'],
        href: routes.revisione.de,
        foto: 'revisione-linea',
        alt: 'Silberne Limousine mit geöffneter Motorhaube auf der Hebebühne',
      },
      {
        key: 'officina',
        title: 'Werkstatt',
        text: 'Inspektion, Bremsen, Zahnriemen, elektronische Diagnose. Erst sagen wir Ihnen, was nötig ist und was es kostet, dann geht es los.',
        facts: ['Inspektion', 'Bremsen', 'Diagnose'],
        href: `${routes.officina.de}#werkstatt`,
        foto: 'officina-ponti',
        alt: 'Aufgeräumte Werkstatt mit mehreren Fahrzeugen in Arbeit',
      },
      {
        key: 'carrozzeria',
        title: 'Karosserie',
        text: 'Kratzer, Dellen, Schäden an der Karosserie. Schicken Sie uns ein Foto und erhalten Sie ein Angebot, ohne vorbeizukommen.',
        facts: ['Angebot per Foto', 'Richtarbeiten', 'Lackierung'],
        href: `${routes.officina.de}#karosserie`,
        foto: 'carrozzeria',
        alt: 'Karosseriebauer poliert die Seite eines grauen Autos',
      },
      {
        key: 'auto',
        title: 'Gebrauchtwagen',
        text: 'Wenige Fahrzeuge, einzeln ausgewählt und vor dem Verkauf in unserer Werkstatt geprüft.',
        facts: ['Mit Garantie', 'Tageszulassungen', 'Inzahlungnahme'],
        href: routes.showroom.de,
        foto: 'piazzale-auto',
        alt: 'Weißer SUV auf einem Platz mit Herbstlaub',
      },
    ],
    flowTitle: 'Nicht bestanden? Dann fangen Sie nicht von vorne an.',
    flowText: 'Der Vorteil eines einzigen Standorts zeigt sich genau dann, wenn etwas nicht passt.',
    flow: [
      { t: 'Revision', d: 'Die Prüfung findet einen Mangel: Licht, Bremsen, Abgaswerte.' },
      { t: 'Diagnose', d: 'Die Werkstatt sagt Ihnen sofort, was nötig ist und was es kostet.' },
      { t: 'Reparatur', d: 'Wir reparieren hier. Kein Abschleppwagen, keine andere Werkstatt.' },
      { t: 'Nachprüfung', d: 'Sie stellen das Auto innerhalb eines Monats erneut vor, ein paar Meter weiter.' },
    ],
    trustLabel: 'Vertrauen',
    trustTitle: 'Kunden haben es auf Google geschrieben.',
    trustOf: 'von 5',
    reasons: [
      { t: 'DEKRA-Partner für die Revision', d: 'Prüfungen nach den Verfahren von DEKRA und den Vorgaben des Verkehrsministeriums.' },
      { t: 'Eigene Werkstatt und Karosserie', d: 'Ein Ansprechpartner von der Diagnose bis zur Übergabe. Ohne Umwege.' },
      { t: 'Klarer Preis vor Arbeitsbeginn', d: 'Sie wissen, was wir machen und was es kostet, bevor das Auto in die Werkstatt fährt.' },
    ],
    carsLabel: 'Fahrzeuge',
    carsAll: 'Alle Fahrzeuge',
    carsTitle: 'Wenige Autos, gut ausgewählt.',
    carsText: 'Geprüfte Gebrauchtwagen und Tageszulassungen mit Garantie. Jedes Fahrzeug mit vollständigem Datenblatt und klarem Preis.',
    calcLabel: 'Fälligkeit Revision',
    calcTitle: 'Wann ist Ihre Revision fällig?',
    calcText: 'Monat und Jahr angeben: Wir berechnen den Termin nach der Straßenverkehrsordnung. Auf Wunsch erinnern wir Sie 30 und 7 Tage vorher.',
    whereLabel: 'Anfahrt',
    whereTitle: 'Gewerbegebiet Bozen Süd.',
    whereText: 'Abseits vom Stadtverkehr, wenige Minuten vom Zentrum. Ein kurzer Anruf vorab erspart Ihnen Wartezeit.',
    faqLabel: 'Häufige Fragen',
    faq: [
      { q: 'Was kostet die Revision in Bozen und wie bucht man?', a: `${formatPrice(site.revisionFee.total, 'de', 2)} inklusive allem: der staatliche Tarif, in allen zugelassenen Prüfstellen gleich. Gebucht wird online im DEKRA-Portal, mit Wunschtag und Uhrzeit.` },
      { q: 'Das Auto hat die Revision nicht bestanden: Wo lasse ich es reparieren?', a: 'Gleich hier. Werkstatt und Karosserie sind am selben Standort wie die Prüfstelle: Wir sagen Ihnen, was nötig ist und was es kostet, reparieren und Sie stellen das Auto ein paar Meter weiter erneut vor.' },
      { q: 'Machen Sie Inspektion und Reparaturen für alle Marken?', a: 'Ja. Inspektion nach Herstellervorgaben, Bremsen, Zahnriemen, elektronische Diagnose und Karosserie für Fahrzeuge aller Marken.' },
      { q: 'Bekomme ich ein Karosserie-Angebot, ohne vorbeizukommen?', a: 'Ja. Über das Formular auf der Seite Werkstatt & Karosserie laden Sie bis zu 6 Fotos vom Schaden hoch, wir melden uns mit einer Schätzung.' },
      { q: 'Erinnern Sie mich an die Revision?', a: 'Ja, kostenlos. Melden Sie sich in 30 Sekunden auf der Seite Revisions-Erinnerung an: Wir schreiben Ihnen per E-Mail oder WhatsApp 30 und 7 Tage vor Ablauf.' },
      { q: 'Wo sind Sie und wann haben Sie geöffnet?', a: `In der ${site.address.street.de}, Gewerbegebiet Bozen Süd. Montag bis Freitag, 8:30–12:30 und 14:00–18:00 Uhr.` },
    ],
  },
}[lang];

// Anteprima che segue il cursore sull'indice servizi: foto locale (src/assets/foto/) o segnaposto Unsplash
const previewSrc = async (key: FotoKey) => {
  const loc = fotoLocale(key);
  if (loc) return (await getImage({ src: loc, width: Math.min(560, loc.width), format: 'webp' })).src;
  const u = fotoUnsplash(key);
  return u ? unsplash(u.id, 560, [4, 3], u.crop, 70) : '';
};
const previews = await Promise.all(copy.services.map((s) => previewSrc(s.foto as FotoKey)));
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: copy.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
// Titolo in due frasi; ogni parola sale da una maschera, i punti finali sono arancio (come l'accento del logo)
const lines = copy.h1.map((l) => l.split(' '));
let wordIndex = 0;
// Foto a tutto schermo. Con la foto vera (src/assets/foto/hero.*) la ottimizza astro:assets;
// col segnaposto Unsplash: verticale (3:4, centrata su auto e meccanico) per il mobile, panoramica da tablet in su
const heroLocal = fotoLocale('hero');
const heroRemote = fotoUnsplash('hero')!;
const heroId = heroRemote.id;
const fp = heroRemote.crop;
const heroLocalWidths = heroLocal ? [640, 828, 1080, 1440, 1920, 2400].filter((w) => w <= heroLocal.width) : [];
// Qualità più bassa: la foto è virata e velata di blu, la compressione non si vede
const heroPortrait = unsplashSrcset(heroId, [480, 640, 828, 1080], [3, 4], fp, 48);
const heroWide = unsplashSrcset(heroId, [1080, 1440, 1920, 2400], [16, 9], fp, 52);
---
<Base lang={lang} title={copy.title} description={copy.description} alternates={alternatesFor('home')} current="home" overlayHeader jsonLd={[faqLd]}>
  {!heroLocal && <link slot="head" rel="preload" as="image" media="(max-width: 47.99rem)" imagesrcset={heroPortrait} imagesizes="100vw" fetchpriority="high" />}
  {!heroLocal && <link slot="head" rel="preload" as="image" media="(min-width: 48rem)" imagesrcset={heroWide} imagesizes="100vw" fetchpriority="high" />}
  <!-- HERO: foto a tutto schermo, composizione che ricalca il logo (linea del tetto sopra, filetto arancio + BOLZANO sotto) -->
  <section class="hero on-dark">
    <div class="hero-stage">
      <div class="hero-media" aria-hidden="false">
        <div data-parallax="12" class="absolute inset-0">
          {heroLocal ? (
            <Picture src={heroLocal} alt={copy.heroAlt} formats={['avif', 'webp']} fallbackFormat="webp" widths={heroLocalWidths} sizes="100vw" loading="eager" fetchpriority="high" class="hero-img" />
          ) : (
          <picture>
            <source media="(min-width: 48rem)" srcset={heroWide} sizes="100vw" />
            <img
              src={unsplash(heroId, 828, [3, 4], fp, 48)}
              srcset={heroPortrait}
              sizes="100vw"
              alt={copy.heroAlt}
              width="828"
              height="1104"
              fetchpriority="high"
              decoding="async"
              class="hero-img"
            />
          </picture>
          )}
        </div>
        <span class="hero-tint" aria-hidden="true"></span>
        <span class="hero-scrim" aria-hidden="true"></span>
      </div>

      <div class="hero-content wrap">
        <div class="hero-top hero-fade" style="animation-delay:200ms">
          <OpenStatus lang={lang} class="chip max-sm:!hidden" />
          <span class="chip"><Icon name="check" size={16} class="text-orange" /> {t.dekra}</span>
        </div>

        <div class="hero-grid">
          <div class="hero-main">
            <RoofLine tone="paper" class="roof-anim hero-roof" weight={1.5} draw={false} />
            <h1>
              <span class="hero-kicker t-label hero-fade" style="animation-delay:200ms">{copy.kicker}</span>
              <span class="sr-only">{copy.h1.join(' ')}</span>
              <span class="hero-title block" aria-hidden="true">
                {lines.map((words) => (
                  <span class="block">
                    {words.map((w, i) => {
                      const delay = 260 + wordIndex++ * 70;
                      const dot = w.endsWith('.');
                      return (
                        <Fragment>
                          <span class="w"><span style={`animation-delay:${delay}ms`}>{dot ? w.slice(0, -1) : w}{dot && <span class="dot">.</span>}</span></span>{i < words.length - 1 ? ' ' : ''}
                        </Fragment>
                      );
                    })}
                  </span>
                ))}
              </span>
            </h1>
            <div class="hero-sig hero-fade" style="animation-delay:640ms" aria-hidden="true">
              <span class="sig-line"></span>
              <span class="t-label sig-place">{lang === 'it' ? 'Bolzano · Bozen' : 'Bozen · Bolzano'}</span>
            </div>
            <nav class="hero-svc hero-fade" style="animation-delay:720ms" aria-label={copy.svcNav}>
              <ol>
                {copy.svc.map(([label, href], i) => (
                  <li>
                    <a href={href}>
                      <span class="t-label t-num svc-n">{String(i + 1).padStart(2, '0')}</span>
                      <span class="svc-l">{label}</span>
                      <Icon name="arrow" size={16} class="svc-a" />
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          </div>

          <div class="hero-side hero-fade" style="animation-delay:760ms">
            <p class="hero-lead max-sm:hidden">{copy.lead}</p>
            <div class="mt-6 flex flex-col gap-3 sm:flex-row lg:flex-col max-sm:mt-0">
              <a href={site.dekra.bookingUrl} class="btn btn-primary" target="_blank" rel="noopener">
                {t.cta.book}<span class="sr-only"> ({t.externalBooking})</span>
                <Icon name="arrow-up-right" size={18} class="btn-arrow" />
              </a>
              <a href={routes.showroom[lang]} class="btn btn-ghost">
                {t.cta.cars} <Icon name="arrow" size={18} class="btn-arrow" />
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Fascia dati stile scheda tecnica -->
    <div class="wrap">
      <dl class="strip t-num">
        <div>
          <dt class="t-label">{copy.strip.hours}</dt>
          <dd class="strip-val">{site.hours.map((h) => `${h.open.replace(/^0/, '')}–${h.close}`).join(' · ')}</dd>
        </div>
        <div>
          <dt class="t-label">{copy.strip.google}</dt>
          <dd class="strip-val"><span data-g-rating>{formatNumber(site.google.rating, lang, 1)}</span> / 5</dd>
          <dd class="strip-note"><span data-g-count>{site.google.reviewCount}</span> {copy.strip.reviews}</dd>
        </div>
        <div>
          <dt class="t-label">{copy.strip.fee}</dt>
          <dd class="strip-val">{formatPrice(site.revisionFee.total, lang, 2)}</dd>
          <dd class="strip-note">{copy.strip.feeNote}</dd>
        </div>
        <div>
          <dt class="t-label">{copy.strip.where}</dt>
          <dd class="strip-val">{copy.strip.whereVal}</dd>
          <dd class="strip-note">{copy.strip.whereNote}</dd>
        </div>
      </dl>
    </div>
  </section>

  <Marquee lang={lang} />

  <!-- SERVIZI -->
  <section class="section-y" aria-labelledby="services-title">
    <div class="wrap">
      <SectionHead num="01" label={copy.servicesLabel} />
      <h2 id="services-title" class="t-h2 mt-8 max-w-[22ch] lg:mt-12" data-reveal>{copy.servicesTitle}</h2>

      <ol class="services mt-10 lg:mt-16" data-services>
        {copy.services.map((s, i) => (
          <li data-reveal>
            <a href={s.href} class="service-row group" data-img={s.foto}>
              <span class="t-label t-num text-orange-ink pt-1">{String(i + 1).padStart(2, '0')}</span>
              <span class="service-main">
                <span class="service-title">{s.title}</span>
                <span class="mt-3 block max-w-[52ch] text-muted">{s.text}</span>
                <span class="mt-4 flex flex-wrap gap-x-4 gap-y-1 t-label text-ink">
                  {s.facts.map((f) => <span class="fact">{f}</span>)}
                </span>
              </span>
              <span class="service-thumb lg:hidden">
                <Photo foto={s.foto as FotoKey} alt="" sizes="96px" ratio={[1, 1]} widths={[160, 240]} />
              </span>
              <span class="service-arrow" aria-hidden="true"><Icon name="arrow" size={26} /></span>
            </a>
          </li>
        ))}
      </ol>

      <!-- Anteprima immagine che segue il cursore (solo desktop con mouse) -->
      <div class="cursor-preview" aria-hidden="true" data-cursor-preview>
        {copy.services.map((s, i) => (
          <img
            src={previews[i]}
            alt=""
            width="560"
            height="420"
            loading="lazy"
            data-preview={s.foto}
          />
        ))}
      </div>

      <!-- Il vantaggio della sede unica -->
      <div class="flow mt-20 grid-12 gap-y-10 lg:mt-32">
