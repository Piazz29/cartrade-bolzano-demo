<script>
  // Anteprima foto che segue il cursore sull'indice servizi (desktop). Interpolazione morbida senza librerie.
  const list = document.querySelector<HTMLElement>('[data-services]');
  const preview = document.querySelector<HTMLElement>('[data-cursor-preview]');
  const fine = window.matchMedia('(pointer: fine) and (min-width: 64rem)').matches;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (list && preview && fine) {
    let x = 0, y = 0, cx = 0, cy = 0, raf = 0;
    const loop = () => {
      const k = reduce ? 1 : 0.16;
      cx += (x - cx) * k;
      cy += (y - cy) * k;
      preview.style.transform = `translate3d(${cx + 28}px, ${cy - 120}px, 0)`;
      raf = requestAnimationFrame(loop);
    };
    list.addEventListener('pointerenter', (e) => {
      x = cx = e.clientX;
      y = cy = e.clientY;
      preview.classList.add('is-on');
      raf = requestAnimationFrame(loop);
    });
    list.addEventListener('pointerleave', () => {
      preview.classList.remove('is-on');
      cancelAnimationFrame(raf);
    });
    list.addEventListener('pointermove', (e) => {
      x = e.clientX;
      y = e.clientY;
    });
    list.querySelectorAll<HTMLElement>('[data-img]').forEach((row) => {
      row.addEventListener('pointerenter', () => {
        preview.querySelectorAll('img').forEach((img) => img.classList.toggle('is-on', img.dataset.preview === row.dataset.img));
      });
    });
  }
</script>
