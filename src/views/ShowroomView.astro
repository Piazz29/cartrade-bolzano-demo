---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CarCard from '../components/CarCard.astro';
import Icon from '../components/Icon.astro';
import { site, formatPrice, type Lang } from '../data/site';
import { alternatesFor, carUrl } from '../i18n/routes';
import { carLabels, localizeVersion } from '../i18n/cars';

interface Props { lang: Lang }
const { lang } = Astro.props;
const L = carLabels[lang];

// DEMO: le auto arrivano dalla content collection src/content/cars (tutte marcate demo: true)
const cars = (await getCollection('cars')).sort((a, b) => b.data.registration.localeCompare(a.data.registration));
const makes = [...new Set(cars.map((c) => c.data.make))].sort();
const years = [...new Set(cars.map((c) => c.data.year))].sort((a, b) => b - a);
const fuels = [...new Set(cars.map((c) => c.data.fuel))];
const gearboxes = [...new Set(cars.map((c) => c.data.gearbox))];
const roundUp = (n: number, step: number) => Math.ceil(n / step) * step;
const priceMax = roundUp(Math.max(...cars.map((c) => c.data.price)), 1000);
const priceMin = Math.floor(Math.min(...cars.map((c) => c.data.price)) / 1000) * 1000;
const kmMax = roundUp(Math.max(...cars.map((c) => c.data.km)), 10000);

const copy = {
  it: {
    title: 'Auto usate e km 0 a Bolzano',
    description: `Auto usate selezionate e km 0 a Bolzano: ${cars.length} vetture con garanzia, controllate nella nostra officina. Filtra per marca, prezzo, km e alimentazione.`,
    label: 'Auto in vendita',
    h1: 'Auto usate e km\u00a00, controllate in officina.',
    lead: 'Poche auto, scelte una per una. Ogni scheda ha prezzo, chilometri e dotazioni in chiaro: se ti interessa, scrivici su WhatsApp o passa a vederla.',
    filters: 'Filtri',
    showResults: 'Mostra {n} auto',
    make: 'Marca',
    allMakes: 'Tutte le marche',
    priceTo: 'Prezzo fino a',
    kmTo: 'Chilometri fino a',
    yearFrom: 'Anno da',
    any: 'Qualsiasi',
    condition: 'Condizione',
    sort: 'Ordina per',
    sorts: [['new', 'Più recenti'], ['priceAsc', 'Prezzo crescente'], ['priceDesc', 'Prezzo decrescente'], ['kmAsc', 'Meno chilometri']],
    reset: 'Azzera filtri',
    count: '{n} auto',
    countOne: '1 auto',
    empty: 'Nessuna auto con questi filtri.',
    emptyText: 'Prova ad allargare la ricerca, oppure dicci cosa cerchi: spesso troviamo l’auto giusta prima che arrivi online.',
    ask: 'Scrivici cosa cerchi',
    searchText: 'Buongiorno, sto cercando un’auto con queste caratteristiche: ',
    // TODO: confermare con il cliente se accetta permute e offre finanziamenti
    perks: ['Garanzia su ogni auto', 'Permuta del tuo usato', 'Finanziamento su richiesta'],
  },
  de: {
    title: 'Gebrauchtwagen und Tageszulassungen in Bozen',
    description: `Ausgewählte Gebrauchtwagen und Tageszulassungen in Bozen: ${cars.length} Fahrzeuge mit Garantie, in unserer Werkstatt geprüft. Nach Marke, Preis, Kilometern und Kraftstoff filtern.`,
    label: 'Fahrzeuge',
    h1: 'Gebrauchtwagen und Tageszulassungen, in der Werkstatt geprüft.',
    lead: 'Wenige Autos, einzeln ausgewählt. Jedes Datenblatt zeigt Preis, Kilometer und Ausstattung offen: Bei Interesse schreiben Sie uns auf WhatsApp oder kommen vorbei.',
    filters: 'Filter',
    showResults: '{n} Fahrzeuge anzeigen',
    make: 'Marke',
    allMakes: 'Alle Marken',
    priceTo: 'Preis bis',
    kmTo: 'Kilometer bis',
    yearFrom: 'Baujahr ab',
    any: 'Beliebig',
    condition: 'Zustand',
    sort: 'Sortieren nach',
    sorts: [['new', 'Neueste zuerst'], ['priceAsc', 'Preis aufsteigend'], ['priceDesc', 'Preis absteigend'], ['kmAsc', 'Wenigste Kilometer']],
    reset: 'Filter zurücksetzen',
    count: '{n} Fahrzeuge',
    countOne: '1 Fahrzeug',
    empty: 'Keine Fahrzeuge mit diesen Filtern.',
    emptyText: 'Erweitern Sie die Suche oder sagen Sie uns, was Sie suchen: Oft finden wir das passende Auto, bevor es online ist.',
    ask: 'Suchauftrag senden',
    searchText: 'Guten Tag, ich suche ein Auto mit folgenden Merkmalen: ',
    perks: ['Garantie auf jedes Fahrzeug', 'Inzahlungnahme Ihres Autos', 'Finanzierung auf Anfrage'],
  },
}[lang];

const listLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: cars.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `${Astro.site!.toString().replace(/\/$/, '')}${carUrl(c.id, lang)}`,
    name: `${c.data.make} ${c.data.model} ${localizeVersion(c.data.version, lang)}`,
  })),
};
---
<Base lang={lang} title={copy.title} description={copy.description} alternates={alternatesFor('showroom')} current="showroom" jsonLd={[listLd]}>
  <PageHero lang={lang} label={copy.label} title={copy.h1} lead={copy.lead}>
    <ul slot="aside" class="perks">
      {copy.perks.map((p) => <li><Icon name="check" size={18} class="text-orange-ink" /> {p}</li>)}
    </ul>
  </PageHero>

  <section class="pb-[var(--section)] pt-8 lg:pt-12" aria-label={copy.label}>
    <div
      class="wrap showroom"
      data-showroom
      data-copy={JSON.stringify({ count: copy.count, countOne: copy.countOne, showResults: copy.showResults, filters: copy.filters, searchText: copy.searchText, priceTo: copy.priceTo, kmTo: copy.kmTo })}
      data-lang={lang}
      data-wa={site.whatsapp.number}
    >
      <!-- Barra superiore: conteggio, filtri (mobile), ordinamento -->
      <div class="topbar">
        <p class="t-h3 t-num" aria-live="polite" data-count>{copy.count.replace('{n}', String(cars.length))}</p>
        <div class="flex items-center gap-2">
          <button type="button" class="btn btn-ghost !min-h-[2.75rem] !px-4 !py-2 lg:!hidden" aria-expanded="false" aria-controls="filters" data-filters-toggle>
            <Icon name="filter" size={18} /> <span data-filters-label>{copy.filters}</span>
          </button>
          <label class="sr-only" for="sort">{copy.sort}</label>
          <select id="sort" class="input !min-h-[2.75rem] !w-auto !py-2 text-[0.9375rem]" data-sort>
            {copy.sorts.map(([v, l]) => <option value={v}>{l}</option>)}
          </select>
        </div>
      </div>

      <div class="layout">
        <!-- Filtri -->
        <div class="scrim lg:hidden" data-scrim hidden></div>
        <form id="filters" class="filters" data-filters>
          <div class="field">
            <label for="f-make">{copy.make}</label>
            <select id="f-make" name="make" class="input">
              <option value="">{copy.allMakes}</option>
              {makes.map((m) => <option value={m}>{m}</option>)}
            </select>
          </div>

          <div class="field">
            <div class="flex items-baseline justify-between">
              <label for="f-price">{copy.priceTo}</label>
              <output for="f-price" class="t-num font-semibold" data-out="price">{formatPrice(priceMax, lang)}</output>
            </div>
            <input id="f-price" name="price" type="range" min={priceMin} max={priceMax} step="500" value={priceMax} class="range" />
          </div>

          <div class="field">
            <div class="flex items-baseline justify-between">
              <label for="f-km">{copy.kmTo}</label>
              <output for="f-km" class="t-num font-semibold" data-out="km">{new Intl.NumberFormat(lang === 'it' ? 'it-IT' : 'de-DE').format(kmMax)} km</output>
            </div>
            <input id="f-km" name="km" type="range" min="0" max={kmMax} step="5000" value={kmMax} class="range" />
          </div>

          <div class="field">
            <label for="f-year">{copy.yearFrom}</label>
            <select id="f-year" name="year" class="input t-num">
              <option value="">{copy.any}</option>
              {years.map((y) => <option value={y}>{y}</option>)}
            </select>
          </div>

          <fieldset class="field">
            <legend class="label mb-2">{L.fuelLabel}</legend>
            <div class="flex flex-wrap gap-2">
              {fuels.map((f) => (
                <span class="chip"><input type="checkbox" name="fuel" id={`f-fuel-${f}`} value={f} /><label for={`f-fuel-${f}`}>{L.fuel[f]}</label></span>
              ))}
            </div>
          </fieldset>

          <fieldset class="field">
            <legend class="label mb-2">{L.gearboxLabel}</legend>
            <div class="flex flex-wrap gap-2">
              {gearboxes.map((g) => (
                <span class="chip"><input type="checkbox" name="gearbox" id={`f-gb-${g}`} value={g} /><label for={`f-gb-${g}`}>{L.gearbox[g]}</label></span>
              ))}
            </div>
          </fieldset>

          <fieldset class="field">
            <legend class="label mb-2">{copy.condition}</legend>
            <div class="flex flex-wrap gap-2">
              {(['used', 'km0'] as const).map((c) => (
                <span class="chip"><input type="checkbox" name="condition" id={`f-cond-${c}`} value={c} /><label for={`f-cond-${c}`}>{L.condition[c]}</label></span>
              ))}
            </div>
          </fieldset>

          <div class="flex flex-col gap-3 border-t border-[var(--line)] pt-5">
            <button type="reset" class="link-u self-start text-[0.9375rem] font-semibold" data-reset>{copy.reset}</button>
            <button type="button" class="btn btn-ink w-full lg:hidden" data-filters-close>
              <span data-show-results>{copy.showResults.replace('{n}', String(cars.length))}</span>
            </button>
          </div>
        </form>

        <!-- Risultati -->
        <div>
          <ul class="grid-cars" data-results>
            {cars.map((car) => (
              <li
                data-car-item
                data-make={car.data.make}
                data-price={car.data.price}
                data-km={car.data.km}
                data-year={car.data.year}
                data-fuel={car.data.fuel}
                data-gearbox={car.data.gearbox}
                data-condition={car.data.condition}
                data-reg={car.data.registration}
              >
                <CarCard car={car} lang={lang} sizes="(min-width: 80rem) 24vw, (min-width: 64rem) 33vw, (min-width: 40rem) 45vw, 92vw" headingLevel="h2" />
              </li>
            ))}
          </ul>
          <div class="empty" data-empty hidden>
            <p class="t-h3">{copy.empty}</p>
            <p class="mt-3 max-w-[48ch] text-muted">{copy.emptyText}</p>
            <div class="mt-6 flex flex-wrap gap-3">
              <button type="button" class="btn btn-ink" data-reset-empty>{copy.reset}</button>
              <a href={site.whatsapp.href(copy.searchText)} class="btn btn-ghost" target="_blank" rel="noopener" data-ask><Icon name="whatsapp" size={19} /> {copy.ask}</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
@layer components {
  .perks { display: grid; border-top: 1px solid var(--line-strong); }
  .perks li { display: flex; gap: 0.75rem; align-items: center; padding-block: 0.85rem; border-bottom: 1px solid var(--line); font-weight: 520; }

  .topbar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.75rem 1rem; padding-bottom: 1.25rem; border-bottom: 1px solid var(--line-strong); }
  .topbar > p { white-space: nowrap; }
  @media (max-width: 63.99rem) {
    .topbar > div { width: 100%; }
    .topbar > div > * { flex: 1 1 0; min-width: 0; }
  }
  .layout { display: grid; gap: 2rem; margin-top: 1.75rem; }
  @media (min-width: 64rem) { .layout { grid-template-columns: 16.5rem minmax(0, 1fr); gap: 3rem; } }

  .filters { display: grid; gap: 1.6rem; align-content: start; }
  @media (max-width: 63.99rem) {
    .filters {
      position: fixed;
      inset: auto 0 0 0;
      z-index: 70;
      max-height: 88dvh;
      overflow-y: auto;
      padding: 1.5rem var(--gutter) calc(1.5rem + env(safe-area-inset-bottom));
      background: var(--color-paper);
      border-top: 1px solid var(--line-strong);
      transform: translateY(105%);
      visibility: hidden;
      transition: transform 0.5s var(--ease-out-expo), visibility 0s linear 0.5s;
    }
    .filters.is-open { transform: none; visibility: visible; transition: transform 0.5s var(--ease-out-expo); }
  }
  @media (min-width: 64rem) { .filters { position: sticky; top: calc(var(--header-h) + 1.5rem); } }

  .scrim { position: fixed; inset: 0; z-index: 65; background: color-mix(in oklab, var(--color-night) 55%, transparent); animation: scrim-in 0.4s var(--ease-out-quart); }
  @keyframes scrim-in { from { opacity: 0; } }
  .range { width: 100%; accent-color: var(--color-ink); height: 2.75rem; cursor: pointer; }

  .grid-cars { display: grid; gap: 2.75rem var(--gutter); grid-template-columns: 1fr; }
  @media (min-width: 40rem) { .grid-cars { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 80rem) { .grid-cars { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .grid-cars li { animation: card-in 0.6s var(--ease-out-expo) both; }
  @keyframes card-in { from { opacity: 0; transform: translateY(12px); } }
  .empty { padding: 2.5rem 0; border-top: 1px solid var(--line); }
}
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-showroom]').forEach((root) => {
    const copy = JSON.parse(root.dataset.copy!);
    const locale = root.dataset.lang === 'de' ? 'de-DE' : 'it-IT';
    const form = root.querySelector<HTMLFormElement>('[data-filters]')!;
    const list = root.querySelector<HTMLUListElement>('[data-results]')!;
    const items = [...list.querySelectorAll<HTMLLIElement>('[data-car-item]')];
    const sortSel = root.querySelector<HTMLSelectElement>('[data-sort]')!;
    const countEl = root.querySelector<HTMLElement>('[data-count]')!;
    const empty = root.querySelector<HTMLElement>('[data-empty]')!;
    const toggle = root.querySelector<HTMLButtonElement>('[data-filters-toggle]')!;
    const toggleLabel = root.querySelector<HTMLElement>('[data-filters-label]')!;
    const showBtn = root.querySelector<HTMLElement>('[data-show-results]')!;
    const price = form.elements.namedItem('price') as HTMLInputElement;
    const km = form.elements.namedItem('km') as HTMLInputElement;
    const eur = new Intl.NumberFormat(locale, { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 });
    const num = new Intl.NumberFormat(locale);

    const state = () => {
      const fd = new FormData(form);
      return {
        make: String(fd.get('make') || ''),
        price: Number(price.value),
        km: Number(km.value),
        year: Number(fd.get('year') || 0),
        fuel: fd.getAll('fuel') as string[],
        gearbox: fd.getAll('gearbox') as string[],
        condition: fd.getAll('condition') as string[],
        sort: sortSel.value,
      };
    };

    const activeCount = (s: ReturnType<typeof state>) =>
      [s.make, s.price < Number(price.max), s.km < Number(km.max), s.year].filter(Boolean).length + s.fuel.length + s.gearbox.length + s.condition.length;

    function apply(push = true) {
      const s = state();
      root.querySelector('[data-out="price"]')!.textContent = eur.format(s.price);
      root.querySelector('[data-out="km"]')!.textContent = `${num.format(s.km)} km`;

      const visible = items.filter((li) => {
        const d = li.dataset;
        return (
          (!s.make || d.make === s.make) &&
          Number(d.price) <= s.price &&
          Number(d.km) <= s.km &&
          (!s.year || Number(d.year) >= s.year) &&
          (!s.fuel.length || s.fuel.includes(d.fuel!)) &&
          (!s.gearbox.length || s.gearbox.includes(d.gearbox!)) &&
          (!s.condition.length || s.condition.includes(d.condition!))
        );
      });
      const key: Record<string, (a: HTMLElement, b: HTMLElement) => number> = {
        new: (a, b) => b.dataset.reg!.localeCompare(a.dataset.reg!),
        priceAsc: (a, b) => Number(a.dataset.price) - Number(b.dataset.price),
        priceDesc: (a, b) => Number(b.dataset.price) - Number(a.dataset.price),
        kmAsc: (a, b) => Number(a.dataset.km) - Number(b.dataset.km),
      };
      items.forEach((li) => (li.hidden = !visible.includes(li)));
      [...visible].sort(key[s.sort] ?? key.new).forEach((li) => list.append(li));

      const n = visible.length;
      countEl.textContent = n === 1 ? copy.countOne : copy.count.replace('{n}', String(n));
      showBtn.textContent = copy.showResults.replace('{n}', String(n));
      empty.hidden = n > 0;
      const a = activeCount(s);
      toggleLabel.textContent = a ? `${copy.filters} (${a})` : copy.filters;

      // Link WhatsApp "cerco un'auto" con i filtri attivi
      const ask = root.querySelector<HTMLAnchorElement>('[data-ask]');
      if (ask) {
        const parts = [s.make, s.fuel.join('/'), s.gearbox.join('/'), s.price < Number(price.max) ? `${copy.priceTo} ${eur.format(s.price)}` : '', s.km < Number(km.max) ? `${copy.kmTo} ${num.format(s.km)} km` : ''].filter(Boolean);
        ask.href = `https://wa.me/${root.dataset.wa}?text=${encodeURIComponent(copy.searchText + parts.join(', '))}`;
      }

      if (push) {
        const p = new URLSearchParams();
        if (s.make) p.set('marca', s.make);
        if (s.price < Number(price.max)) p.set('prezzo', String(s.price));
        if (s.km < Number(km.max)) p.set('km', String(s.km));
        if (s.year) p.set('anno', String(s.year));
        s.fuel.forEach((v) => p.append('alimentazione', v));
        s.gearbox.forEach((v) => p.append('cambio', v));
        s.condition.forEach((v) => p.append('condizione', v));
        if (s.sort !== 'new') p.set('ordina', s.sort);
        const qs = p.toString();
        history.replaceState(null, '', qs ? `?${qs}` : location.pathname);
      }
    }

    // Ripristina i filtri dall'URL (ricerca condivisibile)
    const q = new URLSearchParams(location.search);
    const setVal = (n: string, v: string | null) => {
      const el = form.elements.namedItem(n) as HTMLInputElement | null;
      if (el && v) el.value = v;
    };
    setVal('make', q.get('marca'));
    setVal('price', q.get('prezzo'));
    setVal('km', q.get('km'));
    setVal('year', q.get('anno'));
    (
      [
        ['fuel', 'alimentazione'],
        ['gearbox', 'cambio'],
        ['condition', 'condizione'],
      ] as const
    ).forEach(([n, k]) => q.getAll(k).forEach((v) => {
      const box = form.querySelector<HTMLInputElement>(`input[name="${n}"][value="${CSS.escape(v)}"]`);
      if (box) box.checked = true;
    }));
    if (q.get('ordina')) sortSel.value = q.get('ordina')!;

    form.addEventListener('input', () => apply());
    form.addEventListener('change', () => apply());
    sortSel.addEventListener('change', () => apply());
    form.addEventListener('reset', () => setTimeout(() => apply(), 0));
    root.querySelector('[data-reset-empty]')?.addEventListener('click', () => form.reset());

    // Pannello filtri su mobile (bottom sheet)
    const scrim = root.querySelector<HTMLElement>('[data-scrim]')!;
    scrim.addEventListener('click', () => setOpen(false));
    const setOpen = (open: boolean) => {
      form.classList.toggle('is-open', open);
      scrim.hidden = !open;
      document.documentElement.style.overflow = open ? 'hidden' : '';
      toggle.setAttribute('aria-expanded', String(open));
      if (open) form.querySelector<HTMLElement>('select, input')?.focus();
      else toggle.focus();
    };
    toggle.addEventListener('click', () => setOpen(!form.classList.contains('is-open')));
    root.querySelector('[data-filters-close]')?.addEventListener('click', () => setOpen(false));
    form.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && form.classList.contains('is-open')) setOpen(false);
    });

    apply(false);
  });
</script>
