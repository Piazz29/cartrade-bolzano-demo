---
// Intestazione delle pagine interne: etichetta, titolo largo, testo e azioni a sinistra;
// a destra uno slot (foto o pannello dati). Sotto, la linea del tetto.
import RoofLine from './RoofLine.astro';
import { routes } from '../i18n/routes';
import { ui } from '../i18n/ui';
import type { Lang } from '../data/site';
interface Props { lang: Lang; label: string; title: string; lead?: string; wide?: boolean }
const { lang, label, title, lead, wide = false } = Astro.props;
const hasAside = Astro.slots.has('aside');
const siteUrl = Astro.site!.toString().replace(/\/$/, '');
const crumbsLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: ui[lang].nav.home, item: `${siteUrl}${routes.home[lang]}` },
    { '@type': 'ListItem', position: 2, name: label, item: `${siteUrl}${Astro.url.pathname}` },
  ],
};
---
<section class="page-hero">
  <div class="wrap grid-12 gap-y-10 pt-8 pb-8 lg:pt-14 lg:pb-12">
    <div class:list={['col-span-4 flex flex-col', hasAside ? (wide ? 'lg:col-span-8' : 'lg:col-span-7') : 'lg:col-span-10']}>
      <nav aria-label={lang === 'it' ? 'Percorso' : 'Brotkrumen'} class="crumbs">
        <ol class="flex items-center gap-2 text-sm text-muted">
          <li><a href={routes.home[lang]} class="link-u">{ui[lang].nav.home}</a></li>
          <li aria-hidden="true">/</li>
          <li><span aria-current="page" class="text-ink">{label}</span></li>
        </ol>
      </nav>
      <script type="application/ld+json" set:html={JSON.stringify(crumbsLd)} />
      <h1 class="ph-title t-h1 mt-5 max-w-[16ch]">{title}</h1>
      {lead && <p class="ph-fade t-lead measure mt-6 text-ink/80">{lead}</p>}
      {Astro.slots.has('actions') && (
        <div class="ph-fade mt-8 flex flex-col gap-3 xs:flex-row xs:flex-wrap">
          <slot name="actions" />
        </div>
      )}
    </div>
    {hasAside && (
      <div class:list={['col-span-4 lg:self-end', wide ? 'lg:col-span-4' : 'lg:col-span-5']}>
        <slot name="aside" />
      </div>
    )}
  </div>
  <div class="wrap">
    <RoofLine class="roof-anim h-10 w-full lg:h-14" weight={1.5} draw={false} />
  </div>
</section>

<style>
@layer components {
  .ph-title { animation: ph-up 1s var(--ease-out-expo) both; }
  /* Solo movimento, niente opacità: testo e bottoni hanno sempre pieno contrasto */
  .ph-fade { animation: ph-slide 1s var(--ease-out-expo) 0.18s both; }
  @keyframes ph-slide { from { transform: translateY(18px); } }
  @keyframes ph-up { from { opacity: 0; transform: translateY(18px); } }
}
</style>
