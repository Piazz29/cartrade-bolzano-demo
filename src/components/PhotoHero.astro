---
// Hero fotografica per le pagine interne, con lo stesso linguaggio della Home:
// foto virata sul blu del marchio, linea del tetto, titolo in frasi brevi con i punti arancio.
// Desktop: foto a tutto schermo con il testo sopra. Mobile: foto in alto a tutta larghezza che sfuma nel blu,
// testo sotto (evita di ingrandire troppo foto di bassa risoluzione).
// Da usare con <Base overlayHeader>.
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import RoofLine from './RoofLine.astro';
import Icon from './Icon.astro';
import { routes } from '../i18n/routes';
import { ui } from '../i18n/ui';
import type { Lang } from '../data/site';

interface Props {
  lang: Lang;
  label: string;
  title: string[];
  /** riga piccola dentro l'H1 (servizio + città) */
  kicker?: string;
  lead?: string;
  image: ImageMetadata;
  alt: string;
  position?: string;
  caption?: string;
}
const { lang, label, title, kicker, lead, image, alt, position = '50% 50%', caption } = Astro.props;
const siteUrl = Astro.site!.toString().replace(/\/$/, '');
const crumbsLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: ui[lang].nav.home, item: `${siteUrl}${routes.home[lang]}` },
    { '@type': 'ListItem', position: 2, name: label, item: `${siteUrl}${Astro.url.pathname}` },
  ],
};
const lines = title.map((l) => l.split(' '));
let n = 0;
const widths = [480, 640, image.width].filter((w, i, a) => w <= image.width && a.indexOf(w) === i);
---
<section class="phero on-dark">
  <div class="stage">
    <div class="media">
      <div data-parallax="10" class="media-inner">
        <Picture
          src={image}
          alt={alt}
          formats={['avif', 'webp']} fallbackFormat="webp"
          widths={widths}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          class="media-img"
          style={`object-position:${position}`}
        />
      </div>
      <span class="tint" aria-hidden="true"></span>
      <span class="scrim" aria-hidden="true"></span>
    </div>

    <nav aria-label={lang === 'it' ? 'Percorso' : 'Brotkrumen'} class="crumbs wrap ph-in">
      <ol class="flex items-center gap-2 text-sm">
        <li><a href={routes.home[lang]} class="link-u">{ui[lang].nav.home}</a></li>
        <li aria-hidden="true">/</li>
        <li><span aria-current="page">{label}</span></li>
      </ol>
    </nav>

    <div class="content wrap">
      <script type="application/ld+json" set:html={JSON.stringify(crumbsLd)} />

      <div class="grid-b">
        <div>
          <RoofLine tone="paper" class="roof-anim phero-roof" weight={1.5} draw={false} />
          <h1>
            {kicker && <span class="kicker t-label">{kicker}</span>}
            <span class="sr-only">{title.join(' ')}</span>
            <span class="title" aria-hidden="true">
              {lines.map((words) => (
                <span class="block">
                  {words.map((w, i) => {
                    const dot = w.endsWith('.');
                    const delay = 220 + n++ * 70;
                    return (
                      <Fragment>
                        <span class="w"><span style={`animation-delay:${delay}ms`}>{dot ? w.slice(0, -1) : w}{dot && <span class="dot">.</span>}</span></span>{i < words.length - 1 ? ' ' : ''}
                      </Fragment>
                    );
                  })}
                </span>
              ))}
            </span>
          </h1>
        </div>
        <div class="side ph-in" style="animation-delay:600ms">
          {lead && <p class="lead">{lead}</p>}
          {Astro.slots.has('actions') && <div class="actions"><slot name="actions" /></div>}
        </div>
      </div>
      {caption && (
        <p class="caption t-label ph-in" style="animation-delay:800ms">
          <Icon name="pin" size={14} class="text-orange" /> {caption}
        </p>
      )}
    </div>
  </div>
</section>

<style>
@layer components {
  .phero { position: relative; margin-top: calc(var(--header-h) * -1); background: var(--color-night); color: var(--color-paper); }
  .stage { position: relative; display: flex; flex-direction: column; isolation: isolate; overflow: hidden; }

  /* Mobile: foto in alto, testo sotto */
  .media { position: relative; z-index: -1; aspect-ratio: 4 / 3.4; overflow: hidden; background: var(--color-night-2); }
  .media-inner { position: absolute; inset: 0; }
  .media :global(.media-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.85) contrast(1.05) brightness(0.9);
    transform: scale(1.05);
    animation: ph-zoom 2.8s var(--ease-out-expo) both;
  }
  @keyframes ph-zoom { from { transform: scale(1.14); } }
  .tint { position: absolute; inset: 0; background: var(--color-ink); mix-blend-mode: multiply; opacity: 0.38; }
  .scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, var(--color-night) 0%, color-mix(in oklab, var(--color-night) 40%, transparent) 38%, transparent 62%),
      linear-gradient(to bottom, color-mix(in oklab, var(--color-night) 60%, transparent) 0%, transparent 30%);
  }
  .content { position: relative; margin-top: -4.5rem; padding-bottom: 2.5rem; }
  .crumbs { position: absolute; left: 0; right: 0; top: calc(var(--header-h) + 0.9rem); z-index: 1; }

  /* Desktop: foto a tutto schermo */
  @media (min-width: 64rem) {
    .stage { min-height: max(38rem, calc(100svh - 6rem)); }
    .media { position: absolute; inset: 0; aspect-ratio: auto; }
    .scrim {
      background:
        linear-gradient(to top, color-mix(in oklab, var(--color-night) 95%, transparent) 0%, color-mix(in oklab, var(--color-night) 55%, transparent) 36%, transparent 64%),
        linear-gradient(to right, color-mix(in oklab, var(--color-night) 65%, transparent) 0%, transparent 55%),
        linear-gradient(to bottom, color-mix(in oklab, var(--color-night) 55%, transparent) 0%, transparent 22%);
    }
    .content { flex: 1; display: flex; flex-direction: column; margin-top: 0; padding-top: calc(var(--header-h) + 4rem); padding-bottom: 3rem; }
    .crumbs { top: calc(var(--header-h) + 1.5rem); }
  }

  /* Breadcrumb e didascalia in "pillole" scure: leggibili su qualsiasi zona della foto */
  .crumbs ol, .caption {
    display: inline-flex;
    width: max-content;
    max-width: 100%;
    padding: 0.35rem 0.85rem;
    border: 1px solid color-mix(in oklab, var(--color-paper) 24%, transparent);
    border-radius: 999px;
    background: color-mix(in oklab, var(--color-night) 62%, transparent);
    color: color-mix(in oklab, var(--color-paper) 80%, transparent);
  }
  .crumbs [aria-current] { color: var(--color-paper); }

  .grid-b { display: grid; gap: 1.75rem; margin-top: auto; }
  @media (min-width: 64rem) { .grid-b { grid-template-columns: minmax(0, 1fr) 24rem; column-gap: 4rem; align-items: end; padding-top: 3rem; } }

  .phero :global(.phero-roof) { display: block; width: min(100%, 46rem); height: clamp(2.25rem, 6vw, 5rem); margin-bottom: clamp(0.75rem, 1.5vw, 1.25rem); }
  .title {
    display: block;
    font-family: var(--font-wide);
    font-stretch: 125%;
    font-weight: 650;
    font-size: clamp(2.5rem, 6.8vw, 6.25rem);
    line-height: 0.95;
    letter-spacing: -0.045em;
  }
  .title .dot { color: var(--color-orange); }
  .kicker { display: block; margin-bottom: 1rem; color: var(--color-steel); }
  .w { display: inline-block; overflow: hidden; vertical-align: top; padding-bottom: 0.1em; margin-bottom: -0.1em; }
  .w > span { display: inline-block; animation: ph-word 1.1s var(--ease-out-expo) both; }
  @keyframes ph-word { from { transform: translateY(110%); } }

  .lead { font-size: clamp(1.0625rem, 1.3vw, 1.2rem); line-height: 1.55; color: color-mix(in oklab, var(--color-paper) 88%, transparent); }
  .actions { display: flex; flex-direction: column; gap: 0.75rem; margin-top: 1.5rem; }
  @media (min-width: 40rem) and (max-width: 63.99rem) { .actions { flex-direction: row; } }
  @media (min-width: 64rem) { .side { padding-left: 1.75rem; border-left: 1px solid var(--line-dark); } }

  .caption { align-items: center; gap: 0.5rem; margin-top: 2rem; }
  /* Su mobile la didascalia è testo semplice (la pillola su due righe non sta bene) */
  @media (max-width: 63.99rem) {
    .caption { width: auto; padding: 0; border: 0; border-radius: 0; background: none; color: var(--color-steel-2); line-height: 1.5; }
  }
  @media (min-width: 64rem) { .caption { position: absolute; right: var(--gutter); top: calc(var(--header-h) + 1.75rem); margin: 0; } }

  .ph-in { animation: ph-slide 1s var(--ease-out-expo) both; }
  @keyframes ph-slide { from { transform: translateY(16px); } }
}
</style>
