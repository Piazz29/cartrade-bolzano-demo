---
// Pagina di un servizio (Officina, Carrozzeria, Gomme): stessa struttura, testi diversi.
// Ogni pagina punta a una ricerca precisa ("officina Bolzano", "carrozzeria Bolzano", "cambio gomme Bolzano")
// in tre lingue: titolo, H1, descrizione, schema.org Service + FAQPage, collegamenti agli altri servizi.
// Sezioni: 01 servizi · 02 guida pratica (risposte brevi e verificabili, utili anche ai motori AI) ·
// 03 preventivo · 04 domande frequenti · 05 stessa sede e zona servita.
import Base from '../layouts/Base.astro';
import PageHero from './PageHero.astro';
import Photo from './Photo.astro';
import Icon from './Icon.astro';
import SectionHead from './SectionHead.astro';
import RequestForm from './RequestForm.astro';
import Faq from './Faq.astro';
import { site, formatPrice, areaTowns, areaName, type Lang } from '../data/site';
import { routes, alternatesFor, serviceKeys, type RouteKey } from '../i18n/routes';
import { ui } from '../i18n/ui';
import type { FotoKey } from '../data/foto';

type Item = { t: string; d: string };
export interface ServiceCopy {
  title: string;
  description: string;
  label: string;
  kicker: string;
  h1: string;
  lead: string;
  heroFoto: FotoKey;
  heroAlt: string;
  /** nome del servizio per schema.org (es. "Carrozzeria") */
  serviceType: string;
  listId: string;
  listLabel: string;
  listTitle: string;
  listIntro: string;
  items: Item[];
  photos: { foto: FotoKey; alt: string }[];
  layout: 'side' | 'wide';
  guide?: { label: string; title: string; intro: string; facts?: { k: string; v: string; note: string }[]; items: Item[]; note?: string };
  quote: { label: string; title: string; text: string; steps: string[]; or: string; wa: string };
  topic: string;
  faqLabel: string;
  faq: { q: string; a: string }[];
}

interface Props { lang: Lang; page: RouteKey; copy: ServiceCopy }
const { lang, page, copy } = Astro.props;
const t = ui[lang];
const siteUrl = Astro.site!.toString().replace(/\/$/, '');
const pageUrl = `${siteUrl}${routes[page][lang]}`;

// Collegamenti agli altri servizi della stessa sede
const BLURB: Record<Lang, Record<(typeof serviceKeys)[number], string>> = {
  it: {
    revisione: `Centro revisioni affiliato DEKRA. ${formatPrice(site.revisionFee.total, 'it')} tutto compreso, prenotazione online.`,
    officina: 'Tagliandi, freni, distribuzione, diagnosi elettronica. Tutte le marche.',
    carrozzeria: 'Ammaccature, graffi, raddrizzatura e verniciatura. Preventivo da foto.',
    gomme: 'Cambio gomme estive e invernali. In Alto Adige l’obbligo va dal 15 novembre al 15 aprile.',
  },
  de: {
    revisione: `DEKRA-Partner für die Revision. ${formatPrice(site.revisionFee.total, 'de')} inklusive allem, online buchen.`,
    officina: 'Inspektion, Bremsen, Zahnriemen, elektronische Diagnose. Alle Marken.',
    carrozzeria: 'Dellen, Kratzer, Richtarbeiten und Lackierung. Angebot per Foto.',
    gomme: 'Sommer- und Winterreifen wechseln. In Südtirol gilt die Pflicht vom 15. November bis 15. April.',
  },
  en: {
    revisione: `DEKRA-affiliated inspection centre. ${formatPrice(site.revisionFee.total, 'en')} all inclusive, online booking.`,
    officina: 'Servicing, brakes, timing belt, electronic diagnostics. All makes.',
    carrozzeria: 'Dents, scratches, panel straightening and painting. Quotes from photos.',
    gomme: 'Summer and winter tyre change. In South Tyrol winter tyres are required from 15 November to 15 April.',
  },
};
const NEAR: Record<Lang, { label: string; title: string; area: string; areaText: (towns: string) => string; contact: string }> = {
  it: {
    label: 'Nella stessa sede',
    title: 'Revisione, officina, carrozzeria e gomme a un solo indirizzo.',
    area: 'Zona servita',
    areaText: (towns) => `${site.address.street.it}, zona produttiva di Bolzano Sud. Comodo da tutta Bolzano e dai comuni vicini: ${towns}.`,
    contact: 'Contatti e orari',
  },
  de: {
    label: 'Am selben Standort',
    title: 'Revision, Werkstatt, Karosserie und Reifen an einer Adresse.',
    area: 'Einzugsgebiet',
    areaText: (towns) => `${site.address.street.de}, Gewerbegebiet Bozen Süd. Gut erreichbar aus ganz Bozen und den Nachbargemeinden: ${towns}.`,
    contact: 'Kontakt und Öffnungszeiten',
  },
  en: {
    label: 'At the same address',
    title: 'Inspection, workshop, body shop and tyres at one address.',
    area: 'Area served',
    areaText: (towns) => `${site.address.street.en}, Bolzano South business park. Easy to reach from all of Bolzano and nearby towns: ${towns}.`,
    contact: 'Contact and opening hours',
  },
};
const near = NEAR[lang];
const others = serviceKeys.filter((k) => k !== page);
const towns = areaTowns(lang).slice(1).join(', ');

const n = (i: number) => String(i).padStart(2, '0');
let sec = 0;
const num = () => n(++sec);

// schema.org: il servizio con il catalogo delle singole prestazioni, collegato all'attività (#business)
const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${pageUrl}#service`,
  name: copy.title,
  serviceType: copy.serviceType,
  description: copy.description,
  url: pageUrl,
  inLanguage: lang,
  provider: { '@id': `${siteUrl}/#business` },
  areaServed: site.area.map((a) => ({ '@type': a.type, name: areaName(a, lang) })),
  availableChannel: {
    '@type': 'ServiceChannel',
    serviceUrl: pageUrl,
    servicePhone: { '@type': 'ContactPoint', telephone: site.phone.e164 },
    serviceLocation: { '@id': `${siteUrl}/#business` },
  },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: copy.listTitle,
    itemListElement: copy.items.map((it) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: it.t, description: it.d },
    })),
  },
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${pageUrl}#faq`,
  mainEntity: copy.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const [mainPhoto, ...morePhotos] = copy.photos;
---
<Base lang={lang} title={copy.title} description={copy.description} alternates={alternatesFor(page)} current={page} jsonLd={[serviceLd, faqLd]}>
  <PageHero lang={lang} label={copy.label} kicker={copy.kicker} title={copy.h1} lead={copy.lead}>
    <Fragment slot="actions">
      <a href="#preventivo" class="btn btn-primary">{t.cta.quote} <Icon name="arrow" size={18} class="btn-arrow rotate-90" /></a>
      <a href={site.phone.href} class="btn btn-ghost t-num"><Icon name="phone" size={18} /> {site.phone.display}</a>
    </Fragment>
    <div slot="aside" class="relative overflow-hidden">
      <Photo foto={copy.heroFoto} alt={copy.heroAlt} sizes="(min-width: 64rem) 36vw, 100vw" ratio={[4, 3]} widths={[480, 768, 1080]} priority />
    </div>
  </PageHero>

  <!-- Servizi -->
  <section class:list={['section-y', copy.layout === 'wide' && 'bg-paper-2']} id={copy.listId} aria-labelledby="list-title">
    <div class="wrap">
      <SectionHead num={num()} label={copy.listLabel} />
      <div class="grid-12 mt-8 gap-y-8 lg:mt-12">
        <h2 id="list-title" class="chapter col-span-4 lg:col-span-8" data-reveal>{copy.listTitle}</h2>
        <p class="col-span-4 max-w-[46ch] text-muted lg:col-span-4 lg:self-end" data-reveal>{copy.listIntro}</p>
      </div>
      {copy.layout === 'side' ? (
        <div class="grid-12 mt-12 gap-y-10 lg:mt-16">
          <div class="col-span-4 lg:col-span-5">
            <div class="grid gap-[var(--gutter)] lg:sticky lg:top-28">
              {mainPhoto && <Photo foto={mainPhoto.foto} alt={mainPhoto.alt} sizes="(min-width: 64rem) 36vw, 100vw" ratio={[4, 3]} widths={[480, 768, 1080]} />}
              {morePhotos.map((p) => <Photo foto={p.foto} alt={p.alt} sizes="(min-width: 64rem) 36vw, 100vw" ratio={[16, 9]} widths={[480, 768, 1080]} class="hidden lg:block" />)}
            </div>
          </div>
          <ol class="svc col-span-4 lg:col-span-7" data-stagger="70">
            {copy.items.map((s, i) => (
              <li data-reveal>
                <span class="t-label t-num text-orange-ink">{n(i + 1)}</span>
                <h3 class="t-h3">{s.t}</h3>
                <p class="text-muted">{s.d}</p>
              </li>
            ))}
          </ol>
        </div>
      ) : (
        <Fragment>
          <div class="wide-photos mt-12 lg:mt-16">
            {mainPhoto && (
              <div class="relative overflow-hidden">
                <div data-parallax="8">
                  <Photo foto={mainPhoto.foto} alt={mainPhoto.alt} sizes="(min-width: 64rem) 62vw, 100vw" widths={[480, 640, 960, 1440]} fluid class="aspect-[16/10] w-full scale-[1.08]" />
                </div>
              </div>
            )}
            {morePhotos[0] && (
              <div class="hidden lg:block">
                <Photo foto={morePhotos[0].foto} alt={morePhotos[0].alt} sizes="30vw" ratio={[4, 5]} widths={[480, 768]} />
              </div>
            )}
          </div>
          <ol class="svc svc-cols mt-12 lg:mt-16" data-stagger="70">
            {copy.items.map((s, i) => (
              <li data-reveal>
                <span class="t-label t-num text-orange-ink">{n(i + 1)}</span>
                <h3 class="t-h3">{s.t}</h3>
                <p class="text-muted">{s.d}</p>
              </li>
            ))}
          </ol>
        </Fragment>
      )}
    </div>
  </section>

  <!-- Guida pratica: risposte brevi, numeri e date verificabili -->
  {copy.guide && (
    <section class:list={['section-y', copy.layout === 'side' && 'bg-paper-2']} aria-labelledby="guide-title">
      <div class="wrap">
        <SectionHead num={num()} label={copy.guide.label} />
        <div class="grid-12 mt-8 gap-y-6 lg:mt-12">
          <h2 id="guide-title" class="t-h2 col-span-4 max-w-[20ch] lg:col-span-7" data-reveal>{copy.guide.title}</h2>
          <p class="col-span-4 max-w-[46ch] text-muted lg:col-span-5 lg:self-end" data-reveal>{copy.guide.intro}</p>
        </div>
        {copy.guide.facts && (
          <dl class="facts t-num mt-10 lg:mt-14" data-reveal>
            {copy.guide.facts.map((f) => (
              <div>
                <dt class="t-label">{f.k}</dt>
                <dd class="facts-val">{f.v}</dd>
                <dd class="facts-note">{f.note}</dd>
              </div>
            ))}
          </dl>
        )}
        <div class="guide mt-10 lg:mt-14" data-stagger="70">
          {copy.guide.items.map((g, i) => (
            <article data-reveal>
              <span class="t-label t-num text-orange-ink">{n(i + 1)}</span>
              <h3 class="t-h3 mt-3">{g.t}</h3>
              <p class="mt-3 text-muted">{g.d}</p>
            </article>
          ))}
        </div>
        {copy.guide.note && <p class="mt-10 max-w-[70ch] text-sm text-muted">{copy.guide.note}</p>}
      </div>
    </section>
  )}

  <!-- Preventivo -->
  <section class="on-dark section-y bg-night text-paper" id="preventivo" aria-labelledby="q-title">
    <div class="wrap">
      <SectionHead num={num()} label={copy.quote.label} dark />
      <div class="grid-12 mt-8 gap-y-12 lg:mt-12">
        <div class="col-span-4 lg:col-span-5">
          <div class="lg:sticky lg:top-28">
            <h2 id="q-title" class="t-h2 max-w-[16ch]">{copy.quote.title}</h2>
            <p class="mt-5 max-w-[42ch] text-steel">{copy.quote.text}</p>
            <ol class="q-steps mt-8">
              {copy.quote.steps.map((s, i) => (
                <li><span class="t-label t-num text-orange">{n(i + 1)}</span><span>{s}</span></li>
              ))}
            </ol>
            <div class="mt-10 hidden lg:block">
              <p class="t-label text-steel-2">{copy.quote.or}</p>
              <div class="mt-3 flex flex-wrap gap-3">
                <a href={site.phone.href} class="btn btn-ghost t-num"><Icon name="phone" size={18} /> {site.phone.display}</a>
                <a href={site.whatsapp.href(copy.quote.wa)} class="btn btn-ghost" target="_blank" rel="noopener"><Icon name="whatsapp" size={19} /> WhatsApp</a>
              </div>
            </div>
          </div>
        </div>
        <div class="col-span-4 lg:col-span-6 lg:col-start-7">
          <RequestForm lang={lang} variant="quote" id="quote" topic={copy.topic} />
        </div>
      </div>
    </div>
  </section>

  <!-- Domande frequenti -->
  <section class="section-y" aria-labelledby="faq-title">
    <div class="wrap grid-12 gap-y-10">
      <div class="col-span-4 lg:col-span-4">
        <SectionHead num={num()} label={copy.faqLabel} />
        <h2 id="faq-title" class="sr-only">{copy.faqLabel}</h2>
      </div>
      <div class="col-span-4 lg:col-span-8">
        <Faq items={copy.faq} />
      </div>
    </div>
  </section>

  <!-- Stessa sede: collegamenti agli altri servizi e zona servita -->
  <section class="section-y bg-paper-2" aria-labelledby="near-title">
    <div class="wrap">
      <SectionHead num={num()} label={near.label} />
      <h2 id="near-title" class="t-h2 mt-8 max-w-[24ch] lg:mt-12" data-reveal>{near.title}</h2>
      <ul class="near mt-10 lg:mt-14" data-stagger="70">
        {others.map((k) => (
          <li data-reveal>
            <a href={routes[k][lang]} class="near-link group">
              <span class="t-h3">{t.nav[k]}</span>
              <span class="mt-2 block text-muted">{BLURB[lang][k]}</span>
              <span class="near-arrow" aria-hidden="true"><Icon name="arrow" size={22} /></span>
            </a>
          </li>
        ))}
      </ul>
      <div class="mt-12 grid-12 gap-y-4 border-t border-[var(--line-strong)] pt-8 lg:mt-16">
        <p class="t-label col-span-4 lg:col-span-3">{near.area}</p>
        <p class="col-span-4 max-w-[62ch] text-muted lg:col-span-7">{near.areaText(towns)}</p>
        <p class="col-span-4 lg:col-span-2 lg:text-right"><a href={routes.contatti[lang]} class="link-u font-semibold">{near.contact} →</a></p>
      </div>
    </div>
  </section>
</Base>

<style>
@layer components {
  .chapter {
    font-stretch: 125%;
    font-weight: 650;
    font-size: clamp(2.6rem, 7.4vw, 7.5rem);
    line-height: 0.88;
    letter-spacing: -0.045em;
  }
  .svc { border-top: 1px solid var(--line-strong); }
  .svc li {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    column-gap: 0.75rem;
    row-gap: 0.4rem;
    padding-block: 1.35rem;
    border-bottom: 1px solid var(--line);
  }
  .svc li > :not(:first-child) { grid-column: 2; }
  .svc li > :first-child { grid-row: span 2; padding-top: 0.3rem; }
  @media (min-width: 64rem) {
    .svc li { grid-template-columns: 3rem minmax(0, 0.9fr) minmax(0, 1.1fr); column-gap: 1.5rem; padding-block: 1.6rem; align-items: baseline; }
    .svc li > :not(:first-child) { grid-column: auto; }
    .svc li > :first-child { grid-row: auto; padding-top: 0; }
    .svc-cols { display: grid; grid-template-columns: 1fr 1fr; column-gap: var(--gutter); border-top: 0; }
    .svc-cols li { grid-template-columns: 3rem 1fr; border-top: 1px solid var(--line-strong); border-bottom: 0; }
    .svc-cols li > :not(:first-child) { grid-column: 2; }
    .svc-cols li > :first-child { grid-row: span 2; }
  }
  .wide-photos { display: grid; gap: var(--gutter); }
  @media (min-width: 64rem) { .wide-photos { grid-template-columns: 2fr 1fr; align-items: end; } }

  /* Dati chiave in stile scheda tecnica */
  .facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: 1px solid var(--line-strong); }
  .facts > div { padding: 1.1rem 1rem 1.25rem 0; border-bottom: 1px solid var(--line); }
  .facts > div:nth-child(odd) { padding-right: 1rem; border-right: 1px solid var(--line); }
  .facts > div:nth-child(even) { padding-left: 1rem; }
  .facts dt { color: var(--color-muted); }
  .facts-val { margin-top: 0.5rem; font-size: clamp(1.35rem, 2.6vw, 2rem); font-weight: 650; font-stretch: 112%; letter-spacing: -0.02em; line-height: 1.05; }
  .facts-note { margin-top: 0.35rem; font-size: 0.875rem; color: var(--color-muted); }
  @media (min-width: 64rem) {
    .facts { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .facts > div, .facts > div:nth-child(odd), .facts > div:nth-child(even) { padding: 1.4rem 1.5rem 1.6rem; border-right: 1px solid var(--line); }
    .facts > div:first-child { padding-left: 0; }
    .facts > div:last-child { border-right: 0; }
  }

  .guide { display: grid; gap: 2rem var(--gutter); }
  .guide article { border-top: 1px solid var(--line-strong); padding-top: 1.25rem; }
  @media (min-width: 48rem) { .guide { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 64rem) { .guide { grid-template-columns: repeat(3, minmax(0, 1fr)); } }

  .q-steps { border-top: 1px solid var(--line-dark); }
  .q-steps li { display: grid; grid-template-columns: 2.5rem 1fr; padding-block: 0.9rem; border-bottom: 1px solid var(--line-dark); }

  .near { display: grid; border-top: 1px solid var(--line-strong); }
  @media (min-width: 64rem) { .near { grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 0; column-gap: var(--gutter); } }
  .near li { border-bottom: 1px solid var(--line); }
  @media (min-width: 64rem) { .near li { border-top: 1px solid var(--line-strong); border-bottom: 0; } }
  .near-link { position: relative; display: block; padding: 1.4rem 3rem 1.5rem 0; }
  .near-link:hover .t-h3 { color: var(--color-orange-ink); }
  .near-arrow { position: absolute; right: 0.25rem; top: 1.5rem; transition: transform 0.4s var(--ease-out-expo); }
  .near-link:hover .near-arrow { transform: translateX(4px); }
}
</style>
