---
// Icone a tratto sottile disegnate per il sito (tracciati in src/lib/icons.ts).
import { ICONS, type IconName } from '../lib/icons';
interface Props {
  name: IconName;
  size?: number;
  class?: string;
}
const { name, size = 20, class: cls } = Astro.props;
---
<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  class={cls}
  set:html={ICONS[name]}
/>
