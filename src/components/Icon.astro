---
// Icone a tratto sottile disegnate per il sito (niente set generici).
interface Props {
  name: 'phone' | 'whatsapp' | 'arrow' | 'arrow-up-right' | 'calendar' | 'check' | 'x' | 'menu' | 'pin' | 'clock' | 'upload' | 'bell' | 'mail' | 'filter' | 'chevron' | 'download' | 'star';
  size?: number;
  class?: string;
}
const { name, size = 20, class: cls } = Astro.props;
---
<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  class={cls}
>
  {name === 'phone' && <path d="M5 3.5h3.2l1.6 4.2-2.1 1.4a11 11 0 0 0 7.2 7.2l1.4-2.1 4.2 1.6V19a1.5 1.5 0 0 1-1.6 1.5A16.5 16.5 0 0 1 3.5 5.1 1.5 1.5 0 0 1 5 3.5Z" />}
  {name === 'whatsapp' && (
    <>
      <path d="M4.2 19.8l1.1-3.9A8.4 8.4 0 1 1 8.4 19l-4.2.8Z" />
      <path d="M9.2 8.4c.2-.5.5-.5.8-.5h.5c.2 0 .4.1.5.4l.7 1.6c.1.2 0 .4-.1.6l-.5.6c-.1.1-.1.3 0 .5a6 6 0 0 0 2.6 2.4c.2.1.3.1.5 0l.6-.7c.2-.2.4-.2.6-.1l1.6.8c.2.1.3.3.3.5 0 .9-.6 1.8-1.6 1.9-1 .1-2.6-.3-4.4-1.9-1.6-1.5-2.3-3-2.3-4 0-.9.5-1.5.7-1.7Z" fill="currentColor" stroke="none" />
    </>
  )}
  {name === 'arrow' && <path d="M4 12h15m-5.5-6 6 6-6 6" />}
  {name === 'arrow-up-right' && <path d="M7 17 17 7m-8.5 0H17v8.5" />}
  {name === 'calendar' && <path d="M4 7.5A1.5 1.5 0 0 1 5.5 6h13A1.5 1.5 0 0 1 20 7.5v11a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 18.5v-11ZM4 10.5h16M8.5 3.5v4M15.5 3.5v4" />}
  {name === 'check' && <path d="m5 12.5 4.5 4.5L19 7.5" />}
  {name === 'x' && <path d="M6 6l12 12M18 6 6 18" />}
  {name === 'menu' && <path d="M3.5 8h17M3.5 16h17" />}
  {name === 'pin' && <path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Zm0-8.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z" />}
  {name === 'clock' && <path d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Zm0-13.5V12l3 2" />}
  {name === 'upload' && <path d="M12 15.5V4m-4.5 4.5L12 4l4.5 4.5M4.5 15v3.5A1.5 1.5 0 0 0 6 20h12a1.5 1.5 0 0 0 1.5-1.5V15" />}
  {name === 'bell' && <path d="M6 16.5V11a6 6 0 1 1 12 0v5.5l1.5 1.5h-15L6 16.5Zm4 3.5a2 2 0 0 0 4 0" />}
  {name === 'mail' && <path d="M3.5 6.5h17v11h-17v-11Zm0 0 8.5 6.5 8.5-6.5" />}
  {name === 'filter' && <path d="M4 7h10m4 0h2M4 17h2m4 0h10M14 4.5v5M8 14.5v5" />}
  {name === 'chevron' && <path d="m6 9.5 6 6 6-6" />}
  {name === 'download' && <path d="M12 4v11.5m-4.5-4.5L12 15.5l4.5-4.5M4.5 20h15" />}
  {name === 'star' && <path d="m12 3.8 2.5 5.2 5.6.7-4.1 3.9 1 5.6L12 16.5l-5 2.7 1-5.6-4.1-3.9 5.6-.7L12 3.8Z" fill="currentColor" stroke="none" />}
</svg>
