---
import { site, type Lang } from '../data/site';
import { ui } from '../i18n/ui';
interface Props { lang: Lang; class?: string }
const { lang, class: cls } = Astro.props;
const t = ui[lang].hours;
const fmt = (h: { open: string; close: string }) => `${h.open} – ${h.close}`;
const slots = site.hours.filter((h) => h.days.includes(1)).map(fmt);
const sat = site.hours.filter((h) => h.days.includes(6)).map(fmt);
---
<dl class:list={['spec', cls]}>
  <div>
    <dt>{t.weekdays}</dt>
    <dd class="grid gap-0.5">{slots.map((s) => <span>{s}</span>)}</dd>
  </div>
  <div>
    <dt>{t.saturday}</dt>
    <dd class="grid gap-0.5">{sat.length ? sat.map((s) => <span>{s}</span>) : t.closed}</dd>
  </div>
  <div>
    <dt>{t.sunday}</dt>
    <dd>{t.closed}</dd>
  </div>
</dl>
