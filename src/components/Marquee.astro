---
// Fascia "Tutte le marche": loghi auto monocromatici che scorrono, in scala di grigi.
// Loghi da Simple Icons (CC0), raccolti in uno sprite esterno (public/brands/sprite.svg, in cache dopo il primo caricamento).
// Rigenerare lo sprite: npm run brands (elenco marchi in scripts/build-brand-sprite.mjs).
// I loghi sono marchi dei rispettivi proprietari: indicano le marche su cui si lavora, non una concessione ufficiale.
// TODO: confermare con il cliente l'elenco delle marche e che vada bene mostrarne i loghi.
// Scorre in CSS; con "riduci movimento" più lenta. Pulsante pausa/riprendi (WCAG 2.2.2: movimento automatico oltre 5 s).
import type { Lang } from '../data/site';
import brands from '../data/brands.json';
interface Props { lang: Lang }
const { lang } = Astro.props;
const copy = {
  it: { label: 'Tutte le marche', note: 'Revisione, officina e carrozzeria per ogni marca.', pause: 'Ferma lo scorrimento dei loghi', play: 'Riprendi lo scorrimento dei loghi' },
  de: { label: 'Alle Marken', note: 'Revision, Werkstatt und Karosserie für jede Marke.', pause: 'Logo-Laufband anhalten', play: 'Logo-Laufband fortsetzen' },
}[lang];
// Correzione ottica: i loghi larghi e bassi vengono ingranditi per pesare come quelli tondi
const optical: Record<string, number> = { audi: 1.55, ford: 1.5, kia: 1.55, dacia: 1.5, mini: 1.5, jeep: 1.35, opel: 1.25, hyundai: 1.2, toyota: 1.12, volvo: 1.05 };
---
<section class="brands" aria-label={copy.label} data-brands>
  <div class="head">
    <div class="head-text">
      <p class="t-label">{copy.label}</p>
      <p class="note">{copy.note}</p>
    </div>
    <button type="button" class="mq-toggle" aria-pressed="false" aria-label={copy.pause} data-label-pause={copy.pause} data-label-play={copy.play} data-mq-toggle>
      <svg class="i-pause" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><rect x="3" y="2" width="2.5" height="10" fill="currentColor"/><rect x="8.5" y="2" width="2.5" height="10" fill="currentColor"/></svg>
      <svg class="i-play" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M4 2.2v9.6a.5.5 0 0 0 .76.43l7.6-4.8a.5.5 0 0 0 0-.86l-7.6-4.8A.5.5 0 0 0 4 2.2Z" fill="currentColor"/></svg>
    </button>
  </div>
  <div class="mq" aria-hidden="true">
    <div class="mq-track">
      {[0, 1].map(() => (
        <ul class="mq-group">
          {brands.map((b) => (
            <li class="logo" style={`--s:${optical[b.slug] ?? 1}`}>
              <svg viewBox="0 0 24 24" focusable="false"><use href={`/brands/sprite.svg#${b.slug}`} /></svg>
            </li>
          ))}
        </ul>
      ))}
    </div>
  </div>
  <p class="sr-only">{copy.label}: {brands.map((b) => b.title).join(', ')}.</p>
</section>

<style>
@layer components {
  .brands {
    display: grid;
    border-block: 1px solid var(--line);
    background: var(--color-paper);
  }
  .head { padding: 1.25rem var(--gutter) 0; display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .head-text { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.25rem 0.75rem; }
  .head .t-label { color: var(--color-ink); }
  .note { font-size: 0.875rem; color: var(--color-muted); }
  @media (min-width: 64rem) {
    .brands { grid-template-columns: 17rem minmax(0, 1fr); align-items: center; }
    .head { padding: 0 1.25rem 0 var(--gutter); border-right: 1px solid var(--line); align-self: stretch; }
    .head-text { flex-direction: column; align-items: flex-start; gap: 0.4rem; }
    .note { max-width: 24ch; }
  }
  @media (min-width: 90rem) { .head { padding-left: calc((100vw - 90rem) / 2 + var(--gutter)); } .brands { grid-template-columns: calc((100vw - 90rem) / 2 + 17rem) minmax(0, 1fr); } }

  .mq {
    overflow: hidden;
    padding-block: clamp(1.25rem, 2.6vw, 2rem);
    -webkit-mask-image: linear-gradient(to right, transparent, #000 7%, #000 93%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 7%, #000 93%, transparent);
  }
  .mq-track { display: flex; width: max-content; animation: mq 48s linear infinite; will-change: transform; }
  .mq-group { display: flex; align-items: center; gap: clamp(2.25rem, 5vw, 4.5rem); padding-right: clamp(2.25rem, 5vw, 4.5rem); }
  .logo { display: grid; place-items: center; flex: none; width: calc(clamp(2.5rem, 4.2vw, 3.5rem) * var(--s)); height: clamp(2.5rem, 4.2vw, 3.5rem); }
  .logo svg { width: 100%; height: calc(100% * var(--s)); fill: color-mix(in oklab, var(--color-ink) 72%, transparent); overflow: visible; }
  @keyframes mq { to { transform: translateX(-50%); } }
  /* "Riduci movimento": scorre comunque, molto più lento (le regole vincono sull'azzeramento globale) */
  @media (prefers-reduced-motion: reduce) {
    .mq-track { animation-duration: 140s !important; animation-iteration-count: infinite !important; }
  }
  .brands.is-paused .mq-track { animation-play-state: paused !important; }

  .mq-toggle {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--line-strong);
    border-radius: 2px;
    color: var(--color-ink);
    transition: background-color 0.2s, color 0.2s, border-color 0.2s;
  }
  .mq-toggle:hover { background: var(--color-ink); color: var(--color-paper); border-color: var(--color-ink); }
  .mq-toggle .i-play, .mq-toggle[aria-pressed='true'] .i-pause { display: none; }
  .mq-toggle[aria-pressed='true'] .i-play { display: block; }

}
</style>

<!-- Inline: 6 righe, una richiesta di rete in meno sulla Home -->
<script is:inline>
  document.querySelectorAll('[data-brands]').forEach(function (root) {
    var btn = root.querySelector('[data-mq-toggle]');
    btn.addEventListener('click', function () {
      var paused = root.classList.toggle('is-paused');
      btn.setAttribute('aria-pressed', String(paused));
      btn.setAttribute('aria-label', paused ? btn.dataset.labelPlay : btn.dataset.labelPause);
    });
  });
</script>
