---
import { site, type Lang } from '../data/site';
import { routes, navOrder } from '../i18n/routes';
import { ui } from '../i18n/ui';
import Logo from './Logo.astro';
import HoursTable from './HoursTable.astro';
import RoofLine from './RoofLine.astro';
import Icon from './Icon.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const year = new Date().getFullYear();
---
<footer class="on-dark border-t border-[var(--line-dark)] bg-night text-paper">
  <div class="wrap pt-16 pb-10 lg:pt-24">
    <div class="grid-12 gap-y-12">
      <div class="col-span-4 lg:col-span-5">
        <Logo inverse class="h-12 w-auto lg:h-14" alt={site.brand} />
        <p class="mt-6 max-w-[34ch] text-steel">{t.footer.tagline}</p>
        <p class="t-label mt-6 text-steel-2">{t.dekra}</p>
      </div>

      <div class="col-span-4 sm:col-span-2 lg:col-span-3">
        <h2 class="t-label text-steel-2">{({ it: 'Contatti', de: 'Kontakt', en: 'Contact' })[lang]}</h2>
        <ul class="mt-5 grid gap-3">
          <li>
            <a href={site.phone.href} class="inline-flex items-center gap-2 text-lg font-semibold t-num hover:text-orange">
              <Icon name="phone" size={18} /> {site.phone.display}
            </a>
          </li>
          <li>
            <a href={site.landline.href} class="inline-flex items-center gap-2 t-num hover:text-orange">
              <Icon name="phone" size={18} /> {site.landline.display}
            </a>
          </li>
          <li>
            <a href={site.whatsapp.href()} class="inline-flex items-center gap-2 hover:text-orange" target="_blank" rel="noopener">
              <Icon name="whatsapp" size={18} /> WhatsApp
            </a>
          </li>
          {site.email && (
            <li>
              <a href={`mailto:${site.email}`} class="inline-flex items-center gap-2 hover:text-orange">
                <Icon name="mail" size={18} /> {site.email}
              </a>
            </li>
          )}
          <li class="flex gap-2 text-steel">
            <Icon name="pin" size={18} class="mt-0.5 shrink-0" />
            <address class="not-italic">
              {site.address.street[lang]}<br />
              {site.address.postalCode} {site.address.city[lang]} ({site.address.region})
            </address>
          </li>
        </ul>
      </div>

      <div class="col-span-4 sm:col-span-2 lg:col-span-4">
        <h2 class="t-label text-steel-2">{t.hours.title}</h2>
        <HoursTable lang={lang} class="mt-2" />
      </div>
    </div>

    <RoofLine tone="paper" class="mt-16 h-10 w-full opacity-90 lg:h-16" weight={1.5} />

    <div class="mt-8 flex flex-col gap-6 border-t border-[var(--line-dark)] pt-8 lg:flex-row lg:items-center lg:justify-between">
      <nav aria-label={({ it: 'Pagine del sito', de: 'Seiten', en: 'Site pages' })[lang]}>
        <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
          {navOrder.map((key) => (
            <li><a href={routes[key][lang]} class="link-u">{t.nav[key]}</a></li>
          ))}
          {/* TODO: testi privacy e cookie del consulente del cliente (oggi pagina segnaposto) */}
          <li><a href={routes.privacy[lang]} class="link-u text-steel">{t.footer.legal}</a></li>
          <li><a href={`${routes.privacy[lang]}#cookie`} class="link-u text-steel">{t.footer.cookies}</a></li>
        </ul>
      </nav>
      <p class="text-sm text-steel-2 t-num">
        © {year} {site.name} · {t.vat} {site.vat}
      </p>
    </div>
  </div>
</footer>
