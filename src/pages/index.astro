---
// Radice del sito: manda alla lingua scelta in passato (selettore lingua), altrimenti alla prima lingua
// del browser tra italiano, tedesco e inglese; per tutte le altre lingue l'inglese.
// Senza JavaScript il meta refresh porta a /it/ (il pubblico principale è locale).
const site = Astro.site!.toString().replace(/\/$/, '');
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Car Trade Bolzano · Revisione, officina, carrozzeria</title>
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={`${site}/it/`} />
    <link rel="alternate" hreflang="it" href={`${site}/it/`} />
    <link rel="alternate" hreflang="de" href={`${site}/de/`} />
    <link rel="alternate" hreflang="en" href={`${site}/en/`} />
    <link rel="alternate" hreflang="x-default" href={`${site}/en/`} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      (function () {
        var ok = { it: 1, de: 1, en: 1 };
        var pick = null;
        try { var saved = localStorage.getItem('ct-lang'); if (ok[saved]) pick = saved; } catch (e) {}
        var prefs = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || ''];
        for (var i = 0; i < prefs.length && !pick; i++) {
          var code = String(prefs[i]).slice(0, 2).toLowerCase();
          if (ok[code]) pick = code;
        }
        try { sessionStorage.setItem('ct-entry', '1'); } catch (e) {}
        location.replace('/' + (pick || 'en') + '/');
      })();
    </script>
    <meta http-equiv="refresh" content="0; url=/it/" />
    <style>body{background:#F7F6F3;color:#0E2340;font-family:system-ui,sans-serif;display:grid;place-items:center;min-height:100vh;margin:0}}
</style>
  </head>
  <body>
    <p><a href="/it/">Italiano</a> · <a href="/de/" lang="de">Deutsch</a> · <a href="/en/" lang="en">English</a></p>
  </body>
</html>
