---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';
import { richiediLogin } from '../../lib/server/pagina';
import { MODELLI_CAMPAGNA, ETICHETTE_INTERESSI } from '../../lib/crm/campagne';
import { INTERESSI } from '../../lib/crm/types';

export const prerender = false;
const no = richiediLogin(Astro);
if (no) return no;
---
<AdminLayout title="Campagne" current="campagne">
  <div class="a-head">
    <div>
      <h1 class="a-h1">Campagne</h1>
      <p class="a-sub">Un messaggio di stagione a chi l’ha chiesto. Chi non ha dato il consenso alle offerte resta sempre fuori.</p>
    </div>
  </div>

  <div class="grid gap-x-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)]">
    <div>
      <section aria-labelledby="t-mod">
        <div class="a-sec-head"><h2 id="t-mod" class="a-h2">1 · Modello</h2></div>
        <fieldset>
          <legend class="sr-only">Scegli il modello</legend>
          <ul class="models">
            {MODELLI_CAMPAGNA.map((m, i) => (
              <li>
                <input type="radio" name="modello" id={`m-${m.id}`} value={m.id} checked={i === 0} />
                <label for={`m-${m.id}`}>
                  <span class="font-semibold">{m.titolo}</span>
                  <span class="text-sm text-muted">{m.periodo}</span>
                </label>
              </li>
            ))}
          </ul>
        </fieldset>
      </section>

      <section class="a-sec" aria-labelledby="t-pub">
        <div class="a-sec-head"><h2 id="t-pub" class="a-h2">2 · Pubblico</h2></div>
        <form class="aud" data-aud onsubmit="return false">
          <div class="field">
            <label for="a-int">Interesse</label>
            <select id="a-int" name="interesse" class="input">
              <option value="">Tutti</option>
              {INTERESSI.map((i) => <option value={i}>{ETICHETTE_INTERESSI[i].it}</option>)}
            </select>
          </div>
          <div class="field">
            <label for="a-lingua">Lingua</label>
            <select id="a-lingua" name="lingua" class="input">
              <option value="">Italiano e tedesco</option>
              <option value="it">Solo italiano</option>
              <option value="de">Solo tedesco</option>
            </select>
          </div>
          <div class="field">
            <label for="a-entro">Scadenza revisione</label>
            <select id="a-entro" name="entro" class="input">
              <option value="">Qualsiasi</option>
              <option value="30">Entro 30 giorni</option>
              <option value="60">Entro 60 giorni</option>
              <option value="90">Entro 90 giorni</option>
            </select>
          </div>
          <div class="field">
            <label for="a-canale">Canale preferito</label>
            <select id="a-canale" name="canale" class="input">
              <option value="">Tutti</option>
              <option value="email">Email</option>
              <option value="whatsapp">WhatsApp</option>
            </select>
          </div>
        </form>
        <p class="count" data-count aria-live="polite"></p>
        <p class="text-sm text-muted" data-split></p>
      </section>

      <section class="a-sec" aria-labelledby="t-send">
        <div class="a-sec-head"><h2 id="t-send" class="a-h2">3 · Invio</h2></div>
        <p class="text-sm text-muted">Ai clienti veri parte davvero (email, o WhatsApp se configurato). A quelli di esempio è simulato.</p>
        <div class="mt-4 flex flex-wrap gap-3">
          <button type="button" class="btn btn-primary" data-send><Icon name="send" size={18} /> <span data-send-label>Prepara l’invio</span></button>
          <button type="button" class="btn btn-ghost" data-cancel hidden>Annulla</button>
        </div>
      </section>
    </div>

    <section class="a-sec lg:mt-0" aria-labelledby="t-prev">
      <div class="a-sec-head"><h2 id="t-prev" class="a-h2">Anteprima</h2></div>
      <div class="flex flex-wrap gap-3" data-prev-ctrl>
        <div class="seg" role="radiogroup" aria-label="Lingua">
          <input type="radio" name="c-lang" id="c-it" value="it" checked /><label for="c-it">IT</label>
          <input type="radio" name="c-lang" id="c-de" value="de" /><label for="c-de">DE</label>
        </div>
        <div class="seg" role="radiogroup" aria-label="Canale">
          <input type="radio" name="c-ch" id="c-mail" value="email" checked /><label for="c-mail">Email</label>
          <input type="radio" name="c-ch" id="c-wa" value="whatsapp" /><label for="c-wa">WhatsApp</label>
        </div>
      </div>
      <p class="mt-3 text-sm" data-subject></p>
      <p class="mt-1 text-sm text-orange-ink" data-todo hidden></p>
      <iframe class="preview-frame mt-3" style="height:40rem" title="Anteprima dell’email della campagna" data-frame loading="lazy"></iframe>
      <div class="wa-chat mt-3" data-wa hidden><p class="wa-bubble" data-wa-text></p></div>
    </section>
  </div>

  <section class="a-sec" aria-labelledby="t-hist">
    <div class="a-sec-head"><h2 id="t-hist" class="a-h2">Storico</h2></div>
    <ul class="rows" data-hist></ul>
  </section>
</AdminLayout>

<style>
  .models { border-top: 1px solid var(--line); }
  .models li { position: relative; border-bottom: 1px solid var(--line); }
  .models input { position: absolute; opacity: 0; }
  .models label { display: grid; gap: 0.1rem; padding: 0.75rem 0.85rem 0.75rem 2.6rem; cursor: pointer; }
  .models label::before { content: ''; position: absolute; left: 0.75rem; top: 1rem; width: 1.1rem; height: 1.1rem; border: 1.5px solid var(--color-ink); border-radius: 999px; background: var(--color-paper); }
  .models input:checked + label { background: var(--color-paper-2); }
  .models input:checked + label::before { border-width: 5px; }
  .models input:focus-visible + label { outline: 2px solid var(--color-orange); outline-offset: -2px; }
  .aud { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.75rem; padding-top: 0.75rem; }
  .count { margin-top: 1rem; font-stretch: 112%; font-weight: 620; font-size: 1.125rem; }
  .count :global(b) { font-size: 1.5rem; font-variant-numeric: tabular-nums; }
</style>

<script>
  import { carica, inviaCampagna, ultimiDati, isVero, type Dati } from '../../admin/store';
  import { data, esc, occupato, scheletro, toast, vuoto } from '../../admin/ui';
  import { pubblicoCampagna, type Filtri } from '../../lib/crm/regole';
  import { campagna, testoWhatsApp } from '../../lib/crm/messaggi';
  import { modelloCampagna, MODELLI_CAMPAGNA } from '../../lib/crm/campagne';
  import { renderEmail } from '../../lib/email/render';
  import type { Cliente } from '../../lib/crm/types';

  const aud = document.querySelector<HTMLFormElement>('[data-aud]')!;
  const a = (n: string) => aud.elements.namedItem(n) as HTMLSelectElement;
  const sendBtn = document.querySelector<HTMLButtonElement>('[data-send]')!;
  // Il bottone si ridisegna durante l'invio: l'etichetta va cercata ogni volta
  const sendLabel = { set textContent(t: string) { sendBtn.querySelector<HTMLElement>('[data-send-label]')!.textContent = t; } };
  const cancel = document.querySelector<HTMLButtonElement>('[data-cancel]')!;
  const val = (n: string) => (document.querySelector(`input[name="${n}"]:checked`) as HTMLInputElement).value;
  let dati: Dati | null = null;
  let conferma = false;

  const filtri = (): Filtri => ({
    interesse: a('interesse').value as Filtri['interesse'],
    lingua: a('lingua').value as Filtri['lingua'],
    scadenzaEntro: Number(a('entro').value) as Filtri['scadenzaEntro'],
    canale: a('canale').value as Filtri['canale'],
  });

  // Il modello suggerisce il pubblico (es. gomme invernali → chi è interessato alle gomme)
  function applicaModello() {
    const m = modelloCampagna(val('modello'))!;
    a('interesse').value = m.filtri.interesse ?? '';
    a('lingua').value = '';
    a('entro').value = '';
    a('canale').value = '';
  }

  function resetConferma() {
    conferma = false;
    cancel.hidden = true;
    sendBtn.classList.replace('btn-ink', 'btn-primary');
    renderCount();
  }

  function renderCount() {
    if (!dati) return;
    const p = pubblicoCampagna(dati.clienti, filtri());
    const veri = p.destinatari.filter(isVero).length;
    const nuovi = p.destinatari.filter((c) => !c.esempio).length;
    document.querySelector('[data-count]')!.innerHTML = `<b>${p.destinatari.length}</b> clienti${p.esclusi ? `, ${p.esclusi} esclusi perché senza consenso alle offerte` : ''}`;
    document.querySelector('[data-split]')!.textContent = dati.live
      ? `${veri} ${veri === 1 ? 'cliente vero lo riceverà' : 'clienti veri lo riceveranno'} davvero, ${p.destinatari.length - veri} di esempio in simulazione.`
      : `${nuovi} ${nuovi === 1 ? 'iscritto vero' : 'iscritti veri'} e ${p.destinatari.length - nuovi} di esempio. Modalità simulata: nessun messaggio parte davvero.`;
    sendBtn.disabled = p.destinatari.length === 0;
    if (!conferma) sendLabel.textContent = p.destinatari.length ? `Prepara l’invio a ${p.destinatari.length}` : 'Nessun destinatario';
  }

  function renderPreview() {
    const m = modelloCampagna(val('modello'))!;
    const lang = val('c-lang') as 'it' | 'de';
    const c = { nome: lang === 'de' ? 'Andreas' : 'Anna', lingua: lang } as Pick<Cliente, 'nome' | 'lingua'>;
    const cont = campagna(m.id, c, location.origin);
    const mail = val('c-ch') === 'email';
    const frame = document.querySelector<HTMLIFrameElement>('[data-frame]')!;
    frame.hidden = !mail;
    document.querySelector<HTMLElement>('[data-wa]')!.hidden = mail;
    document.querySelector('[data-subject]')!.innerHTML = mail ? `<span class="text-muted">Oggetto:</span> <strong>${esc(cont.oggetto)}</strong>` : '<span class="text-muted">Messaggio WhatsApp</span>';
    const todo = document.querySelector<HTMLElement>('[data-todo]')!;
    todo.hidden = !m.todo;
    todo.textContent = m.todo ? `Da confermare: ${m.todo}` : '';
    if (mail) frame.srcdoc = renderEmail(cont, { baseUrl: location.origin });
    else document.querySelector('[data-wa-text]')!.innerHTML = `${esc(testoWhatsApp('campagna', { ...c, cognome: '', id: '', email: '', telefono: '', targa: '', scadenza: '2027-01-31' } as Cliente, location.origin, { modello: m.id }))}<small>09:00</small>`;
  }

  function renderHist() {
    if (!dati) return;
    const h = dati.eventi.filter((e) => e.tipo === 'campagna_invio');
    document.querySelector('[data-hist]')!.innerHTML = h.length
      ? h.map((e) => {
          const d = e.dettagli as Record<string, number | string>;
          const titolo = String(d.titolo ?? MODELLI_CAMPAGNA.find((m) => m.id === d.modello)?.titolo ?? 'Campagna');
          return `<li class="row"><span><span class="row-name">${esc(titolo)}</span><span class="row-meta">${esc(data(e.creato_il))} · ${Number(d.destinatari)} destinatari${Number(d.esclusi) ? ` · ${Number(d.esclusi)} esclusi senza consenso` : ''}</span></span>
            <span class="row-side">${Number(d.inviati) ? `<span class="tag tag-ok">${Number(d.inviati)} inviate</span> ` : ''}${Number(d.simulati) ? `<span class="tag tag-ex">${Number(d.simulati)} simulate</span>` : ''}${Number(d.errori) ? ` <span class="tag tag-err">${Number(d.errori)} non partite</span>` : ''}</span></li>`;
        }).join('')
      : `<li>${vuoto('Nessuna campagna ancora.', '')}</li>`;
  }

  document.querySelectorAll('input[name="modello"]').forEach((r) =>
    r.addEventListener('change', () => {
      applicaModello();
      resetConferma();
      renderPreview();
    }),
  );
  aud.addEventListener('change', resetConferma);
  document.querySelector('[data-prev-ctrl]')!.addEventListener('change', renderPreview);
  cancel.addEventListener('click', resetConferma);

  // Invio in due passi, senza finestre modali: "Prepara" → "Conferma l'invio"
  sendBtn.addEventListener('click', async () => {
    if (!conferma) {
      conferma = true;
      cancel.hidden = false;
      sendBtn.classList.replace('btn-primary', 'btn-ink');
      const n = pubblicoCampagna(ultimiDati()?.clienti ?? [], filtri()).destinatari.length;
      sendLabel.textContent = `Conferma l’invio a ${n} clienti`;
      return;
    }
    const r = await occupato(sendBtn, 'Invio in corso…', () => inviaCampagna(val('modello'), filtri()));
    toast(r, 7000);
    dati = await carica();
    resetConferma();
    renderHist();
  });

  applicaModello();
  renderPreview();
  document.querySelector('[data-hist]')!.innerHTML = scheletro(2);
  carica().then((d) => {
    dati = d;
    renderCount();
    renderHist();
  });
</script>
