---
// Accesso all'admin con la password demo (ADMIN_DEMO_PASSWORD), verificata sul server.
import '../../styles/global.css';
import Icon from '../../components/Icon.astro';
import { config } from '../../lib/server/config';
import { sessioneValida } from '../../lib/server/security';

export const prerender = false;

const nextRaw = Astro.url.searchParams.get('next') ?? '/admin/';
// Solo percorsi interni all'admin: niente redirect verso altri siti
const next = /^\/admin\/[\w\-/?=&%.]*$/.test(nextRaw) && !nextRaw.startsWith('/admin/login') ? nextRaw : '/admin/';
if (sessioneValida(Astro.cookies)) return Astro.redirect(next, 302);
const configurata = Boolean(config.adminPassword);
---
<!doctype html>
<html lang="it" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#0A1A30" />
    <title>Accesso · Admin Car Trade</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="login on-dark">
    <main class="box">
      <img src="/brand/logo-inverse.svg" alt="Car Trade Bolzano" width="904" height="282" class="logo" />
      <h1 class="mt-10 font-wide text-[1.75rem] font-[640] leading-tight [font-stretch:118%]">Area clienti</h1>
      <p class="mt-2 text-steel">I tuoi clienti, i promemoria e le campagne. Il gestionale DEKRA resta com’è.</p>
      {configurata ? (
        <form class="mt-8 grid gap-4" data-login data-next={next} novalidate>
          <div class="field">
            <label for="pw">Password</label>
            <input id="pw" name="password" type="password" class="input" autocomplete="current-password" required aria-describedby="pw-err" />
            <p id="pw-err" class="field-error" role="alert" hidden></p>
          </div>
          <button type="submit" class="btn btn-primary w-full" data-submit>Entra <Icon name="arrow" size={18} class="btn-arrow" /></button>
        </form>
      ) : (
        <p class="mt-8 rounded-[2px] border border-[var(--line-dark)] p-4 text-sm text-steel">
          Accesso non configurato: imposta la variabile <code class="text-paper">ADMIN_DEMO_PASSWORD</code> su Vercel e rifai il deploy.
        </p>
      )}
      <p class="mt-10 text-xs text-steel-2">Area riservata. Demo del nuovo sito Car Trade Bolzano.</p>
    </main>
    <style>
      .login { min-height: 100svh; display: grid; place-items: center; padding: 1.5rem 1rem; background: var(--color-night); color: var(--color-paper); }
      .box { width: min(100%, 24rem); }
      .logo { height: 2.75rem; width: auto; }
    </style>
    <script>
      const form = document.querySelector<HTMLFormElement>('[data-login]');
      if (form) {
        const input = form.querySelector<HTMLInputElement>('input')!;
        const err = form.querySelector<HTMLElement>('#pw-err')!;
        const btn = form.querySelector<HTMLButtonElement>('[data-submit]')!;
        input.focus();
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          const show = (m: string) => {
            err.textContent = m;
            err.hidden = !m;
            input.setAttribute('aria-invalid', m ? 'true' : 'false');
          };
          if (!input.value) return show('Inserisci la password.');
          btn.disabled = true;
          btn.setAttribute('aria-busy', 'true');
          try {
            const res = await fetch('/api/admin/login', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ password: input.value }) });
            if (res.ok) return void location.assign(form.dataset.next!);
            show(res.status === 429 ? 'Troppi tentativi. Aspetta qualche minuto.' : res.status === 401 ? 'Password non corretta.' : 'Accesso non riuscito. Riprova.');
          } catch {
            show('Rete assente. Controlla la connessione e riprova.');
          }
          btn.disabled = false;
          btn.removeAttribute('aria-busy');
          input.select();
        });
      }
    </script>
  </body>
</html>
