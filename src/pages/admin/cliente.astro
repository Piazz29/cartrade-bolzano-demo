---
// Scheda cliente (/admin/cliente/?id=…). Disegnata nel browser: gli esempi esistono solo lì.
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';
import { richiediLogin } from '../../lib/server/pagina';

export const prerender = false;
const no = richiediLogin(Astro);
if (no) return no;
---
<AdminLayout title="Scheda cliente" current="clienti">
  <a href="/admin/clienti/" class="t-label link-u inline-flex items-center gap-2 text-muted"><Icon name="arrow" size={16} class="rotate-180" /> Clienti</a>
  <div data-scheda class="mt-4" aria-live="polite">
    <div class="skeleton" style="height:4rem"></div>
  </div>
</AdminLayout>

<style>
  [data-scheda] :global(.actions) { display: grid; gap: 0.6rem; margin-top: 1.25rem; }
  @media (min-width: 40rem) { [data-scheda] :global(.actions) { display: flex; flex-wrap: wrap; align-items: center; } }
  [data-scheda] :global(.wa) { display: flex; gap: 0.5rem; }
  [data-scheda] :global(.wa select) { flex: 1; min-width: 0; }
  [data-scheda] :global(.done-panel) { margin-top: 0.75rem; padding: 1rem; background: var(--color-paper-2); border: 1px solid var(--line); }
  [data-scheda] :global(.cols) { display: grid; gap: 0 2.5rem; }
  @media (min-width: 64rem) { [data-scheda] :global(.cols) { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); } }
  [data-scheda] :global(.spec dd a) { text-decoration: underline; text-underline-offset: 0.2em; }
  [data-scheda] :global(.tl li) { display: grid; grid-template-columns: 6.25rem minmax(0, 1fr); gap: 0.75rem; padding-block: 0.75rem; border-bottom: 1px solid var(--line); font-size: 0.9375rem; }
  [data-scheda] :global(.tl time) { color: var(--color-muted); font-size: 0.8125rem; font-variant-numeric: tabular-nums; }
  [data-scheda] :global(.big) { font-stretch: 118%; font-weight: 640; font-size: 1.5rem; letter-spacing: -0.015em; line-height: 1.1; }
</style>

<script>
  import { carica, inviaPromemoria, lavoroCompletato, recensioneOttenuta, regole, trova, whatsapp, type Dati } from '../../admin/store';
  import { canaleIcon, data, dataBreve, dataOra, descriviEvento, esc, giorni, interessi, occupato, origineTag, targa, telefono, toast, vuoto } from '../../admin/ui';
  import { promemoriaCliente } from '../../lib/crm/regole';
  import { isoDate } from '../../lib/revisione';
  import { nomeCompleto, type Cliente } from '../../lib/crm/types';
  import type { TipoMessaggio } from '../../lib/crm/messaggi';
  import { svg } from '../../lib/icons';

  const root = document.querySelector<HTMLElement>('[data-scheda]')!;
  const id = new URLSearchParams(location.search).get('id') ?? '';

  function render(d: Dati) {
    const c = trova(id);
    if (!c) {
      root.innerHTML = vuoto('Cliente non trovato.', ' Potrebbe essere stato cancellato con “Ripristina demo”.');
      return;
    }
    document.title = `${nomeCompleto(c)} · Admin Car Trade`;
    const s = giorni(c.scadenza);
    const ev = d.eventi.filter((e) => e.cliente_id === c.id);
    const richiesta = ev.some((e) => e.tipo === 'recensione_richiesta');
    const ottenuta = ev.some((e) => e.tipo === 'recensione_ottenuta');
    const prossimi = promemoriaCliente(c, regole(), d.eventi);
    const sino = (b: boolean) => (b ? '<span class="tag tag-ok">Sì</span>' : '<span class="tag tag-ex">No</span>');

    root.innerHTML = `
      <div class="flex flex-wrap items-center gap-2">${origineTag(c)}${c.origine === 'qr' ? '<span class="tag tag-line">Dal QR in sede</span>' : ''}</div>
      <h1 class="a-h1 mt-3">${esc(nomeCompleto(c))}</h1>
      <p class="a-sub">Iscritto il ${esc(data(c.creato_il))} · <span class="plate-tag">${esc(targa(c.targa))}</span></p>

      <div class="actions">
        <button type="button" class="btn btn-primary" data-act="promemoria">${svg('send', 18)} Invia promemoria ora</button>
        <div class="wa">
          <label for="wa-tipo" class="sr-only">Messaggio WhatsApp</label>
          <select id="wa-tipo" class="input">
            <option value="promemoria">Promemoria revisione</option>
            <option value="tagliando">Promemoria tagliando</option>
            <option value="recensione">Richiesta recensione</option>
            <option value="benvenuto">Benvenuto</option>
          </select>
          <button type="button" class="btn btn-wa" data-act="whatsapp">${svg('whatsapp', 19)} Invia su WhatsApp</button>
        </div>
        <button type="button" class="btn btn-ghost" data-act="completato" aria-expanded="false" aria-controls="done-panel">${svg('check', 18)} Lavoro completato</button>
        ${richiesta && !ottenuta ? `<button type="button" class="btn btn-ghost" data-act="ottenuta">${svg('star', 18)} Recensione ottenuta</button>` : ''}
      </div>
      <div class="done-panel" id="done-panel" hidden>
        <fieldset>
          <legend class="text-sm font-semibold">Che lavoro avete fatto?</legend>
          <div class="seg mt-2">
            ${[['revisione', 'Revisione'], ['tagliando', 'Tagliando'], ['carrozzeria', 'Carrozzeria'], ['lavoro', 'Altro']].map(([v, l], i) => `<input type="radio" name="motivo" id="m-${v}" value="${v}"${i === 0 ? ' checked' : ''}><label for="m-${v}">${l}</label>`).join('')}
          </div>
        </fieldset>
        <p class="mt-3 text-sm text-muted">Registra la visita e manda a ${esc(c.nome)} la richiesta di recensione con il link “Scrivi una recensione” di Google.</p>
        <button type="button" class="btn btn-ink mt-3" data-act="recensione">${svg('star', 18)} Invia richiesta di recensione</button>
      </div>

      <div class="cols">
        <section class="a-sec" aria-labelledby="t-dati">
          <div class="a-sec-head"><h2 id="t-dati" class="a-h2">Dati</h2></div>
          <dl class="spec">
            <div><dt>Scadenza revisione</dt><dd><span class="big t-num">${esc(data(c.scadenza))}</span><br><span class="tag tag-${s.tono} mt-1">${esc(s.testo)}</span>${c.rif_tipo === 'reg' ? ' <span class="text-sm text-muted">stima da immatricolazione</span>' : ''}</dd></div>
            <div><dt>Email</dt><dd><a href="mailto:${esc(c.email)}">${esc(c.email)}</a></dd></div>
            <div><dt>Cellulare</dt><dd>${c.telefono ? `<a href="tel:${esc(c.telefono)}">${esc(telefono(c.telefono))}</a>` : '<span class="text-muted">non indicato</span>'}</dd></div>
            <div><dt>Canale preferito</dt><dd class="inline-flex items-center gap-2">${canaleIcon(c)} ${c.canale === 'whatsapp' ? 'WhatsApp' : 'Email'}</dd></div>
            <div><dt>Lingua</dt><dd>${c.lingua === 'de' ? 'Tedesco' : 'Italiano'}</dd></div>
            <div><dt>Interessi</dt><dd>${esc(interessi(c)) || '<span class="text-muted">nessuno</span>'}</dd></div>
            <div><dt>Ultimo tagliando</dt><dd>${c.ultimo_tagliando ? esc(data(c.ultimo_tagliando)) : '<span class="text-muted">non registrato</span>'}</dd></div>
            <div><dt>Informativa privacy</dt><dd>vista il ${esc(data(c.consenso_privacy_il))}</dd></div>
            <div><dt>Promemoria</dt><dd>${sino(c.consenso_promemoria)}</dd></div>
            <div><dt>Offerte</dt><dd>${sino(c.consenso_offerte)}</dd></div>
          </dl>
        </section>

        <div>
          <section class="a-sec" aria-labelledby="t-next">
            <div class="a-sec-head"><h2 id="t-next" class="a-h2">Prossimi promemoria</h2></div>
            <ul class="rows">${
              prossimi.length
                ? prossimi.map((p) => `<li class="row"><span><span class="row-name">${p.tipo === 'revisione' ? `Revisione · ${p.giorniPrima} giorni prima` : 'Tagliando · 12 mesi'}</span><span class="row-meta">${c.canale === 'whatsapp' ? 'WhatsApp' : 'Email'}</span></span><span class="row-side"><strong>${esc(dataBreve(p.data))}</strong></span></li>`).join('')
                : `<li>${vuoto(c.consenso_promemoria ? 'Nessun promemoria in programma.' : 'Promemoria non attivi.', c.consenso_promemoria ? '' : ' Il cliente non ha dato il consenso ai promemoria.')}</li>`
            }</ul>
          </section>

          <section class="a-sec" aria-labelledby="t-storico">
            <div class="a-sec-head"><h2 id="t-storico" class="a-h2">Storico</h2></div>
            <ol class="tl">${
              ev.length
                ? ev.map((e) => {
                    const x = descriviEvento(e);
                    return `<li><time datetime="${esc(e.creato_il)}">${esc(dataOra(e.creato_il))}</time><span><strong class="font-semibold">${esc(x.titolo)}</strong>${x.canale ? ` <span class="text-muted">· ${esc(x.canale)}</span>` : ''}${x.esito ? ` <span class="tag tag-${x.tono}">${esc(x.esito)}</span>` : ''}${x.motivo ? ` <span class="text-sm text-muted">${esc(x.motivo)}</span>` : ''}</span></li>`;
                  }).join('')
                : `<li>${vuoto('Ancora nessun evento.', '')}</li>`
            }</ol>
          </section>
        </div>
      </div>`;
    bind(c, prossimi[0]?.tipo === 'tagliando' ? prossimi[0] : prossimi.find((p) => p.tipo === 'revisione'));
  }

  function bind(c: Cliente, prossimo?: ReturnType<typeof promemoriaCliente>[number]) {
    const btn = (k: string) => root.querySelector<HTMLButtonElement>(`[data-act="${k}"]`);
    // Dopo ogni azione la scheda si ridisegna: il fuoco torna sul bottone usato
    const rifai = async (k?: string) => {
      render(await carica());
      if (k) root.querySelector<HTMLElement>(`[data-act="${k}"]`)?.focus();
    };
    btn('promemoria')?.addEventListener('click', async (e) => {
      const r = await occupato(e.currentTarget as HTMLButtonElement, 'Invio…', () =>
        inviaPromemoria(c, prossimo?.tipo ?? 'revisione', prossimo?.chiave, prossimo ? isoDate(prossimo.scadenza) : undefined),
      );
      toast(r);
      await rifai('promemoria');
    });
    btn('whatsapp')?.addEventListener('click', async () => {
      const tipo = root.querySelector<HTMLSelectElement>('#wa-tipo')!.value as TipoMessaggio;
      toast(await whatsapp(c, tipo));
      await rifai('whatsapp');
    });
    const panel = root.querySelector<HTMLElement>('#done-panel')!;
    btn('completato')?.addEventListener('click', (e) => {
      const b = e.currentTarget as HTMLButtonElement;
      panel.hidden = !panel.hidden;
      b.setAttribute('aria-expanded', String(!panel.hidden));
      if (!panel.hidden) panel.querySelector<HTMLInputElement>('input:checked')?.focus();
    });
    btn('recensione')?.addEventListener('click', async (e) => {
      const motivo = root.querySelector<HTMLInputElement>('input[name="motivo"]:checked')?.value ?? 'lavoro';
      const r = await occupato(e.currentTarget as HTMLButtonElement, 'Invio…', () => lavoroCompletato(c, motivo));
      toast(r);
      await rifai('completato');
    });
    btn('ottenuta')?.addEventListener('click', async () => {
      toast(await recensioneOttenuta(c));
      await rifai('completato');
    });
  }

  carica().then(render);
</script>
