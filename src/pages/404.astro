---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { routes } from '../i18n/routes';
---
<Base lang="it" title="Pagina non trovata" description="La pagina che cerchi non esiste." alternates={{ it: '/it/', de: '/de/' }}>
  <section class="wrap section-y">
    <p class="t-label text-orange-ink t-num">404</p>
    <h1 class="t-h1 mt-4 max-w-[16ch]">Questa strada non porta da nessuna parte.</h1>
    <p class="mt-3 text-xl text-muted" lang="de">Diese Seite gibt es nicht.</p>
    <div class="mt-10 flex flex-wrap gap-3">
      <a href={routes.home.it} class="btn btn-ink">Torna alla home <Icon name="arrow" size={18} class="btn-arrow" /></a>
      <a href={routes.home.de} class="btn btn-ghost" lang="de" hreflang="de">Zur Startseite</a>
    </div>
  </section>
</Base>
