---
import '../styles/global.css';
import { site, type Lang } from '../data/site';
import { routes, type Alternates, type RouteKey } from '../i18n/routes';
import { ui } from '../i18n/ui';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileCtaBar from '../components/MobileCtaBar.astro';
import Preloader from '../components/Preloader.astro';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  alternates: Alternates;
  current?: RouteKey;
  ogImage?: string;
  jsonLd?: Record<string, unknown>[];
  whatsappText?: string;
  overlayHeader?: boolean;
}
const { lang, title, description, alternates, current, ogImage, jsonLd = [], whatsappText, overlayHeader = false } = Astro.props;
const t = ui[lang];
const siteUrl = Astro.site!.toString().replace(/\/$/, '');
const canonical = `${siteUrl}${alternates[lang]}`;
const og = ogImage ?? `${siteUrl}/og/og-${lang}.jpg`;
const fullTitle = title.includes('Car Trade') ? title : `${title} · Car Trade ${lang === 'de' ? 'Bozen' : 'Bolzano'}`;

// Zona servita: Bolzano e comuni vicini, con i nomi ufficiali nella lingua della pagina
const AREA: Record<Lang, [string, string][]> = {
  it: [['City', 'Bolzano'], ['City', 'Laives'], ['City', 'Appiano sulla Strada del Vino'], ['AdministrativeArea', 'Oltradige'], ['AdministrativeArea', 'Bassa Atesina']],
  de: [['City', 'Bozen'], ['City', 'Leifers'], ['City', 'Eppan an der Weinstraße'], ['AdministrativeArea', 'Überetsch'], ['AdministrativeArea', 'Unterland']],
};
const OFFERTE: Record<Lang, [string, string][]> = {
  it: [
    ['Revisione auto', 'Centro revisioni affiliato DEKRA per autovetture, prenotazione online.'],
    ['Tagliando', 'Manutenzione programmata secondo le specifiche del costruttore, per tutte le marche.'],
    ['Meccanica', 'Freni, distribuzione, frizione, diagnosi elettronica.'],
    ['Carrozzeria', 'Riparazione di ammaccature e graffi, raddrizzatura, verniciatura. Preventivo anche da foto.'],
    ['Gomme', 'Cambio gomme stagionale: in provincia di Bolzano le invernali servono dal 15 novembre al 15 aprile.'],
    ['Vendita auto usate e km 0', 'Auto usate selezionate e km 0 con garanzia, controllate in officina.'],
  ],
  de: [
    ['Fahrzeugrevision', 'DEKRA-Partner für die Revision von Pkw, Online-Buchung.'],
    ['Inspektion', 'Wartung nach Herstellervorgaben, für alle Marken.'],
    ['Mechanik', 'Bremsen, Zahnriemen, Kupplung, elektronische Diagnose.'],
    ['Karosserie', 'Dellen und Kratzer, Richtarbeiten, Lackierung. Angebot auch per Foto.'],
    ['Reifen', 'Saisonaler Reifenwechsel: In Südtirol gilt die Winterausrüstungspflicht vom 15. November bis 15. April.'],
    ['Gebrauchtwagen und Tageszulassungen', 'Ausgewählte Gebrauchtwagen und Tageszulassungen mit Garantie, in der Werkstatt geprüft.'],
  ],
};

// schema.org: officina + concessionario nella stessa sede
const business = {
  '@context': 'https://schema.org',
  '@type': ['AutoRepair', 'AutoDealer'],
  '@id': `${siteUrl}/#business`,
  name: site.name,
  alternateName: site.brand,
  url: `${siteUrl}${routes.home[lang]}`,
  image: `${siteUrl}/og/og-${lang}.jpg`,
  logo: `${siteUrl}/brand/logo.svg`,
  telephone: site.phone.e164,
  ...(site.email ? { email: site.email } : {}),
  vatID: `IT${site.vat}`,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street[lang],
    postalCode: site.address.postalCode,
    addressLocality: site.address.city[lang],
    addressRegion: site.address.region,
    addressCountry: site.address.country,
  },
  geo: { '@type': 'GeoCoordinates', latitude: site.geo.lat, longitude: site.geo.lng },
  // Scheda Google per cid e pagina DEKRA del centro. Niente Facebook: è fermo al 2018, con un altro indirizzo.
  hasMap: site.google.mapsCidUrl,
  sameAs: [site.google.mapsCidUrl, site.dekra.profileUrl],
  areaServed: AREA[lang].map(([type, name]) => ({ '@type': type, name })),
  makesOffer: OFFERTE[lang].map(([name, description], i) => ({
    '@type': 'Offer',
    itemOffered: { '@type': 'Service', name, description },
    // La revisione ha la tariffa nazionale fissa; gli altri servizi su preventivo
    ...(i === 0 ? { price: site.revisionFee.total.toFixed(2), priceCurrency: 'EUR' } : {}),
    areaServed: { '@type': 'City', name: site.address.city[lang] },
  })),
  // TODO: aggiungere il sabato se confermato
  openingHoursSpecification: site.hours.map((h) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
    opens: h.open,
    closes: h.close,
  })),
  knowsLanguage: ['it', 'de'],
  // Nota: niente aggregateRating dalle recensioni Google (non ammesso per i rich result "self-serving").
};
const ld = [business, ...jsonLd];
---
<!doctype html>
<html lang={lang} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <!-- Preload della foto LCP (slot "head" delle pagine) il prima possibile nell'head -->
    <slot name="head" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="it" href={`${siteUrl}${alternates.it}`} />
    <link rel="alternate" hreflang="de" href={`${siteUrl}${alternates.de}`} />
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}${alternates.it}`} />
    <link rel="sitemap" href="/sitemap.xml" />

    <meta name="theme-color" content="#F7F6F3" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Car Trade Bolzano" />
    <meta property="og:locale" content={lang === 'it' ? 'it_IT' : 'de_DE'} />
    <meta property="og:locale:alternate" content={lang === 'it' ? 'de_DE' : 'it_IT'} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="geo.region" content="IT-BZ" />
    <meta name="geo.placename" content={lang === 'it' ? 'Bolzano' : 'Bozen'} />
    <meta name="geo.position" content={`${site.geo.lat};${site.geo.lng}`} />

    <!-- Font non precaricato: su mobile ruberebbe banda alla foto LCP. font-display: swap + fallback metrico = niente CLS -->
    <link rel="preconnect" href="https://images.unsplash.com" />

    <script is:inline>
      // Schermata di caricamento: ogni volta che si ENTRA nel sito (link esterno, URL digitato, ricarica),
      // non quando si naviga tra le pagine. Con "riduci movimento" compare in versione calma (html.calm).
      // ?intro=0 la salta (test automatici).
      (function () {
        var d = document.documentElement;
        d.classList.replace('no-js', 'js');
        try {
          if (/[?&]intro=0\b/.test(location.search)) return;
          var nav = performance.getEntriesByType && performance.getEntriesByType('navigation')[0];
          var type = nav ? nav.type : 'navigate';
          var fromRoot = sessionStorage.getItem('ct-entry') === '1'; // arrivo da "/" che reindirizza alla lingua
          sessionStorage.removeItem('ct-entry');
          var internal = false;
          if (document.referrer) {
            try { internal = new URL(document.referrer).origin === location.origin; } catch (e) {}
          }
          if (type === 'back_forward' || (internal && type !== 'reload' && !fromRoot)) return;
          d.classList.add('is-loading');
          if (matchMedia('(prefers-reduced-motion: reduce)').matches) d.classList.add('calm');
          setTimeout(function () { d.classList.remove('is-loading'); }, 5000); // rete di sicurezza
        } catch (e) {}
      })();
    </script>

    {ld.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
  </head>
  <body>
    <Preloader lang={lang} />
    <a href="#main" class="skip-link">{t.skip}</a>
    <Header lang={lang} alternates={alternates} current={current} overlay={overlayHeader} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
    <MobileCtaBar lang={lang} whatsappText={whatsappText} />

    <script>
      import '../scripts/reveal';
      import '../scripts/motion';
    </script>

    <style>
@layer components {
      .skip-link {
        position: fixed;
        left: 1rem;
        top: 0.75rem;
        z-index: 100;
        padding: 0.75rem 1rem;
        background: var(--color-ink);
        color: var(--color-paper);
        font-weight: 600;
        transform: translateY(-200%);
      }
      .skip-link:focus { transform: none; }
      main:focus { outline: none; }
    }
</style>
  </body>
</html>
