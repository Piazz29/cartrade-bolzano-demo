---
// Guscio dell'area admin (/admin/, solo italiano). Progettato prima per il telefono:
// barra in basso con le 4 sezioni più usate + "Altro"; da 1024 px barra laterale.
// Stessi colori e caratteri del sito con la sensazione di un'app: tema chiaro e scuro, movimento morbido.
import '../styles/global.css';
import '../styles/admin.css';
import Icon from '../components/Icon.astro';
import { statoServizi } from '../lib/server/config';
import type { IconName } from '../lib/icons';

interface Props {
  title: string;
  current?: string;
  /** larghezza piena (es. locandina, anteprime email) */
  wide?: boolean;
}
const { title, current, wide = false } = Astro.props;
const stato = statoServizi();

const nav: { key: string; href: string; label: string; icon: IconName; main?: boolean }[] = [
  { key: 'home', href: '/admin/', label: 'Panoramica', icon: 'grid', main: true },
  { key: 'clienti', href: '/admin/clienti/', label: 'Clienti', icon: 'users', main: true },
  { key: 'promemoria', href: '/admin/promemoria/', label: 'Promemoria', icon: 'bell', main: true },
  { key: 'campagne', href: '/admin/campagne/', label: 'Campagne', icon: 'megaphone', main: true },
  { key: 'recensioni', href: '/admin/recensioni/', label: 'Recensioni', icon: 'star' },
  { key: 'showroom', href: '/admin/showroom/', label: 'Showroom', icon: 'car' },
  { key: 'email', href: '/admin/email/', label: 'Modelli email', icon: 'mail' },
  { key: 'locandina', href: '/admin/locandina/', label: 'Locandina QR', icon: 'qr' },
  { key: 'demo', href: '/admin/#demo', label: 'Ripristina demo', icon: 'refresh' },
];
const altroAttivo = nav.some((n) => !n.main && n.key === current);
const mancanti = [!stato.db && 'Supabase', !stato.email && 'invio email'].filter(Boolean);
---
<!doctype html>
<html lang="it" class="no-js admin-html" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#0A1A30" />
    <title>{title} · Admin Car Trade</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Tema deciso prima del primo disegno: niente lampo bianco aprendo in scuro -->
    <script is:inline>
      (function () {
        var d = document.documentElement, t = null;
        d.classList.replace('no-js', 'js');
        try { t = localStorage.getItem('ct-admin-tema'); } catch (e) {}
        if (t !== 'dark' && t !== 'light') t = window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        d.setAttribute('data-theme', t);
      })();
    </script>
    <!-- Le altre pagine dell'admin si scaricano appena il dito tocca il link -->
    <script type="speculationrules" is:inline>
      { "prefetch": [{ "where": { "href_matches": "/admin/*" }, "eagerness": "moderate" }] }
    </script>
  </head>
  <body class="admin">
    <a href="#main" class="skip">Vai al contenuto</a>
    <header class="topbar on-dark">
      <a href="/admin/" class="brand" aria-label="Car Trade, area admin: panoramica">
        <img src="/brand/logo-inverse.svg" alt="" width="904" height="282" />
        <span class="t-label">Admin</span>
      </a>
      <div class="mode-wrap" data-mode-wrap>
        <button type="button" class:list={['mode t-label', stato.db ? 'is-live' : 'is-sim']} data-mode aria-expanded="false" aria-controls="mode-info">
          <span class="dot" aria-hidden="true"></span><span data-mode-text>{stato.db ? 'Collegato' : 'Simulato'}</span>
        </button>
        <p id="mode-info" class="mode-info" role="note" data-mode-info>
          {stato.db
            ? <><strong>Collegato al database</strong>Iscrizioni ed email partono davvero. I clienti con l’etichetta grigia «Esempio» sono finti e servono solo per la demo.</>
            : <><strong>Modalità simulata</strong>I dati restano in questo browser e nessun messaggio parte davvero.</>}
        </p>
      </div>
      <button type="button" class="iconbtn theme-btn" data-theme-toggle aria-pressed="false" aria-label="Tema scuro">
        <span class="ico-moon"><Icon name="moon" size={20} /></span>
        <span class="ico-sun"><Icon name="sun" size={21} /></span>
      </button>
      <form method="post" action="/api/admin/logout">
        <button type="submit" class="iconbtn" aria-label="Esci dall'admin"><Icon name="logout" size={20} /></button>
      </form>
    </header>

    <div class="shell">
      <nav class="sidenav" aria-label="Sezioni dell'admin">
        <ul>
          {nav.map((n) => (
            <li>
              <a href={n.href} aria-current={n.key === current ? 'page' : undefined}>
                {n.key === current && <span class="side-pill" aria-hidden="true"></span>}
                <Icon name={n.icon} size={20} /> <span>{n.label}</span>
              </a>
            </li>
          ))}
        </ul>
        <p class="side-note">Il gestionale DEKRA resta com’è. Qui ci sono i tuoi clienti, che tornano da te.</p>
      </nav>

      <main id="main" tabindex="-1" class:list={['content', wide && 'is-wide']}>
        <p class="sim-banner" role="note" data-sim-banner hidden={mancanti.length === 0}>
          <Icon name="alert" size={18} class="shrink-0" />
          <span data-sim-text>{mancanti.length ? `Modalità simulata: ${mancanti.join(' e ')} non configurat${mancanti.length > 1 ? 'i' : 'o'}. Le azioni funzionano, ma restano in questo browser e nessun messaggio parte davvero.` : ''}</span>
        </p>
        <slot />
      </main>
    </div>

    <nav class="tabbar" aria-label="Sezioni principali">
      <ul>
        {nav.filter((n) => n.main).map((n) => (
          <li>
            <a href={n.href} aria-current={n.key === current ? 'page' : undefined}>
              <span class="tab-ico">{n.key === current && <span class="tab-pill" aria-hidden="true"></span>}<Icon name={n.icon} size={22} /></span>
              <span>{n.label}</span>
            </a>
          </li>
        ))}
        <li>
          <button type="button" aria-expanded="false" aria-controls="altro" data-altro class:list={[altroAttivo && 'is-current']}>
            <span class="tab-ico">{altroAttivo && <span class="tab-pill" aria-hidden="true"></span>}<Icon name="more" size={22} /></span>
            <span>Altro</span>
          </button>
        </li>
      </ul>
      <div class="scrim" data-altro-scrim aria-hidden="true"></div>
      <div id="altro" class="altro" data-altro-panel inert>
        <span class="grab" aria-hidden="true"></span>
        <p class="altro-t t-label">Altre sezioni</p>
        <ul>
          {nav.filter((n) => !n.main).map((n) => (
            <li><a href={n.href} aria-current={n.key === current ? 'page' : undefined}><span class="a-ico"><Icon name={n.icon} size={20} /></span> {n.label}</a></li>
          ))}
        </ul>
      </div>
    </nav>

    <div class="toasts" role="status" aria-live="polite" data-toasts></div>
    <div class="a-scroll" aria-hidden="true" hidden data-scroll><i></i></div>

    <script>
      const root = document.documentElement;

      // Tema: segue il telefono finché non si tocca il bottone, poi resta quello scelto
      const KEY = 'ct-admin-tema';
      const themeBtn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]')!;
      const sync = () => {
        const dark = root.dataset.theme === 'dark';
        themeBtn.setAttribute('aria-pressed', String(dark));
      };
      sync();
      const media = window.matchMedia('(prefers-color-scheme: dark)');
      const scelto = () => {
        try {
          return localStorage.getItem(KEY);
        } catch {
          return null;
        }
      };
      media.addEventListener?.('change', (e) => {
        if (scelto()) return;
        root.dataset.theme = e.matches ? 'dark' : 'light';
        sync();
      });
      themeBtn.addEventListener('click', () => {
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        try {
          localStorage.setItem(KEY, next);
        } catch {
          /* navigazione privata: il tema vale solo per questa pagina */
        }
        const apply = () => {
          root.dataset.theme = next;
          sync();
        };
        const doc = document as Document & { startViewTransition?: (cb: () => void) => { finished: Promise<void> } };
        if (!doc.startViewTransition || matchMedia('(prefers-reduced-motion: reduce)').matches) return apply();
        root.classList.add('theme-vt');
        doc.startViewTransition(apply).finished.finally(() => root.classList.remove('theme-vt'));
      });

      // "Collegato": un tocco apre la spiegazione
      const modeWrap = document.querySelector<HTMLElement>('[data-mode-wrap]')!;
      const modeBtn = modeWrap.querySelector<HTMLButtonElement>('[data-mode]')!;
      const setMode = (open: boolean) => {
        modeWrap.classList.toggle('is-open', open);
        modeBtn.setAttribute('aria-expanded', String(open));
      };
      modeBtn.addEventListener('click', () => setMode(!modeWrap.classList.contains('is-open')));

      // "Altro": pannello dal basso
      const tabbar = document.querySelector<HTMLElement>('.tabbar')!;
      const btn = document.querySelector<HTMLButtonElement>('[data-altro]')!;
      const panel = document.querySelector<HTMLElement>('[data-altro-panel]')!;
      const setAltro = (open: boolean) => {
        tabbar.classList.toggle('is-open', open);
        btn.setAttribute('aria-expanded', String(open));
        panel.inert = !open;
        if (open) panel.querySelector<HTMLElement>('a')?.focus({ preventScroll: true });
      };
      btn.addEventListener('click', () => setAltro(!tabbar.classList.contains('is-open')));
      document.querySelector('[data-altro-scrim]')!.addEventListener('click', () => setAltro(false));

      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape') return;
        if (tabbar.classList.contains('is-open')) {
          setAltro(false);
          btn.focus();
        }
        if (modeWrap.classList.contains('is-open')) {
          setMode(false);
          modeBtn.focus();
        }
      });
      document.addEventListener('click', (e) => {
        if (modeWrap.classList.contains('is-open') && !modeWrap.contains(e.target as Node)) setMode(false);
      });

      // Tocco su una sezione: risposta immediata mentre la pagina arriva
      document.querySelectorAll<HTMLAnchorElement>('.tabbar > ul > li > a').forEach((a) =>
        a.addEventListener('click', () => {
          if (a.getAttribute('aria-current') !== 'page') a.classList.add('is-going');
        }),
      );
      // Tornando indietro dalla cache del browser la pagina riparte pulita
      window.addEventListener('pageshow', () => {
        document.querySelectorAll('.is-going').forEach((el) => el.classList.remove('is-going'));
        setAltro(false);
        setMode(false);
      });

      // Barra di scorrimento disegnata (quella del browser è nascosta)
      const track = document.querySelector<HTMLElement>('[data-scroll]')!;
      const thumb = track.querySelector('i')!;
      const se = document.scrollingElement ?? document.documentElement;
      let trackH = 0, thumbH = 0, maxScroll = 0, frame = 0, spegni = 0;
      const posiziona = () => {
        frame = 0;
        const y = maxScroll > 0 ? ((trackH - thumbH) * se.scrollTop) / maxScroll : 0;
        thumb.style.transform = `translate3d(0, ${y.toFixed(1)}px, 0)`;
      };
      const misura = () => {
        trackH = track.clientHeight || window.innerHeight;
        maxScroll = se.scrollHeight - window.innerHeight;
        track.hidden = maxScroll < 8;
        if (track.hidden) return;
        trackH = track.clientHeight;
        thumbH = Math.max(36, Math.round((trackH * window.innerHeight) / se.scrollHeight));
        thumb.style.height = `${thumbH}px`;
        posiziona();
      };
      const mostra = () => {
        track.classList.add('is-on');
        clearTimeout(spegni);
        spegni = window.setTimeout(() => track.classList.remove('is-on'), 900);
      };
      window.addEventListener(
        'scroll',
        () => {
          if (track.hidden) return;
          if (!frame) frame = requestAnimationFrame(posiziona);
          mostra();
        },
        { passive: true },
      );
      window.addEventListener('resize', misura, { passive: true });
      new ResizeObserver(() => misura()).observe(document.body);
      misura();
      // Col mouse si può trascinare o cliccare il binario
      track.addEventListener('pointerenter', mostra);
      track.addEventListener('pointerdown', (e) => {
        e.preventDefault();
        const r = thumb.getBoundingClientRect();
        const dentro = e.clientY >= r.top && e.clientY <= r.bottom;
        const presa = dentro ? e.clientY - r.top : thumbH / 2;
        const vai = (cy: number) => {
          const top = track.getBoundingClientRect().top;
          const y = Math.min(Math.max(cy - top - presa, 0), trackH - thumbH);
          se.scrollTop = (y / Math.max(1, trackH - thumbH)) * maxScroll;
        };
        if (!dentro) vai(e.clientY);
        track.classList.add('is-drag');
        track.setPointerCapture(e.pointerId);
        const muovi = (ev: PointerEvent) => vai(ev.clientY);
        const fine = () => {
          track.classList.remove('is-drag');
          track.removeEventListener('pointermove', muovi);
          mostra();
        };
        track.addEventListener('pointermove', muovi);
        track.addEventListener('pointerup', fine, { once: true });
        track.addEventListener('pointercancel', fine, { once: true });
      });

      // Gli elenchi entrano riga per riga solo la prima volta: dopo, main è "pronto" e gli aggiornamenti non si rianimano
      const main = document.querySelector<HTMLElement>('main')!;
      let pronto = 0;
      const segna = () => {
        clearTimeout(pronto);
        pronto = window.setTimeout(() => {
          if (main.querySelector('.skeleton')) return;
          main.classList.add('is-ready');
          osserva.disconnect();
        }, 700);
      };
      const osserva = new MutationObserver(() => {
        if (!main.querySelector('.skeleton')) segna();
      });
      osserva.observe(main, { childList: true, subtree: true });
      if (!main.querySelector('.skeleton')) segna();
    </script>
  </body>
</html>
