---
// Riepilogo delle recensioni Google della scheda "Centro Revisioni Dekra - Car Trade Srl".
// Versione statica: voto e numero arrivano da src/data/site.ts (aggiornati a mano), nessuna API.
// I pulsanti portano alle recensioni vere su Google e alla pagina per scriverne una.
import { site, formatNumber, type Lang } from '../data/site';
import Icon from './Icon.astro';
import GoogleLogo from './GoogleLogo.astro';

interface Props { lang: Lang; dark?: boolean }
const { lang, dark = true } = Astro.props;

const copy = {
  it: {
    title: 'Cosa dicono su Google',
    readAll: 'Leggi tutte le recensioni',
    write: 'Lascia una recensione',
    reviews: 'recensioni',
    of: 'su',
  },
  de: {
    title: 'Was Kunden auf Google sagen',
    readAll: 'Alle Bewertungen lesen',
    write: 'Bewertung schreiben',
    reviews: 'Bewertungen',
    of: 'von',
  },
  en: {
    title: 'What customers say on Google',
    readAll: 'Read all reviews',
    write: 'Write a review',
    reviews: 'reviews',
    of: 'out of',
  },
}[lang];
---
<section class:list={['greviews', dark && 'on-dark']} aria-labelledby="greviews-title">
  <h3 id="greviews-title" class="t-h3">{copy.title}</h3>
  <div class="foot">
    <p class="summary t-num">
      <GoogleLogo size={32} />
      <span>
        <strong>{formatNumber(site.google.rating, lang, 1)}</strong> {copy.of} 5{' · '}{site.google.reviewCountLabel} {copy.reviews}
      </span>
    </p>
    <div class="flex flex-wrap gap-3">
      <a href={site.google.reviewsUrl} class="btn btn-ghost" target="_blank" rel="noopener">
        {copy.readAll} <Icon name="arrow-up-right" size={16} />
      </a>
      <a href={site.google.writeReviewUrl} class="btn btn-ghost" target="_blank" rel="noopener">
        {copy.write} <Icon name="arrow-up-right" size={16} />
      </a>
    </div>
  </div>
</section>

<style>
@layer components {
  .greviews { display: grid; gap: 1.5rem; }
  .foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem 2rem; }
  .summary { display: flex; align-items: center; gap: 0.75rem; font-size: 1.0625rem; }
}
</style>
