const steps = copy.steps;
const total = steps.length;
const pad = (n: number) => String(n).padStart(2, '0');

// Geometria del disegno (unità SVG). viewBox: x -60…1020, y 56…396
const VB = { x: -60, y: 56, w: 1080, h: 340 };
const pctX = (x: number) => `${(((x - VB.x) / VB.w) * 100).toFixed(3)}%`;
const pctY = (y: number) => `${(((y - VB.y) / VB.h) * 100).toFixed(3)}%`;
const wheels = [220, 790];
const WY = 302;
const spokes = (cx: number) =>
  [0, 1, 2, 3, 4].map((i) => {
    const a = ((-90 + i * 72) * Math.PI) / 180;
    return { x1: cx + Math.cos(a) * 11, y1: WY + Math.sin(a) * 11, x2: cx + Math.cos(a) * 38, y2: WY + Math.sin(a) * 38 };
  });
// Molla elicoidale sopra ogni ruota (linee nascoste, tratteggio)
// Davanti il cofano è basso: la molla parte più in basso per restare dentro la scocca
const spring = (cx: number) => {
  const top = cx < 500 ? 222 : 196, bottom = 240, n = cx < 500 ? 5 : 7, w = cx < 500 ? 9 : 11;
  const pts = [`${cx},${top}`];
  for (let i = 1; i < n; i++) pts.push(`${cx + (i % 2 ? w : -w)},${top + ((bottom - top) * i) / n}`);
  pts.push(`${cx},${bottom}`);
  return pts.join(' ');
};
// Pinza freno: arco spesso sul disco
const caliper = (cx: number) => {
  const r = 27;
  const p = (deg: number) => [cx + Math.cos((deg * Math.PI) / 180) * r, WY + Math.sin((deg * Math.PI) / 180) * r].map((v) => v.toFixed(1));
  const [a, b] = [p(-150), p(-100)];
  return `M ${a[0]} ${a[1]} A ${r} ${r} 0 0 1 ${b[0]} ${b[1]}`;
};
// Righello a terra
const ticks = Array.from({ length: 27 }, (_, i) => -40 + i * 40);
const resultIndex = total + 1;
const scanX = [...steps.map((s) => s.x), 500];
const items = [...steps.map((s) => ({ t: s.t, tool: s.tool, x: s.x })), { t: copy.result.t, tool: copy.result.tool, x: 500 }];
