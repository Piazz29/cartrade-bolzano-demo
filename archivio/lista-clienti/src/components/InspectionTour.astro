      <p class="col-span-4 max-w-[48ch] text-steel lg:col-span-5 lg:self-end" data-reveal>{compact ? copy.leadCompact : copy.lead}</p>
    </div>

    <div class="tour-grid mt-10 lg:mt-16">
      <!-- Banco: disegno + display. Versione estesa: su mobile resta in alto mentre scorrono i passaggi -->
      <div class="rig-col">
        <div class="rig" data-rig data-active="1" style={`--sx:${scanX[0]}px`}>
          <div class="rig-stage">
            <p class="rig-corner rig-tl t-label" aria-hidden="true">{copy.sheet}</p>
            <p class="rig-corner rig-tr t-label t-num" aria-hidden="true">DEKRA · 01–{pad(total)}</p>
