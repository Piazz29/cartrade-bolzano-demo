                <line class="ground" x1="-50" y1="360" x2="1010" y2="360" />
                {ticks.map((x, i) => <line class="tick" x1={x} y1="360" x2={x} y2={i % 5 === 0 ? 372 : 366} />)}
                <!-- quota del passo -->
                <g class="dim">
                  <line x1={wheels[0]} y1="386" x2={wheels[1]} y2="386" />
                  <line x1={wheels[0]} y1="378" x2={wheels[0]} y2="394" />
