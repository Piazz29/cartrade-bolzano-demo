                  <path class="glass" d="M 378 200 L 474 108 Q 498 96 548 94 L 580 94 L 580 200 Z" />
                  <path class="glass" d="M 596 200 L 596 95 L 656 96 Q 714 102 768 134 L 784 200 Z" />
                  <path class="part" d="M 386 202 L 400 182 L 432 184 L 430 202 Z" />
                </g>
                <!-- 08 abitacolo: sedili e cintura (linee nascoste) -->
                <g class="z-equip hidden-l">
                  <path d="M 540 200 L 550 136 Q 556 124 566 130 L 560 200" />
                  <rect x="545" y="112" width="20" height="16" rx="6" />
                  <line x1="574" y1="118" x2="542" y2="194" />
                  <path d="M 690 200 L 700 142 Q 706 132 714 138 L 708 200" />
                </g>
                <!-- 07 struttura: porte, maniglie, pianale, serbatoio -->
                <g class="z-body">
                  <path class="seam" d="M 372 204 Q 364 262 372 320" />
                  <path class="seam" d="M 588 204 L 590 320" />
                  <path class="seam" d="M 742 204 Q 748 226 744 246" />
                  <path class="seam" d="M 296 246 Q 520 238 716 240" />
                  <rect class="part" x="500" y="226" width="36" height="7" rx="3.5" />
                  <rect class="part" x="668" y="226" width="36" height="7" rx="3.5" />
                  <path class="hidden-l" d="M 76 336 L 170 336 M 270 336 L 740 336 M 840 336 L 930 336" />
                  <rect class="hidden-l" x="632" y="288" width="72" height="24" rx="3" />
                </g>
                <!-- 03 sterzo: volante, piantone fino alla ruota anteriore -->
                <g class="z-steering">
                  <ellipse class="part" cx="468" cy="176" rx="6" ry="22" transform="rotate(-24 468 176)" />
                  <path class="hidden-l" d="M 472 194 L 330 262 L 226 300" />
                </g>
                <!-- 05 fari e fanali -->
                <g class="z-lights">
                  <path class="lamp" d="M 62 254 L 68 246 L 168 228 L 176 240 Q 130 254 70 262 Z" />
                  <path class="lamp" d="M 918 186 Q 942 192 948 208 L 950 228 L 920 220 Z" />
                </g>
                <!-- 01 targhe e targhetta del telaio -->
                <g class="z-id">
                  <rect class="part" x="50" y="278" width="6" height="28" rx="1" />
                  <rect class="part" x="952" y="244" width="6" height="28" rx="1" />
                  <rect class="part" x="577" y="280" width="22" height="12" rx="1.5" />
                </g>
                <!-- 09 scarico e fumi -->
                <g class="z-emissions">
                  <rect class="part" x="870" y="324" width="58" height="10" rx="3" />
                  <g class="puffs">
                    <circle cx="946" cy="329" r="6" />
                    <circle cx="966" cy="320" r="9" />
                    <circle cx="990" cy="306" r="12" />
                  </g>
                </g>

                <!-- ruote: 06 pneumatici e molle, 02 dischi e pinze -->
                {wheels.map((cx) => (
                  <g>
                    <circle class="tyre z-wheels" cx={cx} cy={WY} r="58" />
                    <circle class="rim" cx={cx} cy={WY} r="42" />
                    <circle class="disc z-brakes" cx={cx} cy={WY} r="30" />
                    {spokes(cx).map((s) => <line class="spoke" x1={s.x1} y1={s.y1} x2={s.x2} y2={s.y2} />)}
                    <circle class="hub" cx={cx} cy={WY} r="8" />
                    <path class="caliper z-brakes" d={caliper(cx)} />
                    <polyline class="hidden-l z-wheels" points={spring(cx)} />
                  </g>
                ))}

                <!-- linea di scansione -->
                <g class="scan">
                  <line x1="0" y1="66" x2="0" y2="360" />
                  <path d="M -7 66 L 7 66 L 0 76 Z" />
                </g>
              </svg>

              <!-- punti di controllo -->
              <ol class="spots" role="list">
                {steps.map((s, i) => (
                  <li class="spot-li" style={`left:${pctX(s.hx)};top:${pctY(s.hy)}`}>
                    <button type="button" class:list={['spot t-num', i === 0 && 'is-active']} data-spot={i + 1} aria-label={`${copy.goTo} ${pad(i + 1)}: ${s.t}`}>
                      <span class="spot-n">{i + 1}</span>
                      <Icon name="check" size={13} class="spot-ok" />
                    </button>
                  </li>
                ))}
              </ol>
            </div>
          </div>

          <!-- display stile cruscotto -->
          <div class="readout" aria-hidden="true">
            <div class="ro-count t-num">
              <span class="t-label ro-k">{copy.check}</span>
              <span class="ro-num"><span data-ro-num>01</span><span class="ro-of">/{pad(total)}</span></span>
            </div>
            <div class="ro-main">
              <span class="ro-title" data-ro-title>{steps[0].t}</span>
              <span class="ro-tool"><span class="t-label ro-k">{copy.tool}</span> <span data-ro-tool>{steps[0].tool}</span></span>
            </div>
            <div class="ro-bar">
              {Array.from({ length: resultIndex }, (_, i) => <span class:list={['ro-seg', i === 0 && 'is-active']} data-seg={i + 1}></span>)}
            </div>
          </div>
          {compact && (
            <div class="ro-ctrl">
              <button type="button" class="ctrl ctrl-step" data-prev aria-label={copy.prev}><Icon name="arrow" size={17} class="rotate-180" /><span class="ctrl-txt">{copy.prevShort}</span></button>
              <button type="button" class="ctrl ctrl-step" data-next aria-label={copy.next}><span class="ctrl-txt">{copy.nextShort}</span><Icon name="arrow" size={17} /></button>
            </div>
          )}
        </div>

        {/* Dettaglio del controllo selezionato: pannelli sovrapposti, l'altezza è quella del più lungo (niente salti) */}
        {compact && (
          <div class="panels">
            {steps.map((s, i) => (
              <div class:list={['panel', i === 0 && 'is-active']} id={`${headingId}-p${i + 1}`} data-panel={i + 1}>
                <h3 class="sr-only">{pad(i + 1)}. {s.t}</h3>
                <p class="panel-d">{s.d}</p>
                <ul class="panel-checks" role="list">
                  {s.checks.map((c) => <li>{c}</li>)}
                </ul>
              </div>
            ))}
            <div class="panel" id={`${headingId}-p${resultIndex}`} data-panel={resultIndex}>
              <h3 class="sr-only">{copy.result.t}</h3>
              <p class="panel-d">{copy.result.d}</p>
              <ul class="rv-out panel-out" role="list">
                {copy.result.outcomes.map((o) => (
                  <li class={`rv-out-${o.k}`}>
                    <span class="rv-chip t-label">{o.t}</span>
                    <span>{o.d}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        )}
      </div>

      {compact ? (
        <div class="idx-col">
          <p class="t-label idx-label">{copy.indexLabel}</p>
          <ol class="idx" role="list">
            {items.map((it, i) => (
              <li>
                <a
                  href={`${routes.revisione[lang]}#${FULL_ID}-${i + 1}`}
                  class:list={['idx-row', i === 0 && 'is-active']}
                  data-pick={i + 1}
                  data-title={it.t}
                  data-tool={it.tool}
                  data-x={it.x}
                  aria-controls={`${headingId}-p${i + 1}`}
                  aria-current={i === 0 ? 'step' : undefined}
                >
                  <span class="idx-n t-num" aria-hidden="true">{i < total ? pad(i + 1) : <Icon name="check" size={14} />}</span>
                  <span class="idx-t">{it.t}</span>
                  <span class="idx-tool">{it.tool}</span>
                </a>
              </li>
            ))}
          </ol>
          <p class="idx-here">{copy.result.here}</p>
          <div class="idx-cta">
            <a href={site.dekra.bookingUrl} class="btn btn-primary" target="_blank" rel="noopener">
              {t.cta.book}<span class="sr-only"> ({t.externalBooking})</span>
              <Icon name="arrow-up-right" size={18} class="btn-arrow" />
            </a>
            <a href={`${routes.revisione[lang]}#${FULL_ID}`} class="btn btn-ghost">{copy.detail} <Icon name="arrow" size={18} class="btn-arrow" /></a>
          </div>
        </div>
      ) : (
      <ol class="steps-list" role="list">
        {steps.map((s, i) => (
          <li class="rv-step" id={`${headingId}-${i + 1}`} data-rv-step={i + 1} data-title={s.t} data-tool={s.tool} data-x={s.x}>
            <div class="rv-head">
              <span class="rv-num t-num" aria-hidden="true">{pad(i + 1)}</span>
              <div>
                <h3 class="t-h3"><span class="sr-only">{pad(i + 1)}. </span>{s.t}</h3>
                <p class="rv-tool t-label">{s.tool}</p>
              </div>
            </div>
            <p class="rv-d">{s.d}</p>
            <ul class="rv-checks" role="list">
              {s.checks.map((c) => <li>{c}</li>)}
            </ul>
            {s.note && (
              <p class="rv-note">
                <span class="t-label text-orange">{copy.whyLabel}</span>
                <span>{s.note}</span>
                <span class="t-label rv-src">{copy.source}</span>
              </p>
            )}
          </li>
        ))}

        <li class="rv-step rv-result" id={`${headingId}-${resultIndex}`} data-rv-step={resultIndex} data-title={copy.result.t} data-tool={copy.result.tool} data-x="500">
          <div class="rv-head">
            <span class="rv-num rv-num-ok t-num" aria-hidden="true"><Icon name="check" size={22} /></span>
            <div>
              <h3 class="t-h3">{copy.result.t}</h3>
              <p class="rv-tool t-label">{copy.result.tool}</p>
            </div>
          </div>
          <p class="rv-d">{copy.result.d}</p>
          <p class="rv-here">{copy.result.here}</p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a href={site.dekra.bookingUrl} class="btn btn-primary" target="_blank" rel="noopener">
              {t.cta.book}<span class="sr-only"> ({t.externalBooking})</span>
              <Icon name="arrow-up-right" size={18} class="btn-arrow" />
            </a>
            <a href="#esiti" class="btn btn-ghost">{copy.result.outcomesLink} <Icon name="arrow" size={18} class="btn-arrow rotate-90" /></a>
          </div>
        </li>
      </ol>
      )}
    </div>
  </div>
</section>

<style>
@layer components {
  .tour { --grid: color-mix(in oklab, var(--color-steel) 7%, transparent); }

  .tour-grid { display: grid; gap: 0; }
  @media (min-width: 64rem) {
    .tour-grid { grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); column-gap: clamp(2.5rem, 5vw, 5rem); align-items: start; }
  }

  /* ---------- Banco ---------- */
  /* Mobile: il banco resta fermo sotto l'header mentre scorrono i passaggi (fondo pieno, a tutta larghezza) */
  .rig-col { position: sticky; top: var(--header-h); z-index: 5; margin-inline: calc(var(--gutter) * -1); background: var(--color-night); }
  .is-compact .rig-col { position: relative; top: auto; }
  @media (min-width: 64rem) {
    .rig-col { top: calc(var(--header-h) + 2rem); margin-inline: 0; background: none; }
  }
  .rig { border-bottom: 1px solid var(--line-dark); }
  @media (min-width: 64rem) { .rig { border: 1px solid var(--line-dark); } }

  .rig-stage {
    position: relative;
    padding: 1.6rem 0.25rem 0.25rem;
    background-image: linear-gradient(var(--grid) 1px, transparent 1px), linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size: 24px 24px;
    background-position: -1px -1px;
  }
  @media (min-width: 64rem) { .rig-stage { padding: 3rem 1.5rem 1.25rem; background-size: 32px 32px; } }
  .rig-corner { position: absolute; top: 0.6rem; color: var(--color-steel-2); font-size: 0.625rem; }
  .rig-tl { left: var(--gutter); }
  .rig-tr { right: var(--gutter); }
  @media (max-width: 39.99rem) { .rig-tr { display: none; } }
  @media (min-width: 64rem) { .rig-corner { top: 1.1rem; font-size: 0.6875rem; } .rig-tl { left: 1.5rem; } .rig-tr { right: 1.5rem; } }

  .rig-draw { position: relative; }
  .car { display: block; width: 100%; height: auto; overflow: visible; }

  /* tratti */
  .car :is(path, line, rect, circle, ellipse, polyline) { vector-effect: non-scaling-stroke; transition: stroke 0.45s var(--ease-out-quart), fill 0.45s var(--ease-out-quart), opacity 0.45s var(--ease-out-quart); }
  .ground { stroke: color-mix(in oklab, var(--color-steel) 45%, transparent); stroke-width: 1; }
  .tick { stroke: color-mix(in oklab, var(--color-steel) 30%, transparent); stroke-width: 1; }
  .dim line { stroke: color-mix(in oklab, var(--color-steel) 28%, transparent); stroke-width: 1; }
  .body { fill: color-mix(in oklab, var(--color-night-2) 70%, var(--color-night)); stroke: var(--color-steel); stroke-width: 1.6; stroke-linejoin: round; }
  .glass { fill: color-mix(in oklab, var(--color-steel) 9%, transparent); stroke: color-mix(in oklab, var(--color-steel) 75%, transparent); stroke-width: 1.2; stroke-linejoin: round; }
  .part { fill: var(--color-night); stroke: color-mix(in oklab, var(--color-steel) 75%, transparent); stroke-width: 1.2; }
  .seam { stroke: color-mix(in oklab, var(--color-steel) 45%, transparent); stroke-width: 1; }
  .lamp { fill: color-mix(in oklab, var(--color-steel) 14%, transparent); stroke: color-mix(in oklab, var(--color-steel) 80%, transparent); stroke-width: 1.2; }
  .hidden-l, .hidden-l :is(path, rect, line) { stroke: color-mix(in oklab, var(--color-steel-2) 55%, transparent); stroke-width: 1; stroke-dasharray: 5 5; fill: none; }
  .tyre { fill: color-mix(in oklab, var(--color-night) 60%, black); stroke: var(--color-steel); stroke-width: 1.6; }
  .rim { stroke: color-mix(in oklab, var(--color-steel) 55%, transparent); stroke-width: 1; }
  .disc { stroke: color-mix(in oklab, var(--color-steel) 40%, transparent); stroke-width: 1; stroke-dasharray: 3 4; }
  .spoke { stroke: color-mix(in oklab, var(--color-steel) 55%, transparent); stroke-width: 1.2; }
  .hub { fill: var(--color-night); stroke: var(--color-steel); stroke-width: 1.2; }
  .caliper { stroke: color-mix(in oklab, var(--color-steel) 70%, transparent); stroke-width: 5; stroke-linecap: round; }
  .beam { fill: var(--color-orange); stroke: none; opacity: 0; }
  .puffs circle { fill: none; stroke: color-mix(in oklab, var(--color-steel) 40%, transparent); stroke-width: 1; stroke-dasharray: 3 3; opacity: 0; }

  /* zona attiva in arancio */
  .rig[data-active='1'] .z-id .part,
  .rig[data-active='2'] :is(.caliper, .disc),
  .rig[data-active='3'] .z-steering :is(.part, .hidden-l),
  .rig[data-active='4'] .z-vis :is(.glass, .part),
  .rig[data-active='5'] .z-lights .lamp,
  .rig[data-active='6'] :is(.tyre, polyline.z-wheels),
  .rig[data-active='7'] .z-body :is(.seam, .part, .hidden-l),
  .rig[data-active='8'] .z-equip :is(path, rect, line),
  .rig[data-active='9'] .z-emissions :is(.part, circle) { stroke: var(--color-orange); }
  .rig[data-active='2'] .disc { stroke-dasharray: none; }
  .rig[data-active='4'] .glass { fill: color-mix(in oklab, var(--color-orange) 14%, transparent); }
  .rig[data-active='5'] .lamp { fill: color-mix(in oklab, var(--color-orange) 55%, transparent); }
  .rig[data-active='5'] .beam { opacity: 0.16; }
  .rig[data-active='6'] polyline.z-wheels, .rig[data-active='7'] .z-body .hidden-l, .rig[data-active='8'] .z-equip :is(path, rect, line), .rig[data-active='3'] .z-steering .hidden-l { stroke-dasharray: none; stroke-width: 1.4; }
  .rig[data-active='9'] .puffs circle { opacity: 1; animation: puff 2.4s var(--ease-out-quart) infinite; }
  .rig[data-active='9'] .puffs circle:nth-child(2) { animation-delay: 0.3s; }
  .rig[data-active='9'] .puffs circle:nth-child(3) { animation-delay: 0.6s; }
  @keyframes puff { 0% { opacity: 0; transform: translate(-10px, 6px); } 30% { opacity: 1; } 100% { opacity: 0; transform: translate(14px, -10px); } }
  /* esito: tutta l'auto si "accende" */
  .rig[data-active='10'] :is(.body, .tyre) { stroke: var(--color-paper); }

  /* scansione */
  .scan { transform: translateX(var(--sx)); transition: transform 0.9s var(--ease-out-expo), opacity 0.4s; }
  .scan line { stroke: var(--color-orange); stroke-width: 1; stroke-dasharray: 2 4; }
  .scan path { fill: var(--color-orange); }
  .rig[data-active='10'] .scan { opacity: 0; }

  /* punti */
  .spots { position: absolute; inset: 0; pointer-events: none; }
  .spot-li { position: absolute; transform: translate(-50%, -50%); }
  .spot {
    pointer-events: auto;
    position: relative;
    display: grid;
    place-items: center;
    width: 1.375rem;
    height: 1.375rem;
    border-radius: 999px;
    border: 1px solid color-mix(in oklab, var(--color-steel) 60%, transparent);
    background: var(--color-night);
    color: var(--color-steel);
    font-size: 0.6875rem;
    font-weight: 640;
    font-stretch: 110%;
    cursor: pointer;
    transition: background-color 0.35s, color 0.35s, border-color 0.35s, transform 0.5s var(--ease-out-expo);
  }
  /* area di tocco più ampia del disegno */
  .spot::before { content: ''; position: absolute; inset: -0.6rem; }
  @media (min-width: 40rem) { .spot { width: 1.75rem; height: 1.75rem; font-size: 0.75rem; } }
  @media (min-width: 64rem) { .spot { width: 2rem; height: 2rem; font-size: 0.8125rem; } }
  .spot:hover { border-color: var(--color-paper); color: var(--color-paper); }
  .spot :global(.spot-ok) { display: none; }
  .spot.is-done { background: color-mix(in oklab, var(--color-orange) 18%, var(--color-night)); border-color: color-mix(in oklab, var(--color-orange) 70%, transparent); color: var(--color-orange); }
  .spot.is-done .spot-n { display: none; }
  .spot.is-done :global(.spot-ok) { display: block; }
  .spot.is-active { background: var(--color-orange); border-color: var(--color-orange); color: var(--color-ink); transform: scale(1.12); }
  .spot.is-active::after {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    border: 1px solid var(--color-orange);
    animation: ping 1.8s var(--ease-out-quart) infinite;
  }
  @keyframes ping { from { transform: scale(1); opacity: 0.9; } to { transform: scale(2.2); opacity: 0; } }

  /* display */
  .readout {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.35rem 1rem;
    align-items: center;
    padding: 0.7rem var(--gutter) 0.85rem;
    border-top: 1px solid var(--line-dark);
  }
  @media (min-width: 64rem) { .readout { padding: 1.25rem 1.5rem 1.4rem; gap: 0.75rem 1.5rem; } }
  .ro-count { display: grid; gap: 0.15rem; }
  .ro-k { color: var(--color-steel-2); font-size: 0.625rem; }
  .ro-num { font-stretch: 125%; font-weight: 640; font-size: 1.625rem; line-height: 1; letter-spacing: -0.03em; color: var(--color-orange); }
  .ro-of { color: var(--color-steel-2); font-size: 0.55em; letter-spacing: 0; margin-left: 0.1em; }
  @media (min-width: 64rem) { .ro-num { font-size: 2.6rem; } .ro-k { font-size: 0.6875rem; } }
  .ro-main { display: grid; gap: 0.2rem; min-width: 0; padding-left: 1rem; border-left: 1px solid var(--line-dark); }
  .ro-title { font-family: var(--font-wide); font-stretch: 118%; font-weight: 620; font-size: 1rem; line-height: 1.15; letter-spacing: -0.01em; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  @media (min-width: 64rem) { .ro-title { font-size: 1.375rem; } }
  .ro-tool { font-size: 0.8125rem; color: var(--color-steel); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  /* Su telefono lo spazio è poco: solo il nome dello strumento, senza etichetta */
  @media (max-width: 39.99rem) { .ro-tool .ro-k { display: none; } }
  @media (max-width: 25rem) { .ro-tool { font-size: 0.75rem; } }
  @media (min-width: 64rem) { .ro-tool { font-size: 0.9375rem; } }
  .ro-bar { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(10, minmax(0, 1fr)); gap: 3px; }
  .ro-seg { height: 3px; background: color-mix(in oklab, var(--color-steel) 18%, transparent); transition: background-color 0.4s; }
  .ro-seg.is-done { background: color-mix(in oklab, var(--color-orange) 55%, transparent); }
  .ro-seg.is-active { background: var(--color-orange); }
  [data-ro-num], [data-ro-title], [data-ro-tool] { display: inline-block; }
  .readout.is-swap :is([data-ro-num], [data-ro-title], [data-ro-tool]) { animation: ro-in 0.5s var(--ease-out-expo); }
  @keyframes ro-in { from { opacity: 0; transform: translateY(6px); } }

  /* ---------- Passaggi ---------- */
  .steps-list { display: grid; }
  .rv-step {
    padding-block: 2rem;
    border-bottom: 1px solid var(--line-dark);
    scroll-margin-top: calc(var(--header-h) + var(--rig-h, 0px) + 1rem);
    transition: opacity 0.5s var(--ease-out-quart);
  }
  .rv-step:last-child { border-bottom: 0; padding-bottom: 0; }
  @media (min-width: 64rem) {
    .rv-step { padding-block: 3.25rem; min-height: 26rem; scroll-margin-top: calc(var(--header-h) + 2rem); }
    .rv-step:first-child { padding-top: 0.5rem; }
    /* passaggi non attivi più tenui: l'occhio resta sul controllo in corso */
    html.js .tour.is-live .rv-step:not(.is-active) { opacity: 0.38; }
  }
  .rv-head { display: grid; grid-template-columns: 3.25rem minmax(0, 1fr); gap: 1rem; align-items: start; }
  @media (min-width: 64rem) { .rv-head { grid-template-columns: 4.25rem minmax(0, 1fr); } }
  .rv-num {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border: 1px solid var(--line-dark);
    border-radius: 999px;
    font-stretch: 120%;
    font-weight: 620;
    font-size: 1rem;
    color: var(--color-steel);
    transition: background-color 0.4s, color 0.4s, border-color 0.4s;
  }
  @media (min-width: 64rem) { .rv-num { width: 4.25rem; height: 4.25rem; font-size: 1.25rem; } }
