</style>

<script>
  // Due modalità sullo stesso banco:
  // - full: il passaggio attivo è quello che attraversa il 55% dell'altezza della finestra (scroll passivo + rAF)
  // - compact: selezione da indice, punti e frecce; scorrimento automatico solo quando la sezione è in vista
  document.querySelectorAll<HTMLElement>('[data-tour]').forEach((tour) => {
    const compact = tour.dataset.tour === 'compact';
    const rig = tour.querySelector<HTMLElement>('[data-rig]');
    const rigCol = rig?.parentElement;
    const spots = Array.from(tour.querySelectorAll<HTMLElement>('[data-spot]'));
    const segs = Array.from(tour.querySelectorAll<HTMLElement>('[data-seg]'));
    // Sorgente dei dati di ogni passaggio (titolo, strumento, posizione della scansione)
    const items = Array.from(tour.querySelectorAll<HTMLElement>(compact ? '[data-pick]' : '[data-rv-step]'));
    const panels = Array.from(tour.querySelectorAll<HTMLElement>('[data-panel]'));
    const roNum = tour.querySelector<HTMLElement>('[data-ro-num]');
    const roTitle = tour.querySelector<HTMLElement>('[data-ro-title]');
    const roTool = tour.querySelector<HTMLElement>('[data-ro-tool]');
    const readout = tour.querySelector<HTMLElement>('.readout');
    if (!rig || !items.length) return;
    const count = items.length;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let current = 1;

    const set = (n: number, force = false) => {
      if (n === current && !force) return;
      current = n;
      const item = items[n - 1];
      rig.dataset.active = String(n);
      rig.style.setProperty('--sx', `${item.dataset.x}px`);
      const mark = (list: HTMLElement[]) =>
        list.forEach((el, i) => {
          el.classList.toggle('is-active', i === n - 1);
          el.classList.toggle('is-done', i < n - 1);
        });
      mark(spots);
      mark(segs);
      mark(items);
      if (compact) {
        items.forEach((el, i) => (i === n - 1 ? el.setAttribute('aria-current', 'step') : el.removeAttribute('aria-current')));
        panels.forEach((p, i) => p.classList.toggle('is-active', i === n - 1));
      }
      // All'esito: 09/09, tutte le aree controllate
      if (roNum) roNum.textContent = String(Math.min(n, spots.length)).padStart(2, '0');
      if (roTitle) roTitle.textContent = item.dataset.title ?? '';
      if (roTool) roTool.textContent = item.dataset.tool ?? '';
      if (readout) {
        readout.classList.remove('is-swap');
        void readout.offsetWidth;
        readout.classList.add('is-swap');
      }
    };

    tour.classList.add('is-live');

    if (!compact) {
      const mobile = window.matchMedia('(max-width: 63.99rem)');
      // Altezza del banco fisso su mobile: i passaggi raggiunti dai punti non finiscono sotto il disegno
      const syncRig = () => tour.style.setProperty('--rig-h', mobile.matches && rigCol ? `${rigCol.offsetHeight}px` : '0px');
      let ticking = false;
      const update = () => {
        ticking = false;
        const line = window.innerHeight * 0.55;
        let n = 1;
        items.forEach((s, i) => { if (s.getBoundingClientRect().top <= line) n = i + 1; });
        set(n);
      };
      const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
      syncRig();
      update();
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', () => { syncRig(); onScroll(); }, { passive: true });
      if ('ResizeObserver' in window && rigCol) new ResizeObserver(syncRig).observe(rigCol);
      // Punto sul disegno → porta il passaggio sulla linea di lettura
      spots.forEach((spot) => {
        spot.addEventListener('click', () => {
          const target = items[Number(spot.dataset.spot) - 1];
          if (!target) return;
          const top = target.getBoundingClientRect().top + window.scrollY - window.innerHeight * 0.55 + 24;
          window.scrollTo({ top, behavior: reduce ? 'auto' : 'smooth' });
          const h = target.querySelector<HTMLElement>('h3');
          h?.setAttribute('tabindex', '-1');
          h?.focus({ preventScroll: true });
        });
      });
      return;
    }

    // ---- compatta: selezione da indice, punti sul disegno e frecce ----
    const pick = (n: number) => set(((n - 1 + count) % count) + 1);
    items.forEach((a) => a.addEventListener('click', (e) => { e.preventDefault(); pick(Number(a.dataset.pick)); }));
    spots.forEach((b) => b.addEventListener('click', () => pick(Number(b.dataset.spot))));
    tour.querySelector('[data-prev]')?.addEventListener('click', () => pick(current - 1));
    tour.querySelector('[data-next]')?.addEventListener('click', () => pick(current + 1));
    set(1, true);
  });
</script>
