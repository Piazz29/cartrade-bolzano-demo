# Copia questo file in .env (in locale) e imposta le stesse variabili su Vercel
# (Project › Settings › Environment Variables). Tutte facoltative: se mancano, la demo
# funziona lo stesso in MODALITÀ SIMULATA (dati nel browser, nessun invio reale).
# Guida passo passo nel README, sezione "Lista clienti: messa in funzione".

# ---------------------------------------------------------------------------
# Google Maps Platform (FACOLTATIVA): chiave BROWSER solo per la mappa ufficiale (Maps Embed API).
# Voto e numero delle recensioni sono statici in src/data/site.ts e non usano questa chiave.
# 1. console.cloud.google.com → nuovo progetto → abilita "Maps Embed API"
# 2. Credenziali → Crea chiave API → Restrizioni applicazione: "Siti web" → aggiungi https://cartradebolzano.it/* (e http://localhost:4321/* per lo sviluppo)
# 3. Restrizioni API: solo la Maps Embed API.
# Senza chiave il sito funziona lo stesso con la mappa Google pubblica.
PUBLIC_GOOGLE_MAPS_API_KEY=

# ---------------------------------------------------------------------------
# Supabase (database dei clienti veri). Supabase › Project Settings › API.
# La service role key salta la RLS: SOLO lato server, mai in variabili PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Resend (email). resend.com › API Keys, con permesso "Sending access".
# Il dominio del mittente (auralpdigital.com) va verificato su Resend: vedi README.
RESEND_API_KEY=
# Mittente. Se vuoto: Car Trade Bolzano · demo <demo@auralpdigital.com>
EMAIL_FROM="Car Trade Bolzano · demo <demo@auralpdigital.com>"
# Dove arrivano le richieste dei moduli contatti e preventivo (l'email demo del titolare).
# Anche "Rispondi" alle email ai clienti va a questo indirizzo.
DEMO_OWNER_EMAIL=

# ---------------------------------------------------------------------------
# Chiave del QR della locandina. Solo le iscrizioni arrivate con ?demo=<questa chiave>
# ricevono l'email di benvenuto (l'endpoint pubblico non manda email a chiunque).
# Una stringa lunga e casuale, es.: openssl rand -hex 12
DEMO_KEY=

# Password dell'admin (/admin/). In sviluppo locale, se vuota, vale "demo".
ADMIN_DEMO_PASSWORD=

# ---------------------------------------------------------------------------
# WhatsApp Cloud API (facoltativa). Se manca anche solo una delle tre, "Invia su WhatsApp"
# apre wa.me con il messaggio già scritto sul dispositivo di chi lo usa.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Nome del modello approvato su Meta, con due variabili: {{1}} nome, {{2}} testo. Stesso nome in it e de.
WHATSAPP_TEMPLATE=
